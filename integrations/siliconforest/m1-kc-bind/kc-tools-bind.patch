+/*
+ * SiliconForest: which definition an import of a kext binds to.
+ *
+ * The table is one list of the kernel's exported names and the exported names of every kext
+ * linked so far, sorted by name; a name can be in it more than once (IO80211Family's compat
+ * copies of hz, m_gethdr, m_freem, microuptime, ... are kernel names too). symtab_lookup()
+ * returns whichever copy its bisection lands on, so one name added anywhere could move a kext's
+ * binding. bind_lookup() resolves an import the way the kext linker does, with the kernel as the
+ * base every kext links against:
+ *   1. a pin for this kext and name (KC_BIND_PINS, lines "<kext> <symbol> <kernel|kext>"):
+ *      that provider's definition; a pin whose provider has no such definition, or that no
+ *      import uses, fails the build;
+ *   2. one definition only: that one (as before; one in a kext the importer does not declare
+ *      is printed as a note);
+ *   3. the kexts the importer's OSBundleLibraries names: the one that defines it; two of them
+ *      with different addresses fail the build;
+ *   4. the kernel;
+ *   5. any other linked kext, if exactly one address remains; else the build fails.
+ * Every import that had more than one definition to choose from is printed with its choice.
+ */
+typedef struct { char *kext, *symbol, *provider; int used; } BindPin;
+static BindPin *bind_pins;
+static size_t bind_npins;
+static int bind_pins_loaded;
+static const char *bind_kext = "";
+static char **bind_deps;
+static size_t bind_ndeps;
+
+static void bind_fail(const char *what, const char *name) {
+  fprintf(stderr, "kc-bind: FATAL %s: %s imports %s\n", what, bind_kext, name);
+  exit(2);
+}
+
+static void bind_load_pins(void) {
+  if (bind_pins_loaded)
+    return;
+  bind_pins_loaded = 1;
+  const char *path = getenv("KC_BIND_PINS");
+  if (!path || !*path)
+    return;
+  FILE *f = fopen(path, "r");
+  if (!f) {
+    fprintf(stderr, "kc-bind: FATAL cannot read KC_BIND_PINS %s\n", path);
+    exit(2);
+  }
+  char line[1024];
+  while (fgets(line, sizeof(line), f)) {
+    char *hash = strchr(line, '#');
+    if (hash)
+      *hash = '\0';
+    char kext[256], symbol[512], provider[256], extra[2];
+    int n = sscanf(line, "%255s %511s %255s %1s", kext, symbol, provider, extra);
+    if (n <= 0)
+      continue;
+    if (n != 3) {
+      fprintf(stderr, "kc-bind: FATAL bad line in %s: %s\n", path, line);
+      exit(2);
+    }
+    bind_pins = realloc(bind_pins, (bind_npins + 1) * sizeof(*bind_pins));
+    bind_pins[bind_npins].kext = strdup(kext);
+    bind_pins[bind_npins].symbol = strdup(symbol);
+    bind_pins[bind_npins].provider = strdup(provider);
+    bind_pins[bind_npins].used = 0;
+    bind_npins++;
+  }
+  fclose(f);
+  fprintf(stderr, "kc-bind: %zu pin(s) from %s\n", bind_npins, path);
+}
+
+int kc_bind_unused_pins(void) {
+  bind_load_pins();
+  int unused = 0;
+  for (size_t i = 0; i < bind_npins; i++) {
+    if (!bind_pins[i].used) {
+      fprintf(stderr, "kc-bind: FATAL pin not used: %s %s %s\n", bind_pins[i].kext,
+              bind_pins[i].symbol, bind_pins[i].provider);
+      unused++;
+    }
+  }
+  return unused;
+}
+
+// the kext about to be linked: its identifier and the bundles its OSBundleLibraries names
+static void bind_begin(const LinkedKext *lk) {
+  for (size_t i = 0; i < bind_ndeps; i++)
+    free(bind_deps[i]);
+  free(bind_deps);
+  bind_deps = NULL;
+  bind_ndeps = 0;
+  bind_kext = lk ? lk->bundle_id : "";
+  bind_load_pins();
+  if (!lk || !lk->info_plist_xml)
+    return;
+  PlistNode *root = plist_parse(lk->info_plist_xml, lk->info_plist_len);
+  PlistNode *libs = root ? plist_dict_get(root, "OSBundleLibraries") : NULL;
+  if (libs && libs->type == PLIST_DICT) {
+    for (PlistNode *e = libs->child; e; e = e->next) {
+      if (!e->key)
+        continue;
+      bind_deps = realloc(bind_deps, (bind_ndeps + 1) * sizeof(*bind_deps));
+      bind_deps[bind_ndeps++] = strdup(e->key);
+    }
+  }
+  plist_free(root);
+}
+
+static int bind_declared(const char *owner) {
+  for (size_t i = 0; i < bind_ndeps; i++)
+    if (!strcmp(bind_deps[i], owner))
+      return 1;
+  return 0;
+}
+
+static uint64_t bind_lookup(const SymTable *st, const char *name) {
+  size_t lo = 0, hi = st->count;
+  while (lo < hi) {
+    size_t mid = (lo + hi) / 2;
+    if (strcmp(st->syms[mid].name, name) < 0)
+      lo = mid + 1;
+    else
+      hi = mid;
+  }
+  size_t end = lo;
+  while (end < st->count && !strcmp(st->syms[end].name, name))
+    end++;
+  if (end == lo)
+    return 0;
+
+  for (size_t p = 0; p < bind_npins; p++) {
+    BindPin *pin = &bind_pins[p];
+    if (strcmp(pin->kext, bind_kext) || strcmp(pin->symbol, name))
+      continue;
+    for (size_t i = lo; i < end; i++) {
+      const char *owner = st->syms[i].owner ? st->syms[i].owner : "kernel";
+      if (!strcmp(owner, pin->provider)) {
+        pin->used = 1;
+        fprintf(stderr, "kc-bind: %s %s -> %s (pinned, %zu definitions)\n", bind_kext, name,
+                owner, end - lo);
+        return st->syms[i].addr;
+      }
+    }
+    bind_fail("pinned provider has no such definition", name);
+  }
+
+  if (end - lo == 1) {
+    const char *owner = st->syms[lo].owner;
+    if (owner && !bind_declared(owner))
+      fprintf(stderr, "kc-bind: note: %s imports %s from %s, which it does not declare\n",
+              bind_kext, name, owner);
+    return st->syms[lo].addr;
+  }
+
+  uint64_t dep = 0, kern = 0, other = 0;
+  const char *dep_owner = NULL, *other_owner = NULL;
+  int ndep = 0, nkern = 0, nother = 0;
+  for (size_t i = lo; i < end; i++) {
+    const Sym *s = &st->syms[i];
+    if (!s->owner) {
+      if (nkern && kern != s->addr)
+        bind_fail("two kernel definitions", name);
+      kern = s->addr;
+      nkern++;
+    } else if (bind_declared(s->owner)) {
+      if (ndep && dep != s->addr)
+        bind_fail("ambiguous between declared dependencies", name);
+      dep = s->addr;
+      dep_owner = s->owner;
+      ndep++;
+    } else {
+      if (nother && other != s->addr)
+        nother = -1000;
+      other = s->addr;
+      other_owner = s->owner;
+      nother++;
+    }
+  }
+  const char *chosen;
+  uint64_t v;
+  if (ndep) {
+    chosen = dep_owner;
+    v = dep;
+  } else if (nkern) {
+    chosen = "kernel";
+    v = kern;
+  } else if (nother > 0) {
+    chosen = other_owner;
+    v = other;
+  } else {
+    bind_fail("ambiguous between kexts it does not declare", name);
+    return 0;
+  }
+  fprintf(stderr, "kc-bind: %s %s -> %s (%zu definitions:", bind_kext, name, chosen, end - lo);
+  for (size_t i = lo; i < end; i++)
+    fprintf(stderr, " %s", st->syms[i].owner ? st->syms[i].owner : "kernel");
+  fprintf(stderr, ")\n");
+  return v;
+}
