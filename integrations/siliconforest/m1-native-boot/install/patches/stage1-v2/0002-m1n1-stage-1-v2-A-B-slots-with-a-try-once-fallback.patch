diff --git a/src/chainload.c b/src/chainload.c
index 5b498516..9eb2c2a2 100644
--- a/src/chainload.c
+++ b/src/chainload.c
@@ -298,6 +298,84 @@ int chainload_load(const char *spec, char **vars, size_t *var_cnt, size_t var_ca
     return ret;
 }
 
+#ifdef SF_AB_BOOT
+#include "sf_ab.h"
+
+/* A small file of the boot partition (the boot state record). The controller stays up. */
+int chainload_read_file(const char *spec, void **image, size_t *size)
+{
+    if (!nvme_init()) {
+        printf("chainload: NVME init failed\n");
+        return -1;
+    }
+    return rust_load_image(spec, image, size);
+}
+
+void chainload_free_file(void *image, size_t size)
+{
+    rust_free_image(image, size);
+}
+
+/*
+ * chainload_load for one slot of stage 1 v2: with check, the image must have exactly the size and
+ * CRC-32 the boot state record names. 0: next_stage is set and the controller is stopped, as
+ * chainload_load leaves it. -2: this image cannot be used; the controller is still up, so the
+ * caller may try another slot. -1: the controller could not be stopped; try nothing else.
+ */
+int chainload_load_slot(const char *spec, char **vars, size_t *var_cnt, size_t var_capacity,
+                        bool check, u32 bytes, u32 crc32)
+{
+    static char adopt_var[] = "nvme.adopt=live-rtkit-v1";
+    void *image = NULL;
+    size_t size = 0;
+    int ret;
+
+    next_stage.entry = NULL;
+    if (!nvme_init()) {
+        printf("chainload: NVME init failed\n");
+        return -1;
+    }
+
+    if (nvme_has_live_post_m4_session()) {
+        bool present = false;
+        for (size_t i = 0; i < *var_cnt; i++) {
+            if (!strcmp(vars[i], adopt_var))
+                present = true;
+        }
+        if (!present) {
+            if (*var_cnt >= var_capacity) {
+                printf("chainload: no room for ANS adoption variable\n");
+                return -2;
+            }
+            vars[(*var_cnt)++] = adopt_var;
+        }
+    }
+
+    if (rust_load_image(spec, &image, &size))
+        return -2;
+    if (check) {
+        u32 crc = sf_ab_crc32(image, size);
+        if (size != bytes || crc != crc32) {
+            printf("chainload: %lu bytes, CRC-32 %08x; the boot state says %u bytes, %08x\n",
+                   (unsigned long)size, crc, bytes, crc32);
+            rust_free_image(image, size);
+            return -2;
+        }
+    }
+    ret = chainload_image(image, size, vars, *var_cnt);
+    rust_free_image(image, size);
+    if (ret) {
+        next_stage.entry = NULL;
+        return -2;
+    }
+    if (!nvme_shutdown()) {
+        next_stage.entry = NULL;
+        return -1;
+    }
+    return 0;
+}
+#endif
+
 #else
 
 int chainload_load(const char *spec, char **vars, size_t *var_cnt, size_t var_capacity)
