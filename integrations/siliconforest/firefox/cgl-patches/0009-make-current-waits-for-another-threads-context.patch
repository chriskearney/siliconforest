+/* (VLC) On macOS a context stays current on every thread that made it current, and CGLLockContext orders their use.
+ * EGL binds a context to one thread at a time. So, as a context's lock passes between threads, its binding passes with
+ * it: a thread letting go of the lock completely lets go of the binding as well (its CGLGetCurrentContext still answers
+ * the context), and takes the binding back when it locks the context again or makes it current. VLC's NSOpenGLView
+ * output keeps its context current on the main thread and draws from its video thread too; the video thread's
+ * make-current failed with 10004 for ever. Only with SF_CGL_LEND=1 (off by default) and SF_CGL_HANDOFF_MS other
+ * than 0. */
+#ifdef SF_CGL_USE_EGL
+static void
+sf_cgl_take_back(CGLContextObj ctx)
+{
+	if (sf_cgl_current != ctx || !ctx->lent || sf_cgl_handoff_ms() == 0)
+		return;
+	EGLDisplay dpy = sf_cgl_get_display();
+	double waited = sf_cgl_wait_for_handoff(ctx);
+
+	eglBindAPI(EGL_OPENGL_API);
+	if (waited < 0 || !eglMakeCurrent(dpy, ctx->pbuffer, ctx->pbuffer, ctx->glx)) {
+		if (getenv("SF_CGL_TRACE") != NULL)
+			fprintf(stderr, "CGL: taking back %p failed: EGL error %x, waited %.1f ms\n", (void *)ctx, eglGetError(), waited);
+		if (waited >= 0) {
+			pthread_mutex_lock(&sf_cgl_bind_lock);
+			ctx->bound = 0;
+			pthread_cond_broadcast(&sf_cgl_bind_changed);
+			pthread_mutex_unlock(&sf_cgl_bind_lock);
+		}
+		return;
+	}
+	pthread_mutex_lock(&sf_cgl_bind_lock);
+	ctx->lent = 0;
+	ctx->current_thread = pthread_self();
+	ctx->bound = 1;
+	pthread_mutex_unlock(&sf_cgl_bind_lock);
+	sf_cgl_apply_pending_size(ctx);
+}
+
+static int
+sf_cgl_lending(void)
+{
+	static int on = -1;
+
+	if (on < 0) {
+		const char *v = getenv("SF_CGL_LEND");
+		on = v != NULL && v[0] == '1';
+	}
+	return on;
+}
+
+static void
+sf_cgl_lend(CGLContextObj ctx)
+{
+	if (!sf_cgl_lending() || sf_cgl_current != ctx || ctx->lent || !ctx->bound || sf_cgl_handoff_ms() == 0)
+		return;
+	eglMakeCurrent(sf_cgl_get_display(), EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+	pthread_mutex_lock(&sf_cgl_bind_lock);
+	ctx->lent = 1;
+	ctx->bound = 0;
+	pthread_cond_broadcast(&sf_cgl_bind_changed);
+	pthread_mutex_unlock(&sf_cgl_bind_lock);
+}
