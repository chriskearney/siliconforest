+// SPDX-License-Identifier: MIT
+/*
+ * SiliconForest: what the threads of a task are waiting for, the Mach half of kern.sf_exitwait
+ * (bsd/kern/sf_exitwait_bsd.c chooses the tasks, formats the report and owns the switches).
+ *
+ * For one task: each of its threads' state, wait event, block hint, the owner of the kernel
+ * mutex or rw lock it waits for, its wait message and name, how long it has been off the
+ * processor, and its kernel frame chain (return addresses, unslid). It exists because a process
+ * stuck in exit cannot be sampled (task_for_pid fails) and the M1 has no stackshot reader.
+ *
+ * Nothing here can block on what it looks at: the global thread lists are taken with a
+ * try-lock (EBUSY after about 100 ms), every thread is held by a reference while it is looked
+ * at, and every word of another thread's kernel stack (and of a lock or a thread name) is read
+ * with ml_nofault_copy(), bounded by that thread's kernel stack. A thread that runs while it is
+ * looked at gives a stale answer, flagged SF_EW_MOVED, never a fault. Nothing is written.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/kern_types.h>
+#include <kern/block_hint.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/lock_mtx.h>
+#include <kern/lock_rw.h>
+#include <kern/misc_protos.h>
+#include <kern/processor.h>
+#include <kern/queue.h>
+#include <kern/sched_prim.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/waitq.h>
+#include <machine/machine_routines.h>
+#include <sys/errno.h>
+#if __has_feature(ptrauth_calls)
+#include <ptrauth.h>
+#endif
+
+/* the record bsd/kern/sf_exitwait_bsd.c reads; both files define it, the sizes are checked */
+#define SF_EW_FRAMES            24
+#define SF_EW_EXIT_THREAD       0x01    /* the proc's exit_thread */
+#define SF_EW_TERMINATED        0x02    /* on terminated_threads: done, not yet freed */
+#define SF_EW_RUNNABLE          0x04    /* TH_RUN: on a processor or a run queue, no frames */
+#define SF_EW_STACKLESS         0x08    /* blocked with a continuation, no kernel stack */
+#define SF_EW_TRUNCATED         0x10    /* the frame chain left the stack or was unreadable */
+#define SF_EW_MOVED             0x20    /* state or wait event changed while looked at */
+
+struct sf_ew_thread {
+	uint64_t        tid;
+	uint64_t        wait_event;     /* unslid when in the kernel image, else permuted */
+	uint64_t        waitq;          /* permuted */
+	uint64_t        continuation;   /* unslid */
+	uint64_t        blocked_us;     /* since it last left a processor, when not runnable */
+	uint64_t        owner_tid;      /* holder of the kernel mutex / rw lock it waits for */
+	uint64_t        frames[SF_EW_FRAMES]; /* unslid return addresses, innermost first */
+	char            wmesg[24];      /* msleep/tsleep message */
+	char            name[32];       /* thread name, when it has one */
+	int32_t         state;
+	int32_t         block_hint;
+	int32_t         sched_pri;
+	int32_t         wait_result;
+	uint32_t        nframes;
+	uint32_t        flags;
+};
+
+struct sf_ew_task {
+	int32_t         active;
+	int32_t         halting;
+	int32_t         ipc_active;
+	int32_t         thread_count;
+	uint32_t        active_thread_count;
+	int32_t         suspend_count;
+	int32_t         listed;         /* threads of the task on the global lists */
+	int32_t         terminated;     /* of those, on terminated_threads */
+};
+
+_Static_assert(sizeof(struct sf_ew_thread) == 320 && sizeof(struct sf_ew_task) == 32,
+    "the record bsd/kern/sf_exitwait_bsd.c shares");
+/* the BSD half decodes thread->state with its own copy of these */
+_Static_assert(TH_WAIT == 0x01 && TH_SUSP == 0x02 && TH_RUN == 0x04 && TH_UNINT == 0x08 &&
+    TH_TERMINATE == 0x10, "thread state bits bsd/kern/sf_exitwait_bsd.c decodes");
+
+/*
+ * The kernel's own calls between the two halves are private externs: the kernel collection's
+ * linker resolves kext imports against the kernel's exported names (kc-tools, one sorted table
+ * with duplicate names), so an exported name added here could change what a kext binds to.
+ */
+/* bsd/kern/sf_exitwait_bsd.c: the uthread's wait message (a literal) and name buffer */
+__private_extern__ const char *sf_exitwait_wmesg(thread_t thread);
+__private_extern__ const char *sf_exitwait_name(thread_t thread);
+
+__private_extern__ int sf_exitwait_task_threads(task_t task, void *exit_thread, struct sf_ew_task *ti, size_t ti_size,
+    struct sf_ew_thread *out, size_t rec_size, int max, int *count);
+
+static inline uint64_t
+sf_ew_strip(uint64_t v)
+{
+#if __has_feature(ptrauth_calls)
+	return (uint64_t)ptrauth_strip((void *)v, ptrauth_key_return_address);
+#else
+	return v;
+#endif
+}
+
+static bool
+sf_ew_read(vm_offset_t from, void *to, vm_size_t size)
+{
+	return ml_nofault_copy(from, (vm_offset_t)to, size) == size;
+}
+
+/* the thread holding the kernel mutex or rw lock behind a wait event, 0 when unknown */
+static uint64_t
+sf_ew_owner(int hint, event64_t event)
+{
+	thread_t owner = THREAD_NULL;
+	uint32_t word = 0;
+
+	switch (hint) {
+#if !LCK_MTX_USE_ARCH
+	case kThreadWaitKernelMutex:
+		/* the event is the address of the mutex's state word (lock_mtx.c, LCK_MTX_EVENT) */
+		if (sf_ew_read((vm_offset_t)event, &word, sizeof(word))) {
+			owner = ctid_get_thread_unsafe(word & LCK_MTX_CTID_MASK);
+		}
+		break;
+#endif
+	case kThreadWaitKernelRWLockRead:
+	case kThreadWaitKernelRWLockWrite:
+	case kThreadWaitKernelRWLockUpgrade: {
+		/* lock_rw.c lck_rw_from_event64(); the writer's ctid is lck_rw_owner */
+		vm_offset_t lck = (vm_offset_t)(waitq_untyped_event(event) & ~7ull);
+
+		if (sf_ew_read(lck + offsetof(lck_rw_t, lck_rw_owner), &word, sizeof(word))) {
+			owner = ctid_get_thread_unsafe(word);
+		}
+		break;
+	}
+	default:
+		break;
+	}
+	return owner != THREAD_NULL ? thread_tid(owner) : 0;
+}
+
+/* return addresses from a saved frame pointer up a kernel stack [lo, hi) */
+static uint32_t
+sf_ew_frames(vm_offset_t lo, vm_offset_t hi, uint64_t fp, uint64_t lr, uint64_t *out,
+    uint32_t max, uint32_t *flags)
+{
+	uint64_t frame[2];
+	uint32_t n = 0;
+
+	lr = sf_ew_strip(lr);
+	if (lr != 0) {
+		out[n++] = VM_KERNEL_UNSLIDE(lr);
+	}
+	while (n < max && fp != 0) {
+		if ((fp & 7) != 0 || fp < lo || fp + sizeof(frame) > hi ||
+		    !sf_ew_read((vm_offset_t)fp, frame, sizeof(frame))) {
+			*flags |= SF_EW_TRUNCATED;
+			break;
+		}
+		lr = sf_ew_strip(frame[1]);
+		if (lr == 0) {
+			break;
+		}
+		out[n++] = VM_KERNEL_UNSLIDE(lr);
+		frame[0] = sf_ew_strip(frame[0]);
+		/* the chain goes up the stack, or it is not a chain */
+		if (frame[0] != 0 && frame[0] <= fp) {
+			*flags |= SF_EW_TRUNCATED;
+			break;
+		}
+		fp = frame[0];
+	}
+	return n;
+}
+
+static void
+sf_ew_snapshot(thread_t thread, struct sf_ew_thread *r, void *exit_thread, uint64_t now)
+{
+	const char *wmesg, *name;
+	vm_offset_t kstack;
+	void *kstate;
+	event64_t event;
+	uint64_t last;
+	int state;
+	spl_t s;
+
+	bzero(r, sizeof(*r));
+	r->tid = thread_tid(thread);
+	if ((void *)thread == exit_thread) {
+		r->flags |= SF_EW_EXIT_THREAD;
+	}
+
+	s = splsched();
+	thread_lock(thread);
+	state = thread->state;
+	event = thread->wait_event;
+	r->waitq = VM_KERNEL_ADDRPERM(thread->waitq.wq_q);
+	r->block_hint = thread->block_hint;
+	r->sched_pri = thread->sched_pri;
+	r->wait_result = thread->wait_result;
+	r->continuation = thread->continuation != NULL ? VM_KERNEL_UNSLIDE(thread->continuation) : 0;
+	last = thread->last_run_time;
+	kstack = thread->kernel_stack;
+	kstate = thread->machine.kstackptr;
+	thread_unlock(thread);
+	splx(s);
+
+	r->state = state;
+	r->wait_event = event != NO_EVENT64 ?
+	    VM_KERNEL_UNSLIDE_OR_PERM(waitq_untyped_event(event)) : 0;
+	if (state & TH_WAIT) {
+		r->owner_tid = sf_ew_owner(r->block_hint, event);
+	}
+	if ((state & TH_RUN) == 0 && last != 0 && now > last) {
+		absolutetime_to_nanoseconds(now - last, &r->blocked_us);
+		r->blocked_us /= NSEC_PER_USEC;
+	}
+	wmesg = sf_exitwait_wmesg(thread);
+	if (wmesg != NULL) {
+		/* a literal; read without faulting all the same, and always terminated */
+		(void)ml_nofault_copy((vm_offset_t)wmesg, (vm_offset_t)r->wmesg, sizeof(r->wmesg) - 1);
+		r->wmesg[sizeof(r->wmesg) - 1] = '\0';
+	}
+	name = sf_exitwait_name(thread);
+	if (name != NULL) {
+		/* the buffer can be freed while it is read (kern_fork.c): never fault on it */
+		(void)ml_nofault_copy((vm_offset_t)name, (vm_offset_t)r->name, sizeof(r->name) - 1);
+		r->name[sizeof(r->name) - 1] = '\0';
+	}
+
+	if (state & TH_RUN) {
+		r->flags |= SF_EW_RUNNABLE;
+		return;
+	}
+	if (kstack == 0 || kstate == NULL) {
+		r->flags |= SF_EW_STACKLESS;
+		return;
+	}
+#if defined(__arm64__)
+	{
+		struct arm_kernel_saved_state ss;
+
+		if (!sf_ew_read((vm_offset_t)&((thread_kernel_state_t)kstate)->machine.ss, &ss, sizeof(ss))) {
+			r->flags |= SF_EW_TRUNCATED;
+			return;
+		}
+		r->nframes = sf_ew_frames(kstack, kstack + kernel_stack_size, ss.fp, ss.lr,
+		    r->frames, SF_EW_FRAMES, &r->flags);
+	}
+#else
+	r->flags |= SF_EW_TRUNCATED;
+#endif
+
+	s = splsched();
+	thread_lock(thread);
+	if (thread->state != state || thread->wait_event != event) {
+		r->flags |= SF_EW_MOVED;
+	}
+	thread_unlock(thread);
+	splx(s);
+}
+
+/*
+ * Up to max records for the threads of task, the exit thread marked. 0 and *count, or EINVAL
+ * (a record size the caller does not share), ENOMEM, EBUSY (the thread lists stayed locked).
+ */
+__private_extern__ int
+sf_exitwait_task_threads(task_t task, void *exit_thread, struct sf_ew_task *ti, size_t ti_size,
+    struct sf_ew_thread *out, size_t rec_size, int max, int *count)
+{
+	queue_head_t *lists[2] = { &threads, &terminated_threads };
+	thread_t *held;
+	uint8_t *terminated;
+	thread_t thread;
+	bool locked = false;
+	uint64_t now;
+	int n = 0;
+
+	*count = 0;
+	if (task == TASK_NULL || ti_size != sizeof(*ti) || rec_size != sizeof(*out) || max <= 0) {
+		return EINVAL;
+	}
+	held = kalloc_type(thread_t, max, Z_WAITOK | Z_ZERO);
+	terminated = kalloc_data(max, Z_WAITOK | Z_ZERO);
+	if (held == NULL || terminated == NULL) {
+		kfree_type(thread_t, max, held);
+		kfree_data(terminated, max);
+		return ENOMEM;
+	}
+	for (int tries = 0; tries < 100; tries++) {
+		if ((locked = lck_mtx_try_lock(&tasks_threads_lock))) {
+			break;
+		}
+		delay(1000);
+	}
+	if (!locked) {
+		kfree_type(thread_t, max, held);
+		kfree_data(terminated, max);
+		return EBUSY;
+	}
+	bzero(ti, sizeof(*ti));
+	ti->active = task->active;
+	ti->halting = task->halting;
+	ti->ipc_active = task->ipc_active;
+	ti->thread_count = task->thread_count;
+	ti->active_thread_count = task->active_thread_count;
+	ti->suspend_count = task->suspend_count;
+	for (int l = 0; l < 2; l++) {
+		queue_iterate(lists[l], thread, thread_t, threads) {
+			if (get_threadtask(thread) != task) {
+				continue;
+			}
+			ti->listed++;
+			ti->terminated += l;
+			if (n < max) {
+				thread_reference(thread);
+				terminated[n] = (uint8_t)l;
+				held[n++] = thread;
+			}
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+
+	now = mach_absolute_time();
+	for (int i = 0; i < n; i++) {
+		sf_ew_snapshot(held[i], &out[i], exit_thread, now);
+		if (terminated[i]) {
+			out[i].flags |= SF_EW_TERMINATED;
+		}
+		thread_deallocate(held[i]);
+	}
+	kfree_type(thread_t, max, held);
+	kfree_data(terminated, max);
+	*count = n;
+	return 0;
+}
