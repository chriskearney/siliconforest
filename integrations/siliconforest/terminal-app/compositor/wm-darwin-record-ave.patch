diff -Naur '--exclude=target' source/crates/wm-darwin/src/encoder_ave.rs /home/chrisk/.t3/worktrees/darwin-lab/sf-integration/runs/m1-desktop-010/ave-rec-001/source/crates/wm-darwin/src/encoder_ave.rs
--- a/crates/wm-darwin/src/encoder_ave.rs
+++ b/crates/wm-darwin/src/encoder_ave.rs
@@ -0,0 +1,143 @@
+//! The Apple Video Encoder through `/dev/sfave` (`integrations/siliconforest/m1-ave`): H.264 IPPP, one stream at a
+//! time. A frame is copied by the driver, encoded, and its Annex-B bytes go into our own MP4 writer (`mp4.rs`), so
+//! a hardware recording needs no ffmpeg. Every wait is in the driver and bounded. A size the encoder does not take,
+//! or a device that is not there, is an error from `open`, and `record_encoder=auto` then uses the software encoder.
+use super::{Encoder, EncoderSummary, NvFrame, Settings};
+use crate::mp4;
+use std::fs::{File, OpenOptions};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::os::unix::fs::OpenOptionsExt;
+use std::time::Instant;
+
+const DEVICE: &[u8] = b"/dev/sfave\0";
+// sfave_ioctl.h: _IOR('E',1,232 bytes), _IOW('E',2,48), _IOWR('E',3,56), _IO('E',4)
+const IOC_INFO: libc::c_ulong = 0x40E8_4501;
+const IOC_START: libc::c_ulong = 0x8030_4502;
+const IOC_FRAME: libc::c_ulong = 0xC038_4503;
+const IOC_STOP: libc::c_ulong = 0x2000_4504;
+const INFO_BYTES: usize = 232;
+const ABI: u32 = 2;
+const HANDSHAKE_READY: u32 = 5;
+const CAP_H264: u32 = 1;
+/// An IDR picture at least this often, so a player can seek.
+const IDR_US: u64 = 2_000_000;
+
+#[repr(C)]
+#[derive(Default)]
+struct Start {
+    width: u32, height: u32, crop_w: u32, crop_h: u32,
+    fps: u32, qp: u32, bitrate: u32, profile_idc: u32,
+    level_idc: u32, cabac: u32, flags: u32, reserved: u32,
+}
+#[repr(C)]
+#[derive(Default)]
+struct Frame {
+    y: u64, uv: u64, out: u64,
+    y_stride: u32, uv_stride: u32, out_cap: u32, out_len: u32,
+    idr: u32, keyframe: u32, n: u32, reserved: u32,
+}
+const _: () = assert!(std::mem::size_of::<Start>() == 48 && std::mem::size_of::<Frame>() == 56);
+
+fn device() -> Result<OwnedFd, String> {
+    // SAFETY: a NUL-terminated path; the descriptor is owned from here on
+    let fd = unsafe { libc::open(DEVICE.as_ptr().cast(), libc::O_RDWR | libc::O_CLOEXEC) };
+    if fd < 0 {
+        return Err(format!("/dev/sfave: {}", std::io::Error::last_os_error()));
+    }
+    let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+    let mut info = [0u8; INFO_BYTES];
+    // SAFETY: the buffer is the size this request writes. The first INFO starts the coprocessor (bounded).
+    if unsafe { libc::ioctl(fd.as_raw_fd(), IOC_INFO, info.as_mut_ptr()) } < 0 {
+        return Err(format!("SFAVE INFO: {}", std::io::Error::last_os_error()));
+    }
+    let word = |i: usize| u32::from_ne_bytes([info[i * 4], info[i * 4 + 1], info[i * 4 + 2], info[i * 4 + 3]]);
+    if word(0) != ABI || word(1) as usize != INFO_BYTES {
+        return Err("SFAVE INFO: another driver ABI".into());
+    }
+    if word(6) != 0 || word(7) != HANDSHAKE_READY || word(3) & CAP_H264 == 0 {
+        return Err(format!("the encoder is not ready (error {}, handshake {})", word(6), word(7)));
+    }
+    Ok(fd)
+}
+
+pub fn probe() -> Result<(), String> {
+    device().map(|_| ())
+}
+
+pub fn open(s: &Settings) -> Result<Box<dyn Encoder>, String> {
+    if s.width % 16 != 0 || s.height % 16 != 0 || s.width < 192 || s.height < 96 || s.width > 4096 || s.height > 4096 {
+        return Err(format!("the AVE takes whole macroblocks, not {}x{}", s.width, s.height));
+    }
+    let fd = device()?;
+    let fps = s.fps.clamp(1, 60);
+    // about 0.1 bit per pixel: a clean desktop recording, firmware rate control
+    let bitrate = (u64::from(s.width) * u64::from(s.height) * u64::from(fps) / 10).clamp(2_000_000, 40_000_000) as u32;
+    let start = Start { width: s.width, height: s.height, fps, qp: 26, bitrate, profile_idc: 100, cabac: 1, ..Default::default() };
+    // SAFETY: the struct is the size this request reads
+    if unsafe { libc::ioctl(fd.as_raw_fd(), IOC_START, &start as *const Start) } < 0 {
+        return Err(format!("SFAVE start: {}", std::io::Error::last_os_error()));
+    }
+    // record.rs made the file (its name and mode 0600); it is ours to fill
+    let file = OpenOptions::new().write(true).truncate(true).custom_flags(libc::O_NOFOLLOW).open(&s.path)
+        .map_err(|e| format!("{}: {e}", s.path.display()))?;
+    let mux = mp4::Writer::new(file, s.width, s.height)?;
+    let cap = s.width as usize * s.height as usize * 3 / 2 + 65536;
+    Ok(Box::new(Ave { fd, mux: Some(mux), out: vec![0; cap], width: s.width, height: s.height, fps, bitrate, last_idr: None, push_s: 0.0, push_max_ms: 0.0 }))
+}
+
+struct Ave {
+    fd: OwnedFd,
+    mux: Option<mp4::Writer<File>>,
+    out: Vec<u8>,
+    width: u32,
+    height: u32,
+    fps: u32,
+    bitrate: u32,
+    last_idr: Option<u64>,
+    push_s: f64,
+    push_max_ms: f64,
+}
+
+impl Encoder for Ave {
+    fn name(&self) -> &'static str {
+        "ave"
+    }
+    fn push(&mut self, f: &NvFrame<'_>) -> Result<(), String> {
+        let luma = self.width as usize * self.height as usize;
+        if f.width != self.width || f.height != self.height || f.data.len() < luma + luma / 2 {
+            return Err("a frame of another size".into());
+        }
+        let t = Instant::now();
+        let idr = self.last_idr.is_none_or(|at| f.at_us.saturating_sub(at) >= IDR_US);
+        let y = f.data.as_ptr() as u64;
+        let mut e = Frame { y, uv: y + luma as u64, out: self.out.as_mut_ptr() as u64, y_stride: self.width, uv_stride: self.width,
+            out_cap: self.out.len() as u32, idr: u32::from(idr), ..Default::default() };
+        // SAFETY: the planes and the output stay valid for the call, which copies from and into them
+        if unsafe { libc::ioctl(self.fd.as_raw_fd(), IOC_FRAME, &mut e as *mut Frame) } < 0 {
+            return Err(format!("SFAVE frame: {}", std::io::Error::last_os_error()));
+        }
+        if idr {
+            self.last_idr = Some(f.at_us);
+        }
+        let n = (e.out_len as usize).min(self.out.len());
+        self.mux.as_mut().ok_or("the movie is closed")?.add(&self.out[..n], f.at_us)?;
+        let s = t.elapsed().as_secs_f64();
+        self.push_s += s;
+        self.push_max_ms = self.push_max_ms.max(s * 1000.0);
+        Ok(())
+    }
+    fn finish(mut self: Box<Self>) -> Result<EncoderSummary, String> {
+        // SAFETY: no argument
+        let stopped = unsafe { libc::ioctl(self.fd.as_raw_fd(), IOC_STOP) };
+        let stop_error = (stopped < 0).then(|| std::io::Error::last_os_error().to_string());
+        let mux = self.mux.take().ok_or("the movie is closed")?;
+        let frames = mux.frames();
+        let file = mux.finish(self.fps)?;
+        file.sync_all().map_err(|e| e.to_string())?;
+        if let Some(e) = stop_error {
+            return Err(format!("SFAVE stop: {e}"));
+        }
+        Ok(EncoderSummary { frames, cpu_s: 0.0, push_s: self.push_s, push_max_ms: self.push_max_ms,
+            detail: format!("encoder=ave bitrate={} fps={}", self.bitrate, self.fps) })
+    }
+}
