diff -Naur '--exclude=target' source/crates/wm-darwin/src/mp4.rs /home/chrisk/.t3/worktrees/darwin-lab/sf-integration/runs/m1-desktop-010/ave-rec-001/source/crates/wm-darwin/src/mp4.rs
