+/// deskperf-003: how many refreshes of `refresh_us` apart a window's pictures come, from its last 16 commit intervals
+/// (us): steady (12 within a quarter of their median) and 1.5 refreshes or more; 2..4, else `None`.
+pub(crate) fn cadence_of(intervals: &[u32], refresh_us: u32) -> Option<u32> {
+    if intervals.len() < 16 {
+        return None;
+    }
+    let mut v = intervals.to_vec();
+    v.sort_unstable();
+    let median = v[v.len() / 2];
+    let steady = v.iter().filter(|d| (i64::from(**d) - i64::from(median)).unsigned_abs() * 4 <= u64::from(median)).count();
+    if steady < 12 || median * 2 < refresh_us * 3 {
+        return None;
+    }
+    let spacing = (median + 2_000) / refresh_us;
+    (2..=4).contains(&spacing).then_some(spacing)
+}
