+    /// The last rendered output, cropped to `rect`, as a PNG. `None` when the renderer has no
+    /// frame yet (a CPU desk): the caller keeps the CPU composite. A socket capture leaves the
+    /// pointer out; a key capture includes it when Options ask.
+    fn capture_shown_frame(&mut self, rect: Rect, pointer: bool) -> Result<Option<Vec<u8>>, String> {
+        let screen = self.wm.backend().screen_size();
+        let frame = if pointer { self.read_back()? } else { self.renderer.read_back()? };
+        let Some(pixels) = frame else {
+            return Ok(None);
+        };
+        let need = (screen.w as usize).saturating_mul(screen.h as usize).saturating_mul(4);
+        if pixels.len() != need {
+            eprintln!(
+                "WMCAPTURE gpu read_back {} bytes != screen {}x{} ({} bytes); CPU composite",
+                pixels.len(),
+                screen.w,
+                screen.h,
+                need
+            );
+            return Ok(None);
+        }
+        let Some(size) = tiny_skia::IntSize::from_wh(screen.w, screen.h) else {
+            return Ok(None);
+        };
+        let Some(pixmap) = tiny_skia::Pixmap::from_vec(pixels, size) else {
+            return Ok(None);
+        };
+        eprintln!(
+            "WMCAPTURE gpu read_back crop={},{} {}x{} screen={}x{} pointer={}",
+            rect.pos.x, rect.pos.y, rect.size.w, rect.size.h, screen.w, screen.h, u8::from(pointer)
+        );
+        Ok(Some(encode_png(&pixmap, rect)?))
+    }
