 /// All waits/signals happen on the owning event loop; no detached reaper or
 /// blocking Drop. Failure retains the PID/state for the session's final audit.
+/// How long an application has to report READY: 25 s, or CHONKSTEP_DARWIN_APP_READY_SECONDS
+/// (5..=600). Real hardware keeps the default; an emulated machine (QEMU's TCG on a busy host)
+/// starts a process an order of magnitude slower and sets it longer.
+pub const APP_READY_ENV: &str = "CHONKSTEP_DARWIN_APP_READY_SECONDS";
+fn ready_timeout() -> Duration {
+    Duration::from_secs(
+        std::env::var(APP_READY_ENV)
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .filter(|s| (5..=600).contains(s))
+            .unwrap_or(25),
+    )
+}
 struct Lifecycle {
     ready_deadline: Instant,
     application_deadline: Instant,
