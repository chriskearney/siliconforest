+/// DESKPERF: the rows of `rects` (image coordinates, clipped here) from a client pool into a buffer of `pitch`
+/// bytes a row, byte for byte (B, G, R, A or X: what the GPU samples as ARGB8888 / XRGB8888). No conversion and
+/// no clamp: nothing on the CPU reads these pixels, and the GPU blends whatever a client sends without harm.
+/// Returns the pixels copied.
+///
+/// # Safety
+/// `ptr` must be readable for the pool length `layout` was checked against; `dst` writable for
+/// `pitch * layout.height` bytes, with `pitch >= layout.width * 4`.
+pub unsafe fn copy_shm_rows_raw(ptr: *const u8, layout: ShmLayout, dst: *mut u8, pitch: usize, rects: &[DRect]) -> u64 {
+    assert!(pitch >= layout.width as usize * 4, "pitch too small");
+    let mut copied = 0;
+    for rect in rects {
+        let r = rect.intersect(layout.bounds());
+        if r.is_empty() {
+            continue;
+        }
+        let (x0, x1) = (r.x0 as usize, r.x1 as usize);
+        let bytes = (x1 - x0) * 4;
+        // whole rows: one block, the client's padding not copied
+        if x0 == 0 && x1 == layout.width as usize && layout.stride == pitch {
+            let source = layout.offset + r.y0 as usize * layout.stride;
+            unsafe { std::ptr::copy_nonoverlapping(ptr.add(source), dst.add(r.y0 as usize * pitch), (r.y1 - r.y0) as usize * pitch - (pitch - bytes)) };
+        } else {
+            for y in r.y0 as usize..r.y1 as usize {
+                let source = layout.offset + y * layout.stride + x0 * 4;
+                // No Rust reference to client memory is formed; Smithay contains SIGBUS.
+                unsafe { std::ptr::copy_nonoverlapping(ptr.add(source), dst.add(y * pitch + x0 * 4), bytes) };
+            }
+        }
+        copied += r.area();
+    }
+    copied
+}
+
+/// DESKPERF: what `copy_shm_to_gpu` did.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GpuCopy {
+    /// image-space rectangles written (clipped and merged), or the whole picture
+    pub rects: Vec<DRect>,
+    pub pixels: u64,
+    /// the copy itself (inside the client's mapping)
+    pub copy_us: u64,
+}
+
+/// DESKPERF: a client buffer's rows into `dst` (`pitch` bytes a row, `layout`'s size) as they are: the
+/// rectangles of `damage` when given (the rest of `dst` holds the picture before), else all of it. `accept`
+/// runs first, as for `copy_shm_damaged`.
+pub fn copy_shm_to_gpu(
+    buffer: &WlBuffer,
+    dst: *mut u8,
+    pitch: usize,
+    damage: Option<&[DRect]>,
+    accept: impl FnOnce(u32, u32) -> Result<(), String>,
+) -> Result<GpuCopy, String> {
+    with_layout(buffer, |ptr, layout| {
+        accept(layout.width, layout.height)?;
+        let rects = match damage.filter(|d| !d.is_empty()) {
+            Some(damage) => {
+                let mut region = crate::damage::Region::new(layout.width, layout.height);
+                for r in damage {
+                    region.add(*r);
+                }
+                region.rects().to_vec()
+            }
+            None => vec![layout.bounds()],
+        };
+        let started = std::time::Instant::now();
+        let pixels = unsafe { copy_shm_rows_raw(ptr, layout, dst, pitch, &rects) };
+        Ok(GpuCopy { rects, pixels, copy_us: started.elapsed().as_micros() as u64 })
+    })
+}
+
