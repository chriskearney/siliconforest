+/// DESKPERF (QTP, 14:1xZ on 18 November): Command held by the instrument, its window closed (Command-Q), the
+/// release of Command found no window. Before, the seat kept Command held and the instrument's next key, in
+/// another window, came as Command-Space. The release still lets go of the key in the seat (sent to no window),
+/// and the next window's key comes without a modifier.
+#[test]
+#[cfg(feature = "desktop-shell")]
+fn a_synthetic_modifier_released_after_its_window_went_is_not_held_for_the_next_key(){
+    use wm_darwin::hid::{Event,Motion};
+    let(h,connection)=Harness::with_input(true);
+    let (server_end,client_end)=UnixStream::pair().unwrap();
+    h.tx.send(Request::AddClient(server_end)).unwrap();
+    let other=Connection::from_socket(client_end).unwrap();
+    let(mut qb,mut cb,_sb,_tb)=map_with_seat(&other);
+    let virt=|e:Event|{let(tx,rx)=mpsc::channel();h.tx.send(Request::Virtual(e,tx)).unwrap();rx.recv_timeout(Duration::from_secs(3)).unwrap()};
+    let press_in=|r:wm_core::Rect|{
+        let p=wm_core::Point::new(r.pos.x+r.size.w as i32/2,r.pos.y+r.size.h as i32/2);
+        let abs=Motion::Absolute(((f64::from(p.x)+0.25)/319.*65535.).round() as u16,((f64::from(p.y)+0.25)/239.*65535.).round() as u16);
+        virt(Event::Pointer{motion:abs,buttons:0,wheel:0}).unwrap();
+        virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:1,wheel:0}).unwrap();
+        virt(Event::Pointer{motion:Motion::Relative(0,0),buttons:0,wheel:0}).unwrap();
+    };
+    {
+        let(mut qa,mut ca,_sa,_ta)=map_with_seat(&connection);
+        for _ in 0..3{h.snapshot();qa.roundtrip(&mut ca).unwrap();qb.roundtrip(&mut cb).unwrap();}
+        let shot=h.snapshot();
+        assert_eq!(shot.windows.len(),2,"{:?}",shot.windows);
+        press_in(shot.windows[1].0);
+        // Command (KEY_LEFTMETA) held in A
+        virt(Event::Key{evdev:125,down:true}).unwrap();
+        for _ in 0..3{h.snapshot();qa.roundtrip(&mut ca).unwrap();qb.roundtrip(&mut cb).unwrap();}
+        assert!(ca.keys.iter().any(|(k,_)|*k==125),"A got Command: {:?}",ca.keys);
+    }
+    // A's client goes (as after its Command-Q)
+    drop(connection);
+    for _ in 0..5{h.snapshot();qb.roundtrip(&mut cb).unwrap();std::thread::sleep(Duration::from_millis(5));}
+    let shot=h.snapshot();
+    assert_eq!(shot.windows.len(),1,"A is gone");
+    let kb=cb.keys.len();
+    assert_eq!(virt(Event::Key{evdev:125,down:false}),Ok(()),"the release lets go of Command in the seat");
+    for _ in 0..3{h.snapshot();qb.roundtrip(&mut cb).unwrap();}
+    assert_eq!(cb.keys.len(),kb,"the release went to no window");
+    // the next request: a press in B, then Space
+    press_in(shot.windows[0].0);
+    virt(Event::Key{evdev:57,down:true}).unwrap();
+    virt(Event::Key{evdev:57,down:false}).unwrap();
+    for _ in 0..3{h.snapshot();qb.roundtrip(&mut cb).unwrap();}
+    assert!(cb.keys[kb..].iter().any(|(k,_)|*k==57),"B got Space: {:?}",&cb.keys[kb..]);
+    assert_eq!(cb.modifier_masks.last().copied().unwrap_or(0),0,"no modifier held when B gets Space: {:?}",cb.modifier_masks);
+    assert!(cb.held_on_enter.last().is_none_or(|held|!held.contains(&125)),"Command is not among the keys held when B is entered: {:?}",cb.held_on_enter);
+}
