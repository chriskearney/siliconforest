+    let mut queue=connection.new_event_queue();let qh=queue.handle();let mut c=Client::default();
+    connection.display().get_registry(&qh,());for _ in 0..3{queue.roundtrip(&mut c).unwrap();}
+    let surface=c.compositor.as_ref().unwrap().create_surface(&qh,());let xdg=c.shell.as_ref().unwrap().get_xdg_surface(&surface,&qh,());let top=xdg.get_toplevel(&qh,());
