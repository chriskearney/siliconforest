+/// A mapped window whose picture is a dma-buf (size set, `pixels` empty) or a buffer shorter
+/// than `width * height * 4`. `CpuBackend::render` is what `--screencapture` composites; it
+/// must not panic, and the corners fall back to the border.
+#[cfg(test)]
+mod gpu_window_capture_tests {
+    use super::*;
+    use crate::damage::ItemKey;
+    use crate::presenter::Presenter;
+    use std::os::fd::AsFd;
+    use std::os::unix::net::UnixStream;
+    use std::sync::mpsc;
+    use std::thread;
+    use std::time::{Duration, Instant};
+    use wayland_client::{
+        delegate_noop,
+        protocol::{wl_buffer, wl_compositor, wl_registry, wl_shm, wl_shm_pool, wl_surface},
+        Connection, Dispatch, QueueHandle,
+    };
+    use wayland_protocols::xdg::shell::client::{xdg_surface, xdg_toplevel, xdg_wm_base};
+    use wm_theme_api::DecorationShape;
+
+    struct Sink;
+    impl Presenter for Sink {
+        fn present(&mut self, _: &tiny_skia::Pixmap) -> Result<(), String> {
+            Ok(())
+        }
+    }
+    type Job = Box<dyn FnOnce(&mut crate::server::Server) -> String + Send>;
+    struct Harness {
+        jobs: mpsc::Sender<(Job, mpsc::Sender<String>)>,
+        thread: Option<thread::JoinHandle<()>>,
+    }
+    impl Harness {
+        fn start() -> (Self, Connection) {
+            let (server, client) = UnixStream::pair().unwrap();
+            let (jobs, rx) = mpsc::channel::<(Job, mpsc::Sender<String>)>();
+            let thread = thread::spawn(move || {
+                use smithay::reexports::wayland_server::Display;
+                let mut display = Display::<crate::server::Server>::new().unwrap();
+                let mut state = crate::server::Server::new(&display.handle(), Size::new(320, 240)).unwrap();
+                crate::server::Server::add_client(&mut display, server).unwrap();
+                let started = Instant::now();
+                while started.elapsed() < Duration::from_secs(20) {
+                    display.dispatch_clients(&mut state).unwrap();
+                    let _ = state.repaint(&mut Sink, started.elapsed().as_millis() as u32);
+                    display.flush_clients().unwrap();
+                    match rx.try_recv() {
+                        Ok((job, reply)) => {
+                            if reply.send(job(&mut state)).is_err() {
+                                break;
+                            }
+                        }
+                        Err(mpsc::TryRecvError::Disconnected) => break,
+                        Err(mpsc::TryRecvError::Empty) => {}
+                    }
+                    thread::sleep(Duration::from_millis(2));
+                }
+            });
+            (Self { jobs, thread: Some(thread) }, Connection::from_socket(client).unwrap())
+        }
+        fn run(&self, job: impl FnOnce(&mut crate::server::Server) -> String + Send + 'static) -> String {
+            let (tx, rx) = mpsc::channel();
+            self.jobs.send((Box::new(job), tx)).unwrap();
+            rx.recv_timeout(Duration::from_secs(10)).unwrap()
+        }
+    }
+    impl Drop for Harness {
+        fn drop(&mut self) {
+            let (tx, _rx) = mpsc::channel();
+            drop(std::mem::replace(&mut self.jobs, tx));
+            if let Some(thread) = self.thread.take() {
+                let _ = thread.join();
+            }
+        }
+    }
+    #[derive(Default)]
+    struct Client {
+        compositor: Option<wl_compositor::WlCompositor>,
+        shm: Option<wl_shm::WlShm>,
+        base: Option<xdg_wm_base::XdgWmBase>,
+        configured: bool,
+    }
+    impl Dispatch<wl_registry::WlRegistry, ()> for Client {
+        fn event(s: &mut Self, registry: &wl_registry::WlRegistry, event: wl_registry::Event, _: &(), _: &Connection, queue: &QueueHandle<Self>) {
+            if let wl_registry::Event::Global { name, interface, version } = event {
+                match interface.as_str() {
+                    "wl_compositor" => s.compositor = Some(registry.bind(name, version.min(6), queue, ())),
+                    "wl_shm" => s.shm = Some(registry.bind(name, 1, queue, ())),
+                    "xdg_wm_base" => s.base = Some(registry.bind(name, 1, queue, ())),
+                    _ => {}
+                }
+            }
+        }
+    }
+    impl Dispatch<xdg_wm_base::XdgWmBase, ()> for Client {
+        fn event(_: &mut Self, base: &xdg_wm_base::XdgWmBase, event: xdg_wm_base::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+            if let xdg_wm_base::Event::Ping { serial } = event {
+                base.pong(serial);
+            }
+        }
+    }
+    impl Dispatch<xdg_surface::XdgSurface, ()> for Client {
+        fn event(s: &mut Self, surface: &xdg_surface::XdgSurface, event: xdg_surface::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {
+            if let xdg_surface::Event::Configure { serial } = event {
+                surface.ack_configure(serial);
+                s.configured = true;
+            }
+        }
+    }
+    delegate_noop!(Client: ignore wl_compositor::WlCompositor);
+    delegate_noop!(Client: ignore wl_shm::WlShm);
+    delegate_noop!(Client: ignore wl_shm_pool::WlShmPool);
+    delegate_noop!(Client: ignore wl_buffer::WlBuffer);
+    delegate_noop!(Client: ignore xdg_toplevel::XdgToplevel);
+    delegate_noop!(Client: ignore wl_surface::WlSurface);
+
+    fn px(data: &[u8], width: u32, x: i32, y: i32) -> [u8; 4] {
+        let i = (y as usize * width as usize + x as usize) * 4;
+        data[i..i + 4].try_into().unwrap()
+    }
+
+    #[test]
+    fn cpu_composite_of_a_gpu_window_does_not_panic() {
+        let (harness, connection) = Harness::start();
+        let mut queue = connection.new_event_queue();
+        let qh = queue.handle();
+        let mut client = Client::default();
+        connection.display().get_registry(&qh, ());
+        queue.roundtrip(&mut client).unwrap();
+        let surface = client.compositor.as_ref().unwrap().create_surface(&qh, ());
+        let xdg = client.base.as_ref().unwrap().get_xdg_surface(&surface, &qh, ());
+        let _top = xdg.get_toplevel(&qh, ());
+        surface.commit();
+        let started = Instant::now();
+        while !client.configured {
+            queue.roundtrip(&mut client).unwrap();
+            assert!(started.elapsed() < Duration::from_secs(5), "no configure");
+        }
+        let mut file = tempfile::tempfile().unwrap();
+        let (bw, bh) = (80usize, 48usize);
+        std::io::Write::write_all(&mut file, &[240, 20, 10, 255].repeat(bw * bh)).unwrap();
+        let pool = client.shm.as_ref().unwrap().create_pool(file.as_fd(), (bw * bh * 4) as i32, &qh, ());
+        let buffer = pool.create_buffer(0, bw as i32, bh as i32, (bw * 4) as i32, wl_shm::Format::Argb8888, &qh, ());
+        surface.attach(Some(&buffer), 0, 0);
+        surface.commit();
+        for _ in 0..6 {
+            queue.roundtrip(&mut client).unwrap();
+            thread::sleep(Duration::from_millis(15));
+        }
+        let report = harness.run(|server| {
+            let backend = server.wm.backend_mut();
+            let id = backend.windows.iter().find(|(_, w)| w.mapped).map(|(id, _)| *id).expect("a mapped window");
+            let content = backend.windows[&id].content;
+            assert!(content.size.w >= 24 && content.size.h >= 24, "content {content:?}");
+            {
+                let frame = backend.frames.values_mut().find(|f| f.window == id).expect("a frame");
+                frame.geometry = Rect::new(content.pos, content.size);
+                frame.mapped = true;
+                frame.paint = Some(DecorationSurface {
+                    frame_size: content.size,
+                    parts: Vec::new(),
+                    solids: Vec::new(),
+                    shadow: None,
+                    shape: Some(DecorationShape {
+                        rect: Rect::new(Point::new(0, 0), content.size),
+                        radius: 12,
+                        border: 1,
+                        border_rgb: [200, 100, 50],
+                    }),
+                });
+            }
+            backend.effects = true;
+            backend.set_window_external(id, ExternalBuffer { id: 9, width: content.size.w, height: content.size.h }, &[]);
+            let external_patches = backend.display_list().iter().filter(|(sig, _)| matches!(sig.key, ItemKey::Corner(window, _) if window == id)).count();
+            let pix = backend.render().expect("CPU composite of a GPU window");
+            let width = pix.width();
+            let tip = px(pix.data(), width, content.pos.x, content.pos.y + content.size.h as i32 - 1);
+            let center = px(pix.data(), width, content.pos.x + content.size.w as i32 / 2, content.pos.y + content.size.h as i32 / 2);
+            let ring = px(pix.data(), width, content.pos.x + 3, content.pos.y + content.size.h as i32 - 4);
+            let short = content.size.w as usize * content.size.h as usize * 4 - 1;
+            backend.set_window_image(id, Some(DecorationBuffer { width: content.size.w, height: content.size.h, pixels: vec![7; short] }));
+            let short_patches = backend.display_list().iter().filter(|(sig, _)| matches!(sig.key, ItemKey::Corner(window, _) if window == id)).count();
+            backend.render().expect("CPU composite of a short buffer");
+            format!("ext_patches={external_patches} tip={tip:?} center={center:?} ring={ring:?} short_patches={short_patches}")
+        });
+        assert!(report.starts_with("ext_patches=0 "), "{report}");
+        assert!(report.contains("tip=[56, 72, 80, 255]"), "the corner tip stays the desk colour: {report}");
+        assert!(report.contains("center=[56, 72, 80, 255]"), "a GPU buffer's empty pixels are not drawn: {report}");
+        assert!(report.contains("short_patches=2"), "a short CPU buffer still gets both corner pictures: {report}");
+        let ring = report.split("ring=").nth(1).unwrap().split(' ').next().unwrap();
+        assert!(ring.starts_with('[') && !ring.contains("56, 72, 80, 255"), "the border ring is drawn without the window's pixels: {report}");
+    }
+}
