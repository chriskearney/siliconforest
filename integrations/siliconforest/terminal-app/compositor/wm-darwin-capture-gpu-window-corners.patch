+    #[test]
+    fn a_corner_without_cpu_pixels_uses_the_border_and_does_not_panic() {
+        let clip = CornerClip { rect: DRect::new(100, 100, 300, 260), radius: 12, border: 1, rgb: [200, 100, 50] };
+        let at = Point::new(101, 100);
+        let none = corner_patches(&clip, None);
+        let empty = DecorationBuffer { width: 198, height: 159, pixels: Vec::new() };
+        let short = DecorationBuffer { width: 198, height: 159, pixels: vec![9; 198 * 159 * 4 - 1] };
+        let huge = DecorationBuffer { width: u32::MAX, height: u32::MAX, pixels: Vec::new() };
+        for (name, image) in [("empty", &empty), ("short", &short), ("overflow", &huge)] {
+            let got = corner_patches(&clip, Some((image, at)));
+            for (side, (place, picture)) in got.into_iter().enumerate() {
+                assert_eq!(place, none[side].0, "{name} side {side}");
+                assert_eq!((picture.width, picture.height), (12, 12));
+                assert_eq!(picture.pixels, none[side].1.pixels, "{name}: corners drawn as if there were no picture");
+            }
+        }
+        // a full buffer is still sampled: the square's inner end is the content, not the fallback
+        let mut full = DecorationBuffer { width: 198, height: 159, pixels: vec![0; 198 * 159 * 4] };
+        full.pixels.chunks_exact_mut(4).for_each(|p| p.copy_from_slice(&[10, 20, 30, 255]));
+        let got = corner_patches(&clip, Some((&full, at)));
+        let inner = &got[0].1.pixels[((250 - 248) * 12 + (111 - 100)) * 4..][..4];
+        assert_eq!(inner, &[10, 20, 30, 255], "CPU pixels are still the corner's content");
+        assert_ne!(got[0].1.pixels, none[0].1.pixels);
+    }
 }
