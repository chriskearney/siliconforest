+/// `image` holds a byte for every texel. Otherwise the CPU cannot sample it.
+fn cpu_pixels(image: &DecorationBuffer) -> bool {
+    let enough = (image.width as usize)
+        .checked_mul(image.height as usize)
+        .and_then(|texels| texels.checked_mul(4))
+        .is_some_and(|need| image.pixels.len() >= need);
+    if !enough {
+        note_missing_cpu_pixels();
+    }
+    enough
+}
+
+fn note_missing_cpu_pixels() {
+    static ONCE: AtomicBool = AtomicBool::new(false);
+    if !ONCE.swap(true, Ordering::Relaxed) {
+        eprintln!("WMCAPTURE corner patches: window picture without CPU pixels (GPU buffer): corners drawn without its content");
+    }
+}
