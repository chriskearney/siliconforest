#!/bin/sh
# SPDX-License-Identifier: MIT
# Start Quake (the QuakeSpasm macOS app, unchanged, with the shareware data) in a window on
# the desk. The app, its private frameworks and the data stay under /private/var/db/sfquake
# and are not part of this tree: integrations/siliconforest/quake/install.sh puts them there.
#   sf-open-quake [quake options...]     default: -window -width 1280 -height 800
set -eu
B=${SFQUAKE:-/private/var/db/sfquake}
APP="$B/QuakeSpasm.app/Contents/MacOS/QuakeSpasm"
if [ ! -x "$APP" ] || [ ! -r "$B/game/id1/pak0.pak" ] || [ ! -r "$B/fw/libsfquakestart.dylib" ]; then
    echo "sf-open-quake: no staged Quake at $B (run quake/install.sh)" >&2
    exit 1
fi
# An inherited runtime dir with no wayland-0 socket is not this desk (an SSH session).
if [ ! -S "${XDG_RUNTIME_DIR:-}/wayland-0" ]; then
    XDG_RUNTIME_DIR=/private/var/run/gpu-desktop
fi
export XDG_RUNTIME_DIR
export XDG_STATE_HOME="${XDG_STATE_HOME:-/private/var/db/desktop-state}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export LANG="${LANG:-en_US.UTF-8}"
export HOME="$B/home" CFFIXED_USER_HOME="$B/home"
export mesa_glthread="${mesa_glthread:-true}"
mkdir -p "$B/home" "$B/logs"
[ $# -gt 0 ] || set -- -window -width 1280 -height 800
cd "$B/game"
# ForceFeedback and the IOKit fill are for this process only. libsfquakestart makes the app's
# SDLMain the delegate, which its Info.plist would otherwise leave unset (quake/README.md).
DYLD_FRAMEWORK_PATH="$B/fw" DYLD_INSERT_LIBRARIES="$B/fw/libsfquakestart.dylib" \
    exec "$APP" -basedir "$B/game" "$@" >>"$B/logs/app.out" 2>>"$B/logs/app.err"
