#!/bin/sh
# SPDX-License-Identifier: MIT
# Start the unmodified TextEdit the same way Preview is started: the bundle's
# own executable, with the TextEdit AppKit front ahead of the Preview dock
# overlay. This script does not write inside the bundle.
set -eu
APP=${TEXTEDIT_APP:-/private/var/db/sftextedit/TextEdit.app}
EXE="$APP/Contents/MacOS/TextEdit"
EXPECTED=98db1c6a0170fd624cee7b1f06a5f396f24e56bcd00831cf8e7cb17de6f0a13f
TE=/private/var/db/sftextedit
R=/private/var/db/sfpreview-dock
P=/private/var/db/sfpreview-app/p44-diagnostic-01
got=$(shasum -a 256 "$EXE" | awk 'NR==1 { print $1 }')
if [ "$got" != "$EXPECTED" ]; then
    echo "sf-open-textedit: $EXE hash $got is not the unmodified bundle" >&2
    exit 1
fi
mkdir -p "$TE/home" "$TE/tmp"
export HOME="$TE/home"
export CFFIXED_USER_HOME="$TE/home"
export TMPDIR="$TE/tmp/"
export USER=root
export LOGNAME=root
export PATH="/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/private/var/run/gpu-desktop}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export LANG="${LANG:-en_US.UTF-8}"
export DYLD_FRAMEWORK_PATH="$TE/Frameworks:$TE/PrivateFrameworks:$R/Frameworks:$P/prefix/System/Library/PrivateFrameworks:$P/prefix/System/Library/Frameworks"
export DYLD_LIBRARY_PATH="$R/lib:$P/core:$P/prefix/usr/lib:$P/prefix/usr/lib/swift"
cd "$HOME"
exec "$EXE" "$@"
