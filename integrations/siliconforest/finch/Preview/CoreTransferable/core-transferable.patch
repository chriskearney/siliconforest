+private func temporaryTransferDirectory() throws -> URL {
+    let root = getenv("TMPDIR").map { String(cString: $0) } ?? "/tmp"
+    let template = URL(fileURLWithPath: root).appendingPathComponent("CoreTransferable-XXXXXXXX")
+    var path = Array(template.path.utf8CString)
+    guard path.withUnsafeMutableBufferPointer({ mkdtemp($0.baseAddress) }) != nil else {
+        throw NSError(domain: NSPOSIXErrorDomain, code: Int(errno), userInfo: nil)
+    }
+    let directory = path.withUnsafeBufferPointer { String(cString: $0.baseAddress!) }
+    return URL(fileURLWithPath: directory, isDirectory: true)
+}
+
+private func temporaryFile(type: UTType) throws -> URL {
+    let file = try temporaryTransferDirectory().appendingPathComponent("Item")
+    guard let ext = type.preferredFilenameExtension, !ext.contains("/"), !ext.contains("\0") else {
+        return file
+    }
+    return file.appendingPathExtension(ext)
+}
+
+private func copyTransferFile(from source: URL, to destination: URL) throws {
+    let flags = UInt32(COPYFILE_DATA | COPYFILE_EXCL | COPYFILE_NOFOLLOW)
+    guard copyfile(source.path, destination.path, nil, flags) == 0 else {
+        throw NSError(domain: NSPOSIXErrorDomain, code: Int(errno), userInfo: nil)
     }
-    return file
 }

