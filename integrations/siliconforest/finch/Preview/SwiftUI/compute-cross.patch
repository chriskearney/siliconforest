--- /dev/null
+++ b/Sources/ComputeCxx/Swift/SwiftFunction.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Chris Kearney and the SiliconForest contributors
+#pragma once
+#if __has_include(<ptrauth.h>)
+#include <ptrauth.h>
+#endif
+
+namespace IAG::swift {
+// Finch's retained patch applies this operation inline in AttributeType::update
+// and ClosureFunction. Its other callback sites name this missing helper.
+// Swift closure pointers can carry a Swift discriminator; the C++ callback call
+// sites use their ordinary function-pointer representation.
+template <class Function> inline Function function(Function pointer) {
+#if __has_feature(ptrauth_calls)
+    return reinterpret_cast<Function>(ptrauth_sign_unauthenticated(
+        ptrauth_strip(reinterpret_cast<void *>(pointer), ptrauth_key_function_pointer),
+        ptrauth_key_function_pointer, 0));
+#else
+    return pointer;
+#endif
+}
+} // namespace IAG::swift
