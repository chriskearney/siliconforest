+static CGRect PDFRectForCGPDFBox(CGPDFPageRef page, PDFDisplayBox box, CGPDFBox *resolvedBox)
+{
+    CGPDFBox cgBox = PDFBoxForDisplayBox(box);
+    CGRect rect = CGPDFPageGetBoxRect(page, cgBox);
+    if (CGRectIsEmpty(rect) && cgBox != kCGPDFMediaBox && cgBox != kCGPDFCropBox) {
+        cgBox = kCGPDFCropBox;
+        rect = CGPDFPageGetBoxRect(page, cgBox);
+    }
+    if (CGRectIsEmpty(rect) && cgBox == kCGPDFCropBox) {
+        cgBox = kCGPDFMediaBox;
+        rect = CGPDFPageGetBoxRect(page, cgBox);
+    }
+    if (resolvedBox)
+        *resolvedBox = cgBox;
+    return rect;
 }
 
