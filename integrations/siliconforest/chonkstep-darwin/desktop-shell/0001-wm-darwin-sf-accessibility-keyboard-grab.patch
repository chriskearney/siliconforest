+/// Unix socket path shared with AppKit's SFAccessibilityServer and axserver.py
+const SF_AX_SOCKET_PATH: &str = "/tmp/com.siliconforest.axuiserver";
+
+/// Forward a key event to the accessibility daemon (fire-and-forget, non-blocking).
+/// JSON format: {"type":"key_event","evdev":N,"down":true/false,"modifiers":M}
+fn sf_ax_forward_key(evdev: u32, down: bool, modifiers: u8) {
+    if let Ok(mut sock) = UnixStream::connect(SF_AX_SOCKET_PATH) {
+        let msg = format!(
+            "{{\"type\":\"key_event\",\"evdev\":{},\"down\":{},\"modifiers\":{}}}\n",
+            evdev, down, modifiers
+        );
+        let _ = sock.write_all(msg.as_bytes());
+    }
+}
