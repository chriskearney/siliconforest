+// CAAnimation.h declares the animation classes in order (CAPropertyAnimation at its end); not imported by it
+#import <QuartzCore/CAAnimation.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+typedef NSString *CAAnimationCalculationMode;
+typedef NSString *CAAnimationRotationMode;
+
+CA_EXPORT CAAnimationCalculationMode const kCAAnimationLinear;
+CA_EXPORT CAAnimationCalculationMode const kCAAnimationDiscrete;
+CA_EXPORT CAAnimationCalculationMode const kCAAnimationPaced;
+CA_EXPORT CAAnimationCalculationMode const kCAAnimationCubic;
