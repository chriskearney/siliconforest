+// (QTP) when the i-th keyframe falls, from keyTimes or evenly spaced
+static double keyTimeAt(NSArray *keyTimes,BOOL useKeyTimes,NSUInteger i,NSUInteger last){
+   if(useKeyTimes && i<[keyTimes count])
+    return [[keyTimes objectAtIndex:i] doubleValue];
+   return last>0 ? (double)i/(double)last : 0;
+}
+
+// (QTP) a keyframe animation at this time: the two neighbouring values and the fraction between them
+static BOOL keyframeSegment(CAKeyframeAnimation *animation,CFTimeInterval currentTime,id *from,id *to,double *fraction){
+   NSArray   *values=[animation values];
+   NSUInteger count=[values count];
+   CFTimeInterval duration=[animation duration];
+   double     progress=duration>0 ? (currentTime-[animation beginTime])/duration : 1;
+
+   if(count==0)
+    return NO;
+   if(progress<0)
+    progress=0;
+   if(progress>1)
+    progress=1;
+   // the whole animation's pacing (none: linear, as documented for keyframe animations)
+   if([animation timingFunction]!=nil)
+    progress=applyMediaTimingFunction([animation timingFunction],progress);
+
+   NSArray *keyTimes=[animation keyTimes];
+   BOOL     discrete=[[animation calculationMode] isEqualToString:kCAAnimationDiscrete];
+   NSUInteger last=discrete ? count : count-1;
+   BOOL     useKeyTimes=[keyTimes count]>=count;
+   NSUInteger i=0;
+   while(i+1<count && keyTimeAt(keyTimes,useKeyTimes,i+1,last)<=progress)
+    i++;
+   if(discrete || i+1>=count){
+    *from=*to=[values objectAtIndex:i];
+    *fraction=0;
+    return YES;
+   }
+   double start=keyTimeAt(keyTimes,useKeyTimes,i,last),end=keyTimeAt(keyTimes,useKeyTimes,i+1,last);
+   double local=end>start ? (progress-start)/(end-start) : 1;
+   NSArray *functions=[animation timingFunctions];
+   if(i<[functions count])
+    local=applyMediaTimingFunction([functions objectAtIndex:i],local);
+   *from=[values objectAtIndex:i];
+   *to=[values objectAtIndex:i+1];
+   *fraction=local;
+   return YES;
+}
+
 // (FXPERF2) the keys the renderer interpolates; a layer nothing animates is read through its properties (KVC boxed
 // each value, structs through an NSInvocation: a large part of the renderer's time in Firefox's parent)
 static NSString *const sfcaKeyAnchorPoint=@"anchorPoint",*const sfcaKeyPosition=@"position",*const sfcaKeyBounds=@"bounds",
@@ -150,8 +198,14 @@ static float interpolateFloatInLayerKey(CALayer *layer,NSString *key,CFTimeInter
         
     return resultFloat;
    }
-   
-   return 0;
+   if([animation isKindOfClass:[CAKeyframeAnimation class]]){
+    id from,to;
+    double fraction;
+    if(keyframeSegment((CAKeyframeAnimation *)animation,currentTime,&from,&to,&fraction))
+     return [from floatValue]+([to floatValue]-[from floatValue])*fraction;
+   }
+   // (QTP) an animation this renderer cannot interpolate leaves the layer at its model value (it was drawn at 0)
+   return key==sfcaKeyOpacity ? layer.opacity : [[layer valueForKey:key] floatValue];
 }
 
