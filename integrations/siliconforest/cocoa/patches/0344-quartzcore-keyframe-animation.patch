+// CAKeyframeAnimation.m - see the header. SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Chris Kearney and the SiliconForest contributors
+//
+// Written from the public CAKeyframeAnimation documentation. CARenderer.m interpolates it for the keys it
+// animates (opacity, position, anchor point, bounds): linear between the two neighbouring values at keyTimes (or
+// evenly spaced), each segment through its own timing function, or holding each value (discrete). Paced and cubic
+// modes are drawn as linear and a path is not followed: an animation with a path and no values leaves the layer at
+// its model value.
+#import <QuartzCore/CAKeyframeAnimation.h>
+
+CAAnimationCalculationMode const kCAAnimationLinear = @"linear";
+CAAnimationCalculationMode const kCAAnimationDiscrete = @"discrete";
+CAAnimationCalculationMode const kCAAnimationPaced = @"paced";
+CAAnimationCalculationMode const kCAAnimationCubic = @"cubic";
+CAAnimationCalculationMode const kCAAnimationCubicPaced = @"cubicPaced";
+CAAnimationRotationMode const kCAAnimationRotateAuto = @"auto";
+CAAnimationRotationMode const kCAAnimationRotateAutoReverse = @"autoReverse";
+
+@implementation CAKeyframeAnimation
+
+-init {
+   if((self=[super init])==nil)
+    return nil;
+   _calculationMode=[kCAAnimationLinear copy];
+   return self;
+}
+
+-(void)dealloc {
+   [_values release];
+   [_keyTimes release];
+   [_timingFunctions release];
+   [_calculationMode release];
+   [_rotationMode release];
+   [_tensionValues release];
+   [_continuityValues release];
+   [_biasValues release];
+   CGPathRelease(_path);
+   [super dealloc];
+}
+
+#define SF_COPY_PROPERTY(type, getter, setter, ivar) \
+   -(type)getter { return ivar; } \
+   -(void)setter:(type)value { value=[value copy]; [ivar release]; ivar=value; }
+
+SF_COPY_PROPERTY(NSArray *, values, setValues, _values)
+SF_COPY_PROPERTY(NSArray *, keyTimes, setKeyTimes, _keyTimes)
+SF_COPY_PROPERTY(NSArray *, timingFunctions, setTimingFunctions, _timingFunctions)
+SF_COPY_PROPERTY(NSString *, calculationMode, setCalculationMode, _calculationMode)
+SF_COPY_PROPERTY(NSString *, rotationMode, setRotationMode, _rotationMode)
+SF_COPY_PROPERTY(NSArray *, tensionValues, setTensionValues, _tensionValues)
+SF_COPY_PROPERTY(NSArray *, continuityValues, setContinuityValues, _continuityValues)
+SF_COPY_PROPERTY(NSArray *, biasValues, setBiasValues, _biasValues)
+
+-(CGPathRef)path {
+   return _path;
+}
+
+-(void)setPath:(CGPathRef)value {
+   CGPathRetain(value);
+   CGPathRelease(_path);
+   _path=value;
+}
+
+@end
