+// Pointer lock / mouse disassociation via WindowServer (zwp_pointer_constraints_v1 + zwp_relative_pointer_v1)
+static kern_return_t sfCallWindowServerRPC(void *data, size_t len, void *reply, int *replyLen) {
+    static kern_return_t (*rpcFn)(void *, size_t, void *, int *);
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        rpcFn = (kern_return_t (*)(void *, size_t, void *, int *))dlsym(RTLD_DEFAULT, "_windowServerRPC");
+    });
+    return rpcFn != NULL ? rpcFn(data, len, reply, replyLen) : KERN_FAILURE;
+}
