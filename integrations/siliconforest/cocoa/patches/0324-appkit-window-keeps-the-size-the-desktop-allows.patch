+    /* (VLC) the size the desktop let this window have when the application last asked for more: an application that
+     * asks again for that size gets the desktop's (a window server keeps a window within the screen's usable area;
+     * VLC asks for its video's size in pixels, larger than the screen, and was shown cut off with its controls out of
+     * sight while it laid itself out for the size it asked for). The user's own resizing, which comes as configures,
+     * is never limited, and a configure larger than the limit lifts it. */
+    if (tellWS) {
+        NSValue *limit = objc_getAssociatedObject(self, &SFServerLimitKey);
+
+        if (limit != nil) {
+            NSSize most = [limit sizeValue];
+            CGFloat top = NSMaxY(newFrame);
+
+            if (NSWidth(newFrame) > most.width)
+                newFrame.size.width = most.width;
+            if (NSHeight(newFrame) > most.height) {
+                newFrame.size.height = most.height;
+                newFrame.origin.y = top - most.height;
+            }
+        }
+        if (!NSEqualSizes(newFrame.size, _frame.size))
+            objc_setAssociatedObject(self, &SFAskedSizeKey, [NSArray arrayWithObjects:[NSValue valueWithSize:newFrame.size],
+                [NSNumber numberWithDouble:[NSDate timeIntervalSinceReferenceDate]], nil], OBJC_ASSOCIATION_RETAIN);
+    }
