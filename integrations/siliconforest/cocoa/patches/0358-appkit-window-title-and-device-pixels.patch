+@implementation NSScreen (SFDevicePixels)
+
+// (private on macOS) the screen's size in device pixels: its size in points at its backing scale
+- (NSSize)devicePixelCounts
+{
+    NSSize size = [self frame].size;
+    CGFloat scale = [self backingScaleFactor];
+    return NSMakeSize(round(size.width * scale), round(size.height * scale));
+}
+
+@end
+
