+       imageToSurface.a,imageToSurface.b,imageToSurface.c,imageToSurface.d,imageToSurface.tx,imageToSurface.ty,why);
+    }
+   }
    
    if(softMask==NULL)
     maskToSurface=O2AffineTransformIdentity;
