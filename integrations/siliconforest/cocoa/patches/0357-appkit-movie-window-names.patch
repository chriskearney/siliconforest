+@implementation NSDocument (SFDuplicates)
+
+// (private on macOS) documents made by Duplicate: there is no Duplicate here, so none is one and none has an original
+- (BOOL)_isDuplicate { return NO; }
+- (NSURL *)_originalDocumentURL { return nil; }
+
+// (macOS 10.7) a document's part in window restoration, as NSResponder has it: this AppKit restores no windows, so
+// nothing is saved; a subclass's -encodeRestorableStateWithCoder: calls super and finds it here
+- (void)invalidateRestorableState { }
+- (void)encodeRestorableStateWithCoder:(NSCoder *)coder { (void)coder; }
+- (void)restoreStateWithCoder:(NSCoder *)coder { (void)coder; }
++ (NSArray *)restorableStateKeyPaths { return [NSArray array]; }
+
+// (macOS 10.7) the end of the part of an asynchronous save during which the user must wait: saving here does not
