+/* (QTP) More names Apple's QuickTime Player sends while it opens a movie and builds its window. */
+#import <AppKit/NSCursor.h>
+#import <AppKit/NSTextField.h>
+#import <AppKit/NSOpenPanel.h>
+#import <AppKit/NSDocument.h>
+
+static char SFGestureMaskKey, SFMaximumLinesKey, SFValueDescriptionKey, SFNewDocumentButtonKey;
+
+@implementation NSApplication (SFGestureEventMask)
+
+// (private on macOS) which gesture events the application takes; every gesture reaches it here: the mask is kept
+- (NSEventMask)gestureEventMask
+{
+    NSNumber *mask = objc_getAssociatedObject(self, &SFGestureMaskKey);
+    return mask ? (NSEventMask)[mask unsignedLongLongValue] : (NSEventMask)~0ULL;
+}
+
+- (void)setGestureEventMask:(NSEventMask)mask
+{
+    objc_setAssociatedObject(self, &SFGestureMaskKey, [NSNumber numberWithUnsignedLongLong:mask], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+@end
+
+@implementation NSTextField (SFMaximumLines)
+
+// (macOS 10.11) the most lines the field shows (0: no limit); kept, and a single line turns wrapping off
+- (NSInteger)maximumNumberOfLines
+{
+    return [objc_getAssociatedObject(self, &SFMaximumLinesKey) integerValue];
+}
+
+- (void)setMaximumNumberOfLines:(NSInteger)lines
+{
+    objc_setAssociatedObject(self, &SFMaximumLinesKey, [NSNumber numberWithInteger:lines], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    if (lines == 1)
+        [[self cell] setWraps:NO];
+    [self setNeedsDisplay:YES];
+}
+
+@end
+
+// (macOS 10.10 accessibility) a description of an element's value: kept and answered, for views and cells
+#define SF_VALUE_DESCRIPTION(CLASS) \
+@implementation CLASS (SFAccessibilityValueDescription) \
+- (NSString *)accessibilityValueDescription { return objc_getAssociatedObject(self, &SFValueDescriptionKey); } \
+- (void)setAccessibilityValueDescription:(NSString *)description \
+{ objc_setAssociatedObject(self, &SFValueDescriptionKey, description, OBJC_ASSOCIATION_COPY_NONATOMIC); } \
+@end
+SF_VALUE_DESCRIPTION(NSView)
+SF_VALUE_DESCRIPTION(NSCell)
+
+@interface NSCursor (SFWindowResizeShapes)
++ (NSCursor *)_windowResizeCursorForEdges:(int)edges;
+@end
+
+@implementation NSCursor (SFDiagonalResize)
+
+// (private on macOS) the diagonal window-resize shapes
