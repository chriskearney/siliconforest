+@implementation NSOpenPanel (SFNewDocumentButton)
+
+// (private on macOS) the "New Document" button of the Open panel an iCloud application shows at launch; this
+// panel has no such button, so the setting is kept and changes nothing
+- (void)_setShowNewDocumentButton:(BOOL)flag
+{
+    objc_setAssociatedObject(self, &SFNewDocumentButtonKey, [NSNumber numberWithBool:flag], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+@end
