+static void pointerLockDestroyLocked(void) {
+    if (ws.lockedPointer != NULL) {
+        zwp_locked_pointer_v1_destroy(ws.lockedPointer);
+        ws.lockedPointer = NULL;
+    }
+    ws.lockedWindowID = 0;
+    ws.pointerLockActive = 0;
