+
+static struct wsWindow *pointerLockTargetWindow(void) {
+    int ids[4] = { ws.focusWindowID, ws.keyHolderID, ws.pointerWindowID, ws.activeAppWindowID };
+    for (int i = 0; i < 4; i++) {
+        if (ids[i] != 0) {
+            struct wsWindow *w = windowForID(ids[i]);
+            if (w != NULL && w->surface != NULL && w->popup == NULL)
+                return w;
+        }
+    }
+    for (struct wsWindow *w = ws.windows; w != NULL; w = w->next) {
+        if (w->surface != NULL && w->toplevel != NULL)
+            return w;
+    }
+    return NULL;
+}
+
+static void pointerLockAcquireForWindowLocked(struct wsWindow *w) {
+    if (!ws.mouseDisassociated || ws.pointerConstraints == NULL || ws.pointer == NULL || w == NULL || w->surface == NULL)
+        return;
+    if (ws.lockedPointer != NULL) {
+        if (ws.lockedWindowID == w->windowID)
+            return;
+        pointerLockDestroyLocked();
+    }
+    ws.lockedPointer = zwp_pointer_constraints_v1_lock_pointer(
+        ws.pointerConstraints, w->surface, ws.pointer, NULL,
+        ZWP_POINTER_CONSTRAINTS_V1_LIFETIME_PERSISTENT);
+    if (ws.lockedPointer == NULL)
+        return;
+    ws.lockedWindowID = w->windowID;
+    ws.pointerLockActive = 0;
+    zwp_locked_pointer_v1_add_listener(ws.lockedPointer, &lockedPointerListener, NULL);
+    wl_surface_commit(w->surface);
+    wl_display_flush(ws.display);
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: pointer lock requested on window %d\n", w->windowID);
+}
+
+static void lockedPointerLocked(void *data, struct zwp_locked_pointer_v1 *locked) {
+    (void)data;
+    pthread_mutex_lock(&ws.pointerLockMutex);
+    if (ws.lockedPointer == locked)
+        ws.pointerLockActive = 1;
+    pthread_mutex_unlock(&ws.pointerLockMutex);
+    /* Ensure [NSCursor hide] / unhide is honored as soon as the lock activates. */
+    pthread_mutex_lock(&cursor.lock);
+    cursorApplyLocked();
+    wl_display_flush(ws.display);
+    pthread_mutex_unlock(&cursor.lock);
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: pointer lock active on window %d\n", ws.lockedWindowID);
+}
+
+static void lockedPointerUnlocked(void *data, struct zwp_locked_pointer_v1 *locked) {
+    (void)data;
+    pthread_mutex_lock(&ws.pointerLockMutex);
+    if (ws.lockedPointer == locked)
+        ws.pointerLockActive = 0;
+    pthread_mutex_unlock(&ws.pointerLockMutex);
+    if (getenv("SF_WS_TRACE") != NULL)
+        fprintf(stderr, "WindowServer: pointer lock inactive\n");
+}
+
+static const struct zwp_locked_pointer_v1_listener lockedPointerListener = {
+    .locked = lockedPointerLocked,
+    .unlocked = lockedPointerUnlocked,
+};
