 + (instancetype)URLByResolvingBookmarkData:(NSData *)data options:(NSUInteger)options relativeToURL:(NSURL *)relativeURL bookmarkDataIsStale:(BOOL *)isStale error:(NSError **)error {
+    (void)options;
     if (isStale != NULL)
         *isStale = NO;
+    NSDictionary *record = sfBookmarkRecord(data);
+    if (record == nil) {
+        if (error != NULL)
+            *error = sfBookmarkError(NSFileReadCorruptFileError, nil);
+        return nil;
+    }
+    NSMutableArray *candidates = [NSMutableArray array];
+    NSString *relative = [record objectForKey:@"relativePath"];
+    if ([relativeURL isFileURL] && [relative isKindOfClass:[NSString class]])
+        [candidates addObject:[[relativeURL path] stringByAppendingPathComponent:relative]];
+    [candidates addObject:[record objectForKey:@"path"]];
+    for (NSString *path in candidates) {
+        struct stat st;
+        if (stat([path fileSystemRepresentation], &st) != 0)
+            continue;
+        if (isStale != NULL)
+            *isStale = (unsigned long long)st.st_ino != [[record objectForKey:@"inode"] unsignedLongLongValue] ||
+                       (long long)st.st_dev != [[record objectForKey:@"device"] longLongValue];
+        return [NSURL fileURLWithPath:path isDirectory:S_ISDIR(st.st_mode)];
+    }
     if (error != NULL)
