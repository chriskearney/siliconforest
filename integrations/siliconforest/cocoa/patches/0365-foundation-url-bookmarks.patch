 - (NSData *)bookmarkDataWithOptions:(NSUInteger)options includingResourceValuesForKeys:(NSArray *)keys relativeToURL:(NSURL *)relativeURL error:(NSError **)error {
-    if (error != NULL)
-        *error = [NSError errorWithDomain:NSCocoaErrorDomain code:3328 /* NSFeatureUnsupportedError */ userInfo:nil];
-    return nil;
+    (void)options;
+    if (![self isFileURL]) {
+        if (error != NULL)
+            *error = sfBookmarkError(NSFileReadUnsupportedSchemeError, self);
+        return nil;
+    }
+    NSString *path = [[self path] stringByStandardizingPath];
+    struct stat st;
+    if (path == nil || stat([path fileSystemRepresentation], &st) != 0) {
+        if (error != NULL)
+            *error = sfBookmarkError(NSFileReadNoSuchFileError, self);
+        return nil;
+    }
+    NSMutableDictionary *record = [NSMutableDictionary dictionary];
+    [record setObject:[NSNumber numberWithInt:1] forKey:@"version"];
+    [record setObject:path forKey:@"path"];
+    [record setObject:[NSNumber numberWithLongLong:(long long)st.st_dev] forKey:@"device"];
+    [record setObject:[NSNumber numberWithUnsignedLongLong:(unsigned long long)st.st_ino] forKey:@"inode"];
+    [record setObject:[NSNumber numberWithBool:S_ISDIR(st.st_mode)] forKey:@"directory"];
+    NSString *base = [relativeURL isFileURL] ? [[[relativeURL path] stringByStandardizingPath] stringByAppendingString:@"/"] : nil;
+    if (base != nil && [path hasPrefix:base] && [path length] > [base length])
+        [record setObject:[path substringFromIndex:[base length]] forKey:@"relativePath"];
+    if ([keys count] > 0) {
+        NSMutableDictionary *values = [NSMutableDictionary dictionary];
+        for (NSString *key in keys) {
+            id value = nil;
+            // (only what a property list holds; a value that is an object of another kind is left out)
+            if ([key isKindOfClass:[NSString class]] && [self getResourceValue:&value forKey:key error:NULL] && value != nil &&
+                ([value isKindOfClass:[NSString class]] || [value isKindOfClass:[NSNumber class]] ||
+                 [value isKindOfClass:[NSDate class]] || [value isKindOfClass:[NSData class]]))
+                [values setObject:value forKey:key];
+        }
+        [record setObject:values forKey:@"resourceValues"];
+    }
+    NSData *plist = [NSPropertyListSerialization dataWithPropertyList:record format:NSPropertyListBinaryFormat_v1_0 options:0 error:NULL];
+    if (plist == nil) {
+        if (error != NULL)
+            *error = sfBookmarkError(NSFileWriteUnknownError, self);
+        return nil;
+    }
+    NSMutableData *data = [NSMutableData dataWithBytes:"SFBK" length:4];
+    [data appendData:plist];
+    return data;
 }
