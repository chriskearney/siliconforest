-// Bookmarks (file references that survive a move) need a file-ID service this system does not
-// have: none can be made, none can be resolved.
+/* (0365) Bookmarks: data an application keeps to find a file again later (recent documents, a chosen folder).
+ * As on macOS the data is opaque to the application; ours is "SFBK" and a binary property list with the file's path
+ * (and its path relative to a given URL), its device and inode, and the resource values asked for. Resolving finds
+ * the file by its path (relative to the given URL first); if what is there now is another file (another inode), the
+ * URL is returned and the bookmark reported stale, as macOS does when the data should be made again. A file that
+ * is no longer at its path is not found: this system has no lookup of a file by its ID (macOS follows a move within
+ * the volume), so that resolution fails with NSFileNoSuchFileError. The sandbox options (security scope) are accepted
+ * and change nothing: nothing here is sandboxed. */
+static NSString *const sfBookmarkMagic = @"SFBK";
+
+static NSError *sfBookmarkError(NSInteger code, NSURL *url) {
+    NSDictionary *info = url ? [NSDictionary dictionaryWithObject:url forKey:NSURLErrorKey] : nil;
+    return [NSError errorWithDomain:NSCocoaErrorDomain code:code userInfo:info];
+}
+
+static NSDictionary *sfBookmarkRecord(NSData *data) {
+    if (![data isKindOfClass:[NSData class]] || [data length] < 5 || memcmp([data bytes], "SFBK", 4) != 0)
+        return nil;
+    NSData *plist = [data subdataWithRange:NSMakeRange(4, [data length] - 4)];
+    id record = [NSPropertyListSerialization propertyListWithData:plist options:NSPropertyListImmutable format:NULL error:NULL];
+    return ([record isKindOfClass:[NSDictionary class]] && [[record objectForKey:@"path"] isKindOfClass:[NSString class]]) ? record : nil;
+}
