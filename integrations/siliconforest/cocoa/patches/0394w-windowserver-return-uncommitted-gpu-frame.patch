 // the commit of a presented frame, with the callback that paces the next one (called with ws.pixelsLock held)
+/* (0394w) 0388 takes a frame (gpuStaged) and commits it from the frame callback. When that
+ * callback is later than 100 ms the present path clears gpuStaged and takes another frame.
+ * The first frame stays busy, and the compositor never received it, so wl_buffer.release
+ * never comes. Hand that frame back. A frame already given to the compositor stays busy. */
+static void windowReleaseStaged(struct wsWindow *window) {
+    struct wsFrame *frame = window->front;
+    int staged = window->gpuStaged;
+    window->gpuStaged = 0;
+    if (!staged || frame == NULL || frame->given || frame == window->gpuCommitted || !frame->busy)
+        return;
+    pthread_mutex_lock(&ws.queueLock);
+    if (frame->busy && !frame->given && frame != window->gpuCommitted) {
+        frame->busy = 0;
+        pthread_cond_broadcast(&ws.queueReady);
+    }
+    pthread_mutex_unlock(&ws.queueLock);
+    fprintf(stderr, "SFWS RELEASE-STAGED buffer=%u\n",
+            frame->buffer != NULL ? wl_proxy_get_id((struct wl_proxy *)frame->buffer) : 0u);
+}
