+- (void)loadNib
+{
+   if(infoPanel != nil)
+      return;
+   if(![NSBundle loadNibNamed:@"NSSystemInfoPanel" owner:self] || infoPanel == nil){
+      NSLog(@"Cannot load NSSystemInfoPanel.nib");
+      return;
+   }
+   // the owner keeps the panel; closing it only orders it out (-unloadNib: lets it go)
+   [infoPanel setReleasedWhenClosed:NO];
+   copyrightView = legalTextField;
+}
+
+- (void)unloadNib:(BOOL)flag
+{
+   (void)flag;
+   if(infoPanel == nil)
+      return;
+   [infoPanel setDelegate:nil];
+   // (asked from -windowWillClose: as the window closes: it goes once that is done)
+   [infoPanel autorelease];
+   infoPanel = nil;
+   appIconView = nil; appNameField = nil; creditScrollView = nil; creditView = nil; legalTextField = nil; versionField = nil;
+   copyrightView = nil;
+}
+
+- (void)windowWillClose:(NSNotification *)note
+{
+   (void)note;
+}
