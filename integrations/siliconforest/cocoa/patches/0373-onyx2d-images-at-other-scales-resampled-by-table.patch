+/* opaque: the alpha byte is skipped (set opaque); over: a premultiplied image in the normal blend mode, blended
+   over what the surface has; neither: a premultiplied image in the copy mode, its pixels as they are */
+static BOOL sfDrawImageScaled(const uint8_t *src,size_t srcRow,long width,long height,BOOL opaque,BOOL over,uint8_t *dst,size_t dstRow,
+                              long x0,long x1,long y0,long y1,O2AffineTransform inverse){
+   long      count=x1-x0;
+   long     *c0=malloc((size_t)count*sizeof(long)),*c1=malloc((size_t)count*sizeof(long));
+   uint16_t *cf=malloc((size_t)count*sizeof(uint16_t));
+   uint32_t *ha=malloc((size_t)count*4),*hb=malloc((size_t)count*4);
+   uint32_t  opaqueBits=opaque ? 0xFF000000u : 0;
+   long      ra=-1,rb=-1;   // the source rows ha and hb hold, resampled across
+
+   if(c0==NULL || c1==NULL || cf==NULL || ha==NULL || hb==NULL){
+    free(c0); free(c1); free(cf); free(ha); free(hb);
+    return NO;
+   }
+   for(long i=0;i<count;i++){
+    double   sx=inverse.a*(x0+i+0.5)+inverse.tx-0.5;
+    long     a=(long)floor(sx),b=a+1;
+    unsigned f=(unsigned)((sx-a)*256+0.5);
+
+    if(f>=256){ a=b; f=0; }
+    c0[i]=MAX(0,MIN(width-1,a));
+    c1[i]=MAX(0,MIN(width-1,b));
+    cf[i]=(uint16_t)f;
+   }
+   for(long y=y0;y<y1;y++){
+    double    sy=inverse.d*(y+0.5)+inverse.ty-0.5;
+    long      r0=(long)floor(sy),r1=r0+1;
+    uint32_t  fy=(uint32_t)((sy-r0)*256+0.5);
+    uint32_t *out=(uint32_t *)(dst+(size_t)y*dstRow)+x0;
+
+    if(fy>=256){ r0=r1; fy=0; }
+    r0=MAX(0,MIN(height-1,r0));
+    r1=MAX(0,MIN(height-1,r1));
+    for(int k=0;k<2;k++){
+     long r=k ? r1 : r0,other=k ? r0 : r1;
+
+     if(r==ra || r==rb)
+      continue;
+
+     uint32_t       *buf;
+     const uint32_t *line=(const uint32_t *)(src+(size_t)r*srcRow);
+
+     if(ra==other){ buf=hb; rb=r; } else { buf=ha; ra=r; }
+     for(long i=0;i<count;i++)
+      buf[i]=sfLerp8888(line[c0[i]],line[c1[i]],cf[i]);
+    }
+
+    const uint32_t *p0=(r0==ra) ? ha : hb,*p1=(r1==ra) ? ha : hb;
+
+    if(over){
+     if(fy==0)
+      for(long i=0;i<count;i++)
+       out[i]=sfOver8888(p0[i],out[i]);
+     else
+      for(long i=0;i<count;i++)
+       out[i]=sfOver8888(sfLerp8888(p0[i],p1[i],fy),out[i]);
+    }
+    else if(fy==0)
+     for(long i=0;i<count;i++)
+      out[i]=p0[i]|opaqueBits;
+    else
+     for(long i=0;i<count;i++)
+      out[i]=sfLerp8888(p0[i],p1[i],fy)|opaqueBits;
+   }
+   free(c0); free(c1); free(cf); free(ha); free(hb);
+   return YES;
+}
