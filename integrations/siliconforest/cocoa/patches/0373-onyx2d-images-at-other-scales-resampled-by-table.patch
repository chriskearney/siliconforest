+/* a and b blended, f/256 of b: red and blue, alpha and green, each pair as two 16-bit lanes */
+static inline uint32_t sfLerp8888(uint32_t a,uint32_t b,uint32_t f){
+   uint32_t g=256-f;
+   uint32_t rb=(((a&0x00FF00FFu)*g+(b&0x00FF00FFu)*f)>>8)&0x00FF00FFu;
+   uint32_t ag=(((a>>8)&0x00FF00FFu)*g+((b>>8)&0x00FF00FFu)*f)&0xFF00FF00u;
+
+   return rb|ag;
+}
+
+/* s, premultiplied, over d (the normal blend mode): s + d*(1-alpha of s); a lane that rounding takes past 255 stays at 255 */
+static inline uint32_t sfOver8888(uint32_t s,uint32_t d){
+   uint32_t a=s>>24;
+
+   if(a==255)
+    return s;
+   if(a==0 && s==0)
+    return d;
+
+   uint32_t k=256-(a+(a>>7));
+   uint32_t rb=(s&0x00FF00FFu)+((((d&0x00FF00FFu)*k)>>8)&0x00FF00FFu);
+   uint32_t ag=((s>>8)&0x00FF00FFu)+(((((d>>8)&0x00FF00FFu)*k)>>8)&0x00FF00FFu);
+   uint32_t m;
+
+   m=rb&0x01000100u; rb=(rb|(m-(m>>8)))&0x00FF00FFu;
+   m=ag&0x01000100u; ag=(ag|(m-(m>>8)))&0x00FF00FFu;
+   return rb|(ag<<8);
+}
