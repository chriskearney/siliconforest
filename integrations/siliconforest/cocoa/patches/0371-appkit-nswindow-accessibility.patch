+// NSWindow+Accessibility.h — AX role and focused-element for NSWindow
+// Copyright (c) 2026 The SiliconForest Project, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+
+#import <AppKit/NSWindow.h>
+
+@interface NSWindow (SFAccessibility)
+
+// AXRole for windows (always AXWindow).
+- (NSString *)accessibilityRole;
+
+// Window title as AX label.
+- (NSString *)accessibilityLabel;
+
+// The deepest focused view in this window's content tree.
+- (id)accessibilityFocusedUIElement;
+
+// AX children: the content view.
+- (NSArray *)accessibilityChildren;
+
+// Called by AppKit when first responder changes — posts AX focus notification.
+- (void)sfAccessibilityFirstResponderChanged:(id)newResponder;
+
+@end
--- /dev/null
