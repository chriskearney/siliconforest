@@ -0,0 +1,66 @@
+// NSWindow+Accessibility.m — AX role and focused-element for NSWindow
+// Copyright (c) 2026 The SiliconForest Project, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+
+#import <AppKit/NSWindow+Accessibility.h>
+#import <AppKit/NSView+Accessibility.h>
+#import <AppKit/NSView.h>
+#import <Foundation/Foundation.h>
+#import "SFAccessibilityServer.h"
+
+@implementation NSWindow (SFAccessibility)
+
+- (NSString *)accessibilityRole {
+    return @"AXWindow";
+}
+
+- (NSString *)accessibilityLabel {
+    return [self title];
+}
+
+- (id)accessibilityFocusedUIElement {
+    id responder = [self firstResponder];
+    if ([responder isKindOfClass:[NSView class]])
+        return responder;
+    return [self contentView];
+}
+
+- (NSArray *)accessibilityChildren {
+    NSView *content = [self contentView];
+    if (content != nil)
+        return [NSArray arrayWithObject:content];
+    return [NSArray array];
+}
+
+- (void)sfAccessibilityFirstResponderChanged:(id)newResponder {
+    if (![newResponder isKindOfClass:[NSView class]])
+        return;
+    NSView *view = (NSView *)newResponder;
+    NSString *role   = [view accessibilityRole]  ?: @"AXUnknown";
+    NSString *label  = [view accessibilityLabel] ?: @"";
+    id        value  = [view accessibilityValue];
+    NSString *valStr = (value != nil) ? [NSString stringWithFormat:@"%@", value] : @"";
+    NSString *windowTitle = [self title] ?: @"";
+
+    // Post: window context + focused element
+    [[SFAccessibilityServer sharedServer]
+        postFocusChangedWithRole:role
+                           label:label
+                           value:valStr
+                             pid:[[NSProcessInfo processInfo] processIdentifier]
+                           frame:[view frame]];
+    // Also post window-activation if this is a new frontmost window
+    [[SFAccessibilityServer sharedServer]
+        postWindowActivatedWithTitle:windowTitle
+                                pid:[[NSProcessInfo processInfo] processIdentifier]];
+}
+
+@end
