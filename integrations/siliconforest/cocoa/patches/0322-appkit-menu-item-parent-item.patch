+// (VLC) the item whose submenu this item's menu is (macOS 10.6): VLC's menu validation asks every item for it, and
+// the missing method ended the opening of each of its menus in an exception
+-(NSMenuItem *)parentItem {
+   NSMenu *supermenu=[_menu supermenu];
+
+   for(NSMenuItem *item in [supermenu itemArray])
+    if([item submenu]==_menu)
+     return item;
+   return nil;
+}
