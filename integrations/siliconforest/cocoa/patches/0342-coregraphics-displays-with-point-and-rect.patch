     return currentBounds();
 }
 
+// (QTP) the displays a point or a rectangle falls on, from the active list and each display's bounds, as
+// CoreGraphics documents them: with displays NULL the count is of all that match, else at most maxDisplays
+// are written and counted
+static CGError displaysMatching(bool (*match)(CGRect bounds, const void *what), const void *what,
+                                uint32_t maxDisplays, CGDirectDisplayID *displays, uint32_t *matchingDisplayCount) {
+    CGDirectDisplayID active[16];
+    uint32_t count = 0, found = 0;
+
+    if (matchingDisplayCount == NULL)
+        return kCGErrorIllegalArgument;
+    CGError error = CGGetActiveDisplayList(16, active, &count);
+    if (error != kCGErrorSuccess)
+        return error;
+    for (uint32_t i = 0; i < count && i < 16; i++) {
+        if (!match(CGDisplayBounds(active[i]), what))
+            continue;
+        if (displays != NULL) {
+            if (found >= maxDisplays)
+                break;
+            displays[found] = active[i];
+        }
+        found++;
+    }
+    *matchingDisplayCount = found;
+    return kCGErrorSuccess;
+}
+
+static bool boundsContainPoint(CGRect bounds, const void *what) {
+    return CGRectContainsPoint(bounds, *(const CGPoint *)what);
+}
+
+static bool boundsMeetRect(CGRect bounds, const void *what) {
+    return CGRectIntersectsRect(bounds, *(const CGRect *)what);
+}
+
+CGError CGGetDisplaysWithPoint(CGPoint point, uint32_t maxDisplays, CGDirectDisplayID *displays,
+                               uint32_t *matchingDisplayCount) {
+    return displaysMatching(boundsContainPoint, &point, maxDisplays, displays, matchingDisplayCount);
+}
+
+CGError CGGetDisplaysWithRect(CGRect rect, uint32_t maxDisplays, CGDirectDisplayID *displays,
+                              uint32_t *matchingDisplayCount) {
+    return displaysMatching(boundsMeetRect, &rect, maxDisplays, displays, matchingDisplayCount);
+}
+
 size_t CGDisplayPixelsWide(CGDirectDisplayID display) {
     return (size_t)currentBounds().size.width;
 }
