+/* (VLC) Linked animations: the receiver starts (or stops) when another animation's progress reaches a value. VLC chains
+ * the two halves of its fullscreen transition so; the methods raised "not implemented" and VLC ended at its fullscreen
+ * button. The links are kept as associated objects: the animation that triggers has the list of links, each receiver
+ * the animation it waits for (one start and one stop link each, as on macOS, where a new one replaces the old). */
+static char SFAnimationLinksKey, SFAnimationStartTriggerKey, SFAnimationStopTriggerKey;
+
+static void sfAnimationUnlink(NSAnimation *receiver, BOOL start) {
+   char *key=start ? &SFAnimationStartTriggerKey : &SFAnimationStopTriggerKey;
+   NSAnimation *trigger=objc_getAssociatedObject(receiver,key);
+   NSMutableArray *links=trigger ? objc_getAssociatedObject(trigger,&SFAnimationLinksKey) : nil;
+
+   for(NSInteger i=(NSInteger)[links count]-1;i>=0;i--){
+    NSDictionary *link=[links objectAtIndex:i];
+    if([link objectForKey:@"animation"]==receiver && [[link objectForKey:@"start"] boolValue]==start)
+     [links removeObjectAtIndex:i];
+   }
+   objc_setAssociatedObject(receiver,key,nil,OBJC_ASSOCIATION_ASSIGN);
+}
+
+static void sfAnimationLink(NSAnimation *receiver, NSAnimation *trigger, NSAnimationProgress progress, BOOL start) {
+   NSMutableArray *links;
+
+   sfAnimationUnlink(receiver,start);
+   if(trigger==nil)
+    return;
+   links=objc_getAssociatedObject(trigger,&SFAnimationLinksKey);
+   if(links==nil){
+    links=[NSMutableArray array];
+    objc_setAssociatedObject(trigger,&SFAnimationLinksKey,links,OBJC_ASSOCIATION_RETAIN);
+   }
+   [links addObject:[NSDictionary dictionaryWithObjectsAndKeys:receiver,@"animation",[NSNumber numberWithFloat:progress],@"progress",
+       [NSNumber numberWithBool:start],@"start",nil]];
+   objc_setAssociatedObject(receiver,start ? &SFAnimationStartTriggerKey : &SFAnimationStopTriggerKey,trigger,OBJC_ASSOCIATION_ASSIGN);
+}
+
+// the links of this animation whose progress has been reached: their animations start or stop, each once
+static void sfAnimationFireLinks(NSAnimation *trigger, NSAnimationProgress progress) {
+   NSMutableArray *links=objc_getAssociatedObject(trigger,&SFAnimationLinksKey);
+   NSMutableArray *due=[NSMutableArray array];
+
+   for(NSInteger i=(NSInteger)[links count]-1;i>=0;i--){
+    NSDictionary *link=[links objectAtIndex:i];
+    if([[link objectForKey:@"progress"] floatValue]<=progress){
+     [due insertObject:link atIndex:0];
+     [links removeObjectAtIndex:i];
+    }
+   }
+   for(NSDictionary *link in due){
+    NSAnimation *animation=[link objectForKey:@"animation"];
+    BOOL start=[[link objectForKey:@"start"] boolValue];
+
+    objc_setAssociatedObject(animation,start ? &SFAnimationStartTriggerKey : &SFAnimationStopTriggerKey,nil,OBJC_ASSOCIATION_ASSIGN);
+    if(start)
+     [animation startAnimation];
+    else
+     [animation stopAnimation];
+   }
+}
+
 -(void)startWhenAnimation:(NSAnimation *)animation reachesProgress:(NSAnimationProgress)progress {
-   NSUnimplementedMethod();
+   sfAnimationLink(self,animation,progress,YES);
 }
 
 -(void)stopWhenAnimation:(NSAnimation *)animation reachesProgress:(NSAnimationProgress)progress {
-   NSUnimplementedMethod();
+   sfAnimationLink(self,animation,progress,NO);
 }
 
