+// (VLC) the current value follows the progress through the animation's curve, or the delegate's
+// -animation:valueForProgress:, as on macOS; it stayed 0, and VLC, which ends its fullscreen transitions when the value
+// reaches 1, never left its fullscreen window (the main window stayed empty)
 -(void)setCurrentProgress:(NSAnimationProgress)progress {
+   float t=MAX(0.0,MIN(1.0,progress));
+
    _currentProgress=progress;
+   if([_delegate respondsToSelector:@selector(animation:valueForProgress:)])
+    _currentValue=((float (*)(id,SEL,id,NSAnimationProgress))objc_msgSend)(_delegate,@selector(animation:valueForProgress:),self,progress);
+   else switch(_curve){
+    case NSAnimationEaseInOut: _currentValue=t*t*(3-2*t); break;
+    case NSAnimationEaseIn:    _currentValue=t*t; break;
+    case NSAnimationEaseOut:   _currentValue=t*(2-t); break;
+    default:                   _currentValue=t; break;
+   }
 }
 
