+/* (QTP) Document types named by uniform type identifier, as on macOS since 10.5: an entry of
+ * CFBundleDocumentTypes that lists LSItemContentTypes and no CFBundleTypeName is named by its first
+ * identifier, and a file's type is the declared type its identifier is or conforms to (CoreServices'
+ * table, the application's own declarations first through NSWorkspace). Apple's QuickTime Player
+ * declares its types this way only; extensions alone found none of them. */
+static NSString *sfTypeName(NSDictionary *info) {
+   NSString *name=[info objectForKey:@"CFBundleTypeName"];
+   NSArray  *types=[info objectForKey:@"LSItemContentTypes"];
+
+   if([name isKindOfClass:[NSString class]] && [name length]>0)
+    return name;
+   if([types isKindOfClass:[NSArray class]] && [types count]>0 && [[types objectAtIndex:0] isKindOfClass:[NSString class]])
+    return [types objectAtIndex:0];
+   return nil;
+}
+
+static NSArray *sfContentTypes(NSDictionary *info) {
+   NSArray *types=[info objectForKey:@"LSItemContentTypes"];
+
+   return [types isKindOfClass:[NSArray class]]?types:nil;
+}
+
+static BOOL sfConforms(NSString *type,NSString *to) {
+   if(type==nil || to==nil)
+    return NO;
+   if([type caseInsensitiveCompare:to]==NSOrderedSame)
+    return YES;
+   return UTTypeConformsTo((CFStringRef)type,(CFStringRef)to)?YES:NO;
+}
+
+// the uniform type identifier of a file from its extension: the application's own declarations, then the system's table
+static NSString *sfTypeOfPath(NSString *path) {
+   NSString *extension=[path pathExtension];
+   NSString *type=[[NSWorkspace sharedWorkspace] typeOfFile:path error:NULL];
+
+   if(type!=nil && [type rangeOfString:@"."].location!=NSNotFound)
+    return type;
+   if([extension length]>0){
+    CFStringRef identifier=UTTypeCreatePreferredIdentifierForTag(kUTTagClassFilenameExtension,(CFStringRef)extension,NULL);
+
+    if(identifier!=NULL)
+     return [(NSString *)identifier autorelease];
+   }
+   return nil;
+}
 
