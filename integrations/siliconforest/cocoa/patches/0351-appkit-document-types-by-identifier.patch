+// (QTP) where autosaved untitled documents are kept, as on macOS: ~/Library/Autosave Information, made when asked
+// (private on macOS; Apple's QuickTime Player asks for it to tell a file of its own from a document it opens)
+-(NSURL *)_autosaveDirectoryURLCreateIfNecessary:(BOOL)create {
+   NSString *path=[[NSHomeDirectory() stringByAppendingPathComponent:@"Library"] stringByAppendingPathComponent:@"Autosave Information"];
+   BOOL      isDirectory=NO;
+
+   if(![[NSFileManager defaultManager] fileExistsAtPath:path isDirectory:&isDirectory] || !isDirectory){
+    if(!create || ![[NSFileManager defaultManager] createDirectoryAtPath:path withIntermediateDirectories:YES attributes:nil error:NULL])
+     return create?nil:[NSURL fileURLWithPath:path isDirectory:YES];
+   }
+   return [NSURL fileURLWithPath:path isDirectory:YES];
+}
+
+// (QTP) the block form macOS 10.7 added: opens at once, then calls the handler
+-(void)openDocumentWithContentsOfURL:(NSURL *)url display:(BOOL)display completionHandler:(void (^)(NSDocument *document,BOOL documentWasAlreadyOpen,NSError *error))completionHandler {
+   NSError    *error=nil;
+   NSDocument *already=[self documentForURL:url];
+   NSDocument *document=[self openDocumentWithContentsOfURL:url display:display error:&error];
+
+   if(completionHandler!=nil)
+    completionHandler(document,already!=nil,document==nil?error:nil);
+   else if(document==nil && error!=nil)
+    [self presentError:error];
+}
