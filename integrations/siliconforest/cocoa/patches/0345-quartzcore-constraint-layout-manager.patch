+// CAConstraintLayoutManager.h - sublayers placed by constraints on their geometry. SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Chris Kearney and the SiliconForest contributors
+#import <QuartzCore/CALayer.h>
+
+typedef NS_ENUM(int, CAConstraintAttribute) {
+    kCAConstraintMinX,
+    kCAConstraintMidX,
+    kCAConstraintMaxX,
+    kCAConstraintWidth,
+    kCAConstraintMinY,
+    kCAConstraintMidY,
+    kCAConstraintMaxY,
+    kCAConstraintHeight,
+};
+
+// attribute = sourceAttribute of the layer named sourceName (a sibling, or "superlayer") * scale + offset
+@interface CAConstraint : NSObject <NSCoding> {
+    CAConstraintAttribute _attribute, _sourceAttribute;
+    NSString *_sourceName;
+    CGFloat _scale, _offset;
+}
++ (instancetype)constraintWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
+                              attribute:(CAConstraintAttribute)sourceAttribute scale:(CGFloat)scale offset:(CGFloat)offset;
++ (instancetype)constraintWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
