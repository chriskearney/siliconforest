diff --git a/src/Frameworks/QuartzCore/CAConstraintLayoutManager.m b/src/Frameworks/QuartzCore/CAConstraintLayoutManager.m
new file mode 100644
index 0000000..a9d6135
--- /dev/null
+++ b/src/Frameworks/QuartzCore/CAConstraintLayoutManager.m
@@ -0,0 +1,176 @@
+// CAConstraintLayoutManager.m - see the header. SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Chris Kearney and the SiliconForest contributors
+//
+// Written from the public CAConstraint and CAConstraintLayoutManager documentation. Each sublayer's constraints
+// are applied against its superlayer's bounds ("superlayer") or a sibling's frame (by name). On each axis two
+// constrained attributes of min, mid, max and size fix the extent; one moves the layer and keeps its size. Layers
+// are placed in passes until nothing moves (a constraint on a sibling placed later is met in the next pass), at
+// most one pass per sublayer and one more. A source name that matches nothing is ignored, as on macOS.
+#import <QuartzCore/CAConstraintLayoutManager.h>
+#import <Foundation/Foundation.h>
+#import <objc/runtime.h>
+#include <math.h>
+
+@implementation CAConstraint
+
++ (instancetype)constraintWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
+                              attribute:(CAConstraintAttribute)sourceAttribute scale:(CGFloat)scale offset:(CGFloat)offset {
+   return [[[self alloc] initWithAttribute:attribute relativeTo:sourceName attribute:sourceAttribute scale:scale offset:offset] autorelease];
+}
+
++ (instancetype)constraintWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
+                              attribute:(CAConstraintAttribute)sourceAttribute offset:(CGFloat)offset {
+   return [self constraintWithAttribute:attribute relativeTo:sourceName attribute:sourceAttribute scale:1 offset:offset];
+}
+
++ (instancetype)constraintWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
+                              attribute:(CAConstraintAttribute)sourceAttribute {
+   return [self constraintWithAttribute:attribute relativeTo:sourceName attribute:sourceAttribute scale:1 offset:0];
+}
+
+- (instancetype)initWithAttribute:(CAConstraintAttribute)attribute relativeTo:(NSString *)sourceName
+                        attribute:(CAConstraintAttribute)sourceAttribute scale:(CGFloat)scale offset:(CGFloat)offset {
+   if((self=[super init])==nil)
+    return nil;
+   _attribute=attribute;
+   _sourceName=[sourceName copy];
+   _sourceAttribute=sourceAttribute;
+   _scale=scale;
+   _offset=offset;
+   return self;
+}
+
+- (instancetype)initWithCoder:(NSCoder *)coder {
+   return [self initWithAttribute:[coder decodeIntForKey:@"CAConstraintAttribute"] relativeTo:[coder decodeObjectForKey:@"CAConstraintSourceName"]
+                        attribute:[coder decodeIntForKey:@"CAConstraintSourceAttribute"] scale:[coder decodeDoubleForKey:@"CAConstraintScale"]
+                           offset:[coder decodeDoubleForKey:@"CAConstraintOffset"]];
+}
+
+- (void)encodeWithCoder:(NSCoder *)coder {
+   [coder encodeInt:_attribute forKey:@"CAConstraintAttribute"];
+   [coder encodeObject:_sourceName forKey:@"CAConstraintSourceName"];
+   [coder encodeInt:_sourceAttribute forKey:@"CAConstraintSourceAttribute"];
+   [coder encodeDouble:_scale forKey:@"CAConstraintScale"];
+   [coder encodeDouble:_offset forKey:@"CAConstraintOffset"];
+}
+
+- (void)dealloc {
+   [_sourceName release];
+   [super dealloc];
+}
+
+- (CAConstraintAttribute)attribute { return _attribute; }
+- (NSString *)sourceName { return _sourceName; }
+- (CAConstraintAttribute)sourceAttribute { return _sourceAttribute; }
+- (CGFloat)scale { return _scale; }
+- (CGFloat)offset { return _offset; }
+
+@end
+
+static CGFloat attributeOfRect(CGRect r,CAConstraintAttribute attribute){
+   switch(attribute){
+    case kCAConstraintMinX: return CGRectGetMinX(r);
+    case kCAConstraintMidX: return CGRectGetMidX(r);
+    case kCAConstraintMaxX: return CGRectGetMaxX(r);
+    case kCAConstraintWidth: return r.size.width;
+    case kCAConstraintMinY: return CGRectGetMinY(r);
+    case kCAConstraintMidY: return CGRectGetMidY(r);
+    case kCAConstraintMaxY: return CGRectGetMaxY(r);
+    default: return r.size.height;
+   }
+}
+
+// one axis: has/value index 0 min, 1 mid, 2 max, 3 size
+static void solveAxis(const BOOL has[4],const CGFloat value[4],CGFloat *origin,CGFloat *size){
+   if(has[3])
+    *size=value[3];
+   if(has[0] && has[2]){ *origin=value[0]; *size=value[2]-value[0]; }
+   else if(has[0] && has[1]){ *origin=value[0]; *size=2*(value[1]-value[0]); }
+   else if(has[1] && has[2]){ *size=2*(value[2]-value[1]); *origin=value[2]-*size; }
+   else if(has[0]) *origin=value[0];
+   else if(has[1]) *origin=value[1]-*size/2;
+   else if(has[2]) *origin=value[2]-*size;
+}
+
+@implementation CAConstraintLayoutManager
+
++ (instancetype)layoutManager {
+   return [[[self alloc] init] autorelease];
+}
+
+static BOOL placeSublayer(CALayer *layer,CALayer *sublayer,NSArray *siblings){
+   NSArray *constraints=[sublayer constraints];
+   if([constraints count]==0)
+    return NO;
+   BOOL    hasX[4]={NO,NO,NO,NO},hasY[4]={NO,NO,NO,NO};
+   CGFloat x[4]={0,0,0,0},y[4]={0,0,0,0};
+   for(CAConstraint *constraint in constraints){
+    NSString *name=[constraint sourceName];
+    CGRect    source;
+    BOOL      found=NO;
+    if([name isEqualToString:@"superlayer"]){
+     source=[layer bounds];
+     found=YES;
+    }
+    else for(CALayer *sibling in siblings)
+     if(sibling!=sublayer && [[sibling name] isEqualToString:name]){
+      source=[sibling frame];
+      found=YES;
+      break;
+     }
+    if(!found)
+     continue;
+    CGFloat value=attributeOfRect(source,[constraint sourceAttribute])*[constraint scale]+[constraint offset];
+    int     attribute=[constraint attribute];
+    if(attribute>=kCAConstraintMinX && attribute<=kCAConstraintWidth){ hasX[attribute]=YES; x[attribute]=value; }
+    else if(attribute>=kCAConstraintMinY && attribute<=kCAConstraintHeight){ hasY[attribute-4]=YES; y[attribute-4]=value; }
+   }
+   CGRect old=[sublayer frame],frame=old;
+   solveAxis(hasX,x,&frame.origin.x,&frame.size.width);
+   solveAxis(hasY,y,&frame.origin.y,&frame.size.height);
+   if(CGRectEqualToRect(frame,old))
+    return NO;
+   [sublayer setFrame:frame];
+   return YES;
+}
+
+- (void)layoutSublayersOfLayer:(CALayer *)layer {
+   NSArray *sublayers=[layer sublayers];
+   for(NSUInteger pass=0;pass<=[sublayers count];pass++){
+    BOOL moved=NO;
+    for(CALayer *sublayer in sublayers)
+     moved|=placeSublayer(layer,sublayer,sublayers);
+    if(!moved)
+     break;
+   }
+}
+
+- (CGSize)preferredSizeOfLayer:(CALayer *)layer {
+   return [layer bounds].size;
+}
+
+- (void)invalidateLayoutOfLayer:(CALayer *)layer {
+   [layer setNeedsLayout];
+}
+
+@end
+
+static const char sfcaConstraintsKey=0;
+
+@implementation CALayer (CAConstraintLayoutManager)
+
+- (NSArray *)constraints {
+   return objc_getAssociatedObject(self,&sfcaConstraintsKey);
+}
+
+- (void)setConstraints:(NSArray *)constraints {
+   objc_setAssociatedObject(self,&sfcaConstraintsKey,[[constraints copy] autorelease],OBJC_ASSOCIATION_RETAIN);
+   [[self superlayer] _sfcaLayoutForChangedSublayers];
+}
+
+- (void)addConstraint:(CAConstraint *)constraint {
+   NSArray *constraints=[self constraints];
+   [self setConstraints:constraints ? [constraints arrayByAddingObject:constraint] : [NSArray arrayWithObject:constraint]];
+}
+
+@end
