-// what macOS's does without a layout manager: the delegate's layout, if it has one
+// what macOS's does: the delegate's layout, if it has one, else (QTP) the layout manager's
 -(void)layoutSublayers {
-   if([_delegate respondsToSelector:@selector(layoutSublayersOfLayer:)])
+   if([_delegate respondsToSelector:@selector(layoutSublayersOfLayer:)]){
     [_delegate layoutSublayersOfLayer:self];
+    return;
+   }
+   if(sfcaLayoutManagersInUse){
+    id manager=[self layoutManager];
