+
+// (QTP) the layout manager, kept beside the layer (no instance variable: the layout of the class is unchanged for
+// subclasses built against the earlier header); a flag spares the lookup until some layer has had one
+static const char sfcaLayoutManagerKey=0;
+
+-(id<CALayoutManager>)layoutManager {
+   return sfcaLayoutManagersInUse ? objc_getAssociatedObject(self,&sfcaLayoutManagerKey) : nil;
+}
+
+-(void)setLayoutManager:(id<CALayoutManager>)manager {
+   if(manager!=nil)
+    sfcaLayoutManagersInUse=YES;
+   objc_setAssociatedObject(self,&sfcaLayoutManagerKey,manager,OBJC_ASSOCIATION_RETAIN);
+   [self setNeedsLayout];
+   [self layoutIfNeeded];
+}
+
+-(CGSize)preferredFrameSize {
+   id manager=[self layoutManager];
+   if([manager respondsToSelector:@selector(preferredSizeOfLayer:)])
+    return [manager preferredSizeOfLayer:self];
+   return _bounds.size;
+}
+
+// sublayers or their constraints changed: laid out again at once, as this tree lays out on a resize (macOS does it
+// at the commit)
+-(void)_sfcaLayoutForChangedSublayers {
+   if(!sfcaLayoutManagersInUse || [self layoutManager]==nil)
+    return;
+   [self setNeedsLayout];
+   [self layoutIfNeeded];
 }
 
