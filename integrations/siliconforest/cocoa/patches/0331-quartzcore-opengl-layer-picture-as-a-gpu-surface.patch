+/* (IOSURF) The picture as an IOSurface with GPU storage: the layer context's renderer binds such contents without a
+ * copy (CGLPDBindSurfaceTexture), and with SFFX_GPU_PRESENT the window server hands its frame to the desktop the same
+ * way. Reading 2436x1370 pixels back, flipping them, making an image and converting it again into the renderer's
+ * texture cost VLC's 1080p picture ~40 ms a frame on the render thread: the window showed ~24 of 30 pictures a
+ * second. Everything is found at run time; without GPU storage (no SFFX_IOSURFACE_GPU) the layer reads back as before. */
+static struct {
+    CFTypeRef (*create)(CFDictionaryRef);
+    size_t (*gpuOffset)(CFTypeRef), (*width)(CFTypeRef), (*height)(CFTypeRef);
+    int (*copy)(CFTypeRef, int);
+} sfFrameAPI;
+
+static void sfLoadFrameAPI(void) {
+    void *lib = dlopen("/System/Library/Frameworks/IOSurface.framework/IOSurface", RTLD_LAZY | RTLD_GLOBAL);
+
+    if (lib != NULL) {
+        sfFrameAPI.create = dlsym(lib, "IOSurfaceCreate");
+        sfFrameAPI.gpuOffset = dlsym(lib, "IOSurfaceSFGPUGetOffset");
+        sfFrameAPI.width = dlsym(lib, "IOSurfaceGetWidth");
+        sfFrameAPI.height = dlsym(lib, "IOSurfaceGetHeight");
+    }
+    // CGL's GPU copy of the current context's framebuffer into a surface of its size (cgl-patches/0003)
+    sfFrameAPI.copy = dlsym(RTLD_DEFAULT, "CGLSFFXCopyFramebuffer");
+}
+
+static CFTypeRef sfCreateFrame(GLint width, GLint height) {
+    CFMutableDictionaryRef props = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    CFStringRef keys[] = { CFSTR("IOSurfaceWidth"), CFSTR("IOSurfaceHeight"), CFSTR("IOSurfaceBytesPerElement"), CFSTR("IOSurfacePixelFormat") };
+    int values[] = { width, height, 4, 0x42475241 /* 'BGRA' */ };
+    CFTypeRef surface;
+
+    if (props == NULL)
+        return NULL;
+    for (int i = 0; i < 4; i++) {
+        CFNumberRef n = CFNumberCreate(NULL, kCFNumberIntType, &values[i]);
+
+        CFDictionarySetValue(props, keys[i], n);
+        CFRelease(n);
+    }
+    surface = sfFrameAPI.create(props);
+    CFRelease(props);
+    if (surface != NULL && sfFrameAPI.gpuOffset(surface) == 0) {
+        CFRelease(surface);
+        surface = NULL;
+    }
+    return surface;
+}
