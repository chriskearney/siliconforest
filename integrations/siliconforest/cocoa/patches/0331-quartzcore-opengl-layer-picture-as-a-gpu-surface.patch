+// (IOSURF) the picture just drawn, copied on the GPU into the next of two GPU surfaces, as the contents; NO when that
+// cannot be done (no GPU storage, no CGL copy), and then the picture is read back as before
+- (BOOL)_sfPresentFrameWidth:(GLint)width height:(GLint)height {
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+    if (_sfFramesOff)
+        return NO;
+    pthread_once(&once, sfLoadFrameAPI);
+    if (sfFrameAPI.create == NULL || sfFrameAPI.gpuOffset == NULL || sfFrameAPI.width == NULL || sfFrameAPI.height == NULL ||
+        sfFrameAPI.copy == NULL) {
+        _sfFramesOff = YES;
+        return NO;
+    }
+    unsigned slot = _sfFrameNext++ % 2;
+    CFTypeRef frame = _sfFrames[slot];
+
+    if (frame != NULL && (sfFrameAPI.width(frame) != (size_t)width || sfFrameAPI.height(frame) != (size_t)height)) {
+        CFRelease(frame);
+        frame = _sfFrames[slot] = NULL;
+    }
+    if (frame == NULL && (frame = _sfFrames[slot] = sfCreateFrame(width, height)) == NULL) {
+        if (sfTraceLevel() > 0)
+            fprintf(stderr, "CAOpenGLLayer %p: no IOSurface with GPU storage; its pictures are read back\n", self);
+        _sfFramesOff = YES;
+        return NO;
+    }
+    // an opaque layer's alpha is not looked at (0320); the surface carries it to the renderer, so it is made 1 here
+    if ([self isOpaque]) {
+        GLboolean mask[4], scissor = glIsEnabled(GL_SCISSOR_TEST);
+        GLfloat clear[4];
+
+        glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+        glGetFloatv(GL_COLOR_CLEAR_VALUE, clear);
+        glDisable(GL_SCISSOR_TEST);
+        glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glColorMask(mask[0], mask[1], mask[2], mask[3]);
+        glClearColor(clear[0], clear[1], clear[2], clear[3]);
+        if (scissor)
+            glEnable(GL_SCISSOR_TEST);
+    }
+    // rows flipped on the way, top row first as an image's; complete on the GPU when it returns. Where it fails (the
+    // context not yet at the new size during a resize) this one picture is read back
+    if (!sfFrameAPI.copy(frame, 1)) {
+        if (sfTraceLevel() > 0)
+            fprintf(stderr, "CAOpenGLLayer %p: the GPU copy into its %dx%d surface failed; this picture is read back\n", self, width, height);
+        return NO;
+    }
+    [self setContents:(id)frame];
+    return YES;
+}
