+// NSView+Accessibility.m — AX protocol conformance for all NSView subclasses
+// Copyright (c) 2026 The SiliconForest Project, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+
+#import <AppKit/NSView+Accessibility.h>
+#import <AppKit/NSWindow.h>
+#import <Foundation/Foundation.h>
+#import "SFAccessibilityServer.h"
+
+NSString * const SFAXRoleButton     = @"AXButton";
+NSString * const SFAXRoleStaticText = @"AXStaticText";
+NSString * const SFAXRoleTextField  = @"AXTextField";
+NSString * const SFAXRoleTextArea   = @"AXTextArea";
+NSString * const SFAXRoleGroup      = @"AXGroup";
+NSString * const SFAXRoleWindow     = @"AXWindow";
+NSString * const SFAXRoleApplication = @"AXApplication";
+NSString * const SFAXRoleUnknown    = @"AXUnknown";
+
+@implementation NSView (SFAccessibility)
+
+- (BOOL)isAccessibilityElement {
+    // Plain views are containers, not semantic elements.
+    // NSControl, NSTextView etc. override this to YES.
+    return NO;
+}
+
+- (NSString *)accessibilityRole {
+    return SFAXRoleGroup;
+}
+
+- (NSString *)accessibilityLabel {
+    // Check for tooltip as a fallback label (set by IB / accessibility inspectors)
+    return [self toolTip];
+}
+
+- (id)accessibilityValue {
+    return nil;
+}
+
+- (id)accessibilityParent {
+    if ([self superview] != nil)
+        return [self superview];
+    return [self window];
+}
+
+- (NSArray *)accessibilityChildren {
+    NSMutableArray *result = [NSMutableArray array];
+    NSView *subview;
+
+    for (subview in [self subviews]) {
+        if ([subview isAccessibilityElement] || [[subview accessibilityChildren] count] > 0)
+            [result addObject:subview];
+    }
+    return result;
+}
+
+- (id)accessibilityFocusedUIElement {
+    if ([self isAccessibilityElement])
+        return self;
+    for (NSView *child in [self subviews]) {
+        id focused = [child accessibilityFocusedUIElement];
+        if (focused != nil)
+            return focused;
+    }
+    return nil;
+}
+
+- (void)sfPostFocusGained {
+    NSString *role   = [self accessibilityRole]  ?: SFAXRoleUnknown;
+    NSString *label  = [self accessibilityLabel] ?: @"";
+    id        value  = [self accessibilityValue];
+    NSString *valStr = (value != nil) ? [NSString stringWithFormat:@"%@", value] : @"";
+    NSRect    frame  = [self accessibilityFocusedUIElement] != nil
+                       ? [(NSView *)[self accessibilityFocusedUIElement] frame]
+                       : [self frame];
+
+    [[SFAccessibilityServer sharedServer]
+        postFocusChangedWithRole:role
+                           label:label
+                           value:valStr
+                             pid:[[NSProcessInfo processInfo] processIdentifier]
+                           frame:frame];
+}
+
+@end
