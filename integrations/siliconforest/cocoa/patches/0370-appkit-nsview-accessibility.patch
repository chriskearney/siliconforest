+// NSView+Accessibility.h — AX protocol conformance for all NSView subclasses
+// Copyright (c) 2026 The SiliconForest Project, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+//
+// Every NSView automatically becomes accessible. Subclasses override the
+// property accessors to return their actual role/label/value. The IPC layer
+// (SFAccessibilityServer) reads these when the focused view changes.
+
+#import <AppKit/NSView.h>
+#import <AppKit/NSAccessibility.h>
+
+// AXRole constants (subset of AXAttributeConstants.h, used without HIServices)
+extern NSString * const SFAXRoleButton;
+extern NSString * const SFAXRoleStaticText;
+extern NSString * const SFAXRoleTextField;
+extern NSString * const SFAXRoleTextArea;
+extern NSString * const SFAXRoleGroup;
+extern NSString * const SFAXRoleWindow;
+extern NSString * const SFAXRoleApplication;
+extern NSString * const SFAXRoleUnknown;
+
+@interface NSView (SFAccessibility)
+
+// Return YES for views that have semantic accessibility meaning (default: NO for
+// plain NSView; YES for controls, text views, buttons). Override in subclasses.
+- (BOOL)isAccessibilityElement;
+
+// AX role string. Default: SFAXRoleGroup (a container).
+- (NSString *)accessibilityRole;
+
+// Human-readable label (title, placeholder, tooltip). Default: nil.
+- (NSString *)accessibilityLabel;
+
+// Current value (text content, checkbox state, slider position). Default: nil.
+- (id)accessibilityValue;
+
+// Focused descendant. Default: returns self if isFocused, else first focused child.
+- (id)accessibilityFocusedUIElement;
+
+// Parent in the AX tree. Default: [self superview] ?? [self window].
+- (id)accessibilityParent;
+
+// AX children: visible subviews that are accessibility elements.
+- (NSArray *)accessibilityChildren;
+
+// Post an AX notification to SFAccessibilityServer when focus enters this view.
+- (void)sfPostFocusGained;
+
+@end
