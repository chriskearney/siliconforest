+static BOOL hasRunDelegate(CFAttributedStringRef string, CFIndex length) {
+    for (CFIndex index = 0; index < length;) {
+        CFRange range;
+        if (CFAttributedStringGetAttribute(string, index, kCTRunDelegateAttributeName, &range))
+            return YES;
+        CFIndex next = range.location + range.length;
+        if (next <= index)
+            return YES;
+        index = next;
+    }
+    return NO;
+}
