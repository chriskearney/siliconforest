+// SFAccessibilityServer.h — IPC layer: AppKit → SiliconForest accessibility daemon
+// Copyright (c) 2026 The SiliconForest Project, SPDX-License-Identifier: MPL-2.0 OR BSD-2-Clause
+//
+// Sends JSON events over a Unix domain socket to the Python AXUIServer daemon
+// (a11y/axserver.py). The daemon forwards them to eSpeak-NG TTS and BRLTTY.
+//
+// Socket path: /tmp/com.siliconforest.axuiserver (matches axserver.py)
+// Message format (newline-delimited JSON):
+//   { "type": "focus_changed", "pid": N, "role": "AXButton",
+//     "label": "OK", "value": "", "frame": [x,y,w,h] }
+//   { "type": "window_activated", "pid": N, "title": "Terminal" }
+//   { "type": "text_changed",  "pid": N, "text": "..." }
+//   { "type": "screenreader_active", "active": true/false }
+
+#import <Foundation/NSObject.h>
+#import <Foundation/NSGeometry.h>
+#import <Foundation/NSString.h>
+
+#define SF_AX_SOCKET_PATH "/tmp/com.siliconforest.axuiserver"
+
+@interface SFAccessibilityServer : NSObject {
+    int _socketFd;
+    BOOL _connected;
+}
+
++ (instancetype)sharedServer;
+
+// Connect to axserver daemon (called lazily on first post).
+- (BOOL)connect;
+
+// Close and forget the connection (reconnect on next post).
+- (void)disconnect;
+
+// Post focus-change event (called by NSView+Accessibility on first responder change).
+- (void)postFocusChangedWithRole:(NSString *)role
+                           label:(NSString *)label
+                           value:(NSString *)value
+                             pid:(int)pid
+                           frame:(NSRect)frame;
+
+// Post window-activation event.
+- (void)postWindowActivatedWithTitle:(NSString *)title pid:(int)pid;
+
+// Post text-change event (called by NSTextView on text change).
+- (void)postTextChangedWithText:(NSString *)text pid:(int)pid;
+
+// Query whether the screenreader is active (cached; refreshed every 2 s).
+@property(readonly) BOOL screenreaderActive;
+
+@end
