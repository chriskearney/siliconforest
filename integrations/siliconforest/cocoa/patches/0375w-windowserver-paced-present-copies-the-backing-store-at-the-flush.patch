 static void windowPacedCommit(struct wsWindow *window);
+/* (0375w, ChonkCraft's white bars) A present held back by SF_WS_PACE_PRESENTS used to copy the backing store when the
+ * frame callback came, from the thread that reads the connection, while the application's main thread was free to be
+ * in the middle of its next drawing: the compositor got the window half drawn (ChonkCraft: the window's background
+ * filled and the game's picture in the top part of each of Onyx2D's four bands, the rest white, a few times a
+ * minute). The flush is the moment AppKit has finished drawing, so the held-back flush now copies the backing store
+ * into a frame there and then, and the callback only puts that copy on the surface and commits it. A later flush
+ * before the callback copies into the same frame (the newest picture wins, as before). Not for a GPU presenter's
+ * frames (they compose from the backing store when presented, as before). SF_WS_PACE_HOLD=0: as before. */
+static int wsPaceHold(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("SF_WS_PACE_HOLD");
+        on = !(v != NULL && strcmp(v, "0") == 0);
+    }
+    return on;
+}
+static struct wsFrame *windowFreeFrame(struct wsWindow *window, int w, int h, int gpu);
+static int sfGPURoleTakesDmabuf(struct wsWindow *window);
+static void windowAttachFrame(struct wsWindow *window, struct wsFrame *frame);
+// lets the held copy go unpresented (ws.pixelsLock held)
+static void windowDropHeld(struct wsWindow *window) {
+    struct wsFrame *frame = window->held;
+    if (frame == NULL)
+        return;
+    window->held = NULL;
+    pthread_mutex_lock(&ws.queueLock);
+    frame->busy = 0;
+    pthread_cond_broadcast(&ws.queueReady);
+    pthread_mutex_unlock(&ws.queueLock);
+}
+// copies the finished backing store into the held frame (ws.pixelsLock held); 0: nothing held (the callback copies)
+static int windowHold(struct wsWindow *window) {
+    if (!wsPaceHold() || window->pixels == NULL || window->pixelsW <= 0 || window->pixelsH <= 0)
+        return 0;
+    if (window->gpuPresenter && !window->gpuPresenter->failed && window->gpuPresenter->count > 0 && ws.dmabuf && sfGPURoleTakesDmabuf(window)) {
+        windowDropHeld(window);
+        return 0;
+    }
+    struct wsFrame *frame = window->held;
+    if (frame != NULL && (frame->buffer == NULL || frame->gpuOutput != NULL || frame->w != window->pixelsW || frame->h != window->pixelsH)) {
+        windowDropHeld(window);
+        frame = NULL;
+    }
+    if (frame == NULL) {
+        frame = windowFreeFrame(window, window->pixelsW, window->pixelsH, 0);
+        if (frame == NULL)
+            return 0;
+        window->held = frame;
+    }
+    memcpy(frame->pixels, window->pixels, frame->size);
+    frame->pointsW = window->pointsW;
+    frame->pointsH = window->pointsH;
+    frame->damageKnown = 0;
+    return 1;
+}
+// puts the held copy on the surface (ws.pixelsLock held), the caller commits; 0: none, or of a size gone by
+static int windowPresentHeld(struct wsWindow *window) {
+    struct wsFrame *frame = window->held;
+    if (frame == NULL)
+        return 0;
+    if (frame->w != window->pixelsW || frame->h != window->pixelsH) {
+        windowDropHeld(window);
+        return 0;
+    }
+    window->held = NULL;
+    window->front = frame;
+    windowAttachFrame(window, frame);
+    return 1;
+}
