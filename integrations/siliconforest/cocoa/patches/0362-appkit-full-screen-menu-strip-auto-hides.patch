+/* (QTP) In full screen, as macOS's menu bar: the strip hides, lies over the top of the content and slides in
+ * while the pointer is at the screen's top edge (or over the strip), unless the presentation options keep it
+ * (no menu-bar option) or hide it for good (NSApplicationPresentationHideMenuBar). The options are the
+ * application's when it set menu-bar options itself, else the window delegate's answer to
+ * -window:willUseFullScreenPresentationOptions: for macOS's default (full screen, auto-hide menu bar and Dock).
+ * 0: the strip stays as it is outside full screen; 1: it auto-hides; 2: it is hidden. */
++ (int)_sfMenuStripFullScreenModeForOptions:(NSUInteger)options
+{
+    if (options & NSApplicationPresentationHideMenuBar)
+        return 2;
+    if (options & NSApplicationPresentationAutoHideMenuBar)
+        return 1;
+    return 0;
+}
+
+static NSUInteger sfFullScreenOptions(NSWindow *window)
+{
+    NSUInteger menuBits = NSApplicationPresentationAutoHideMenuBar | NSApplicationPresentationHideMenuBar;
+    NSUInteger application = [NSApp respondsToSelector:@selector(presentationOptions)] ? [NSApp presentationOptions] : 0;
+    NSUInteger options = NSApplicationPresentationFullScreen | NSApplicationPresentationAutoHideMenuBar | NSApplicationPresentationAutoHideDock;
+    id delegate = [window delegate];
+
+    if (application & menuBits)
+        return application;
+    if ([delegate respondsToSelector:@selector(window:willUseFullScreenPresentationOptions:)])
+        options = ((NSUInteger (*)(id, SEL, id, NSUInteger))objc_msgSend)(delegate, @selector(window:willUseFullScreenPresentationOptions:), window, options);
+    return options;
+}
+
+- (int)_sfMenuStripFullScreenMode
+{
+    if (!(_styleMask & NSFullScreenWindowMask))
+        return 0;
+    return [NSWindow _sfMenuStripFullScreenModeForOptions:sfFullScreenOptions(self)];
+}
+
+- (BOOL)_sfMenuStripOverlays
+{
+    return _menuView != nil && [self _sfMenuStripFullScreenMode] != 0;
+}
+
+static char sfStripTimerKey;
+
+/* while the strip auto-hides: the pointer decides, read ten times a second (no mouse-moved events needed) */
+- (void)_sfMenuStripFollowPointer:(NSTimer *)timer
+{
+    (void)timer;
+    if (_menuView == nil || [self _sfMenuStripFullScreenMode] != 1) {
+        [self _sfMenuStripFullScreenChanged];
+        return;
+    }
+    NSPoint pointer = [NSEvent mouseLocation];
+    NSRect frame = [self frame];
+    CGFloat stripHeight = NSHeight([_menuView frame]);
+    BOOL inside = pointer.x >= NSMinX(frame) && pointer.x <= NSMaxX(frame);
+    BOOL atTop = inside && pointer.y >= NSMaxY(frame) - 3;
+    BOOL overStrip = inside && ![_menuView isHidden] && pointer.y >= NSMaxY(frame) - stripHeight - 6;
+    BOOL show = atTop || overStrip;
+
+    if (show == [_menuView isHidden]) {
+        [_menuView setHidden:!show];
+        [_backgroundView setNeedsDisplayInRect:[_menuView frame]];
+    }
+}
+
+/* full screen entered or left, or its options changed: the strip's place and visibility */
+- (void)_sfMenuStripFullScreenChanged
+{
+    NSTimer *timer = objc_getAssociatedObject(self, &sfStripTimerKey);
+    int mode = _menuView != nil ? [self _sfMenuStripFullScreenMode] : 0;
+
+    if (mode != 1 && timer != nil) {
+        [timer invalidate];
+        objc_setAssociatedObject(self, &sfStripTimerKey, nil, OBJC_ASSOCIATION_RETAIN);
+    }
+    if (mode == 1 && timer == nil) {
+        timer = [NSTimer scheduledTimerWithTimeInterval:0.1 target:self selector:@selector(_sfMenuStripFollowPointer:) userInfo:nil repeats:YES];
+        objc_setAssociatedObject(self, &sfStripTimerKey, timer, OBJC_ASSOCIATION_RETAIN);
+    }
+    [_menuView setHidden:mode != 0];
+    if (mode == 1 && [[_backgroundView subviews] lastObject] != _menuView) {
+        // over the content: the frontmost of the frame's views
+        [_menuView retain];
+        [_menuView removeFromSuperview];
+        [_backgroundView addSubview:_menuView];
+        [_menuView release];
+    }
+    [_backgroundView resizeSubviewsWithOldSize:[_backgroundView frame].size];
+    [_backgroundView setNeedsDisplay:YES];
+}
