+/* (QTP) As on macOS since 10.8: a document application that keeps its documents in iCloud
+ * (NSUbiquitousContainers in its Info.plist) shows the Open panel where another opens an untitled
+ * document, at launch and when it is reopened without windows; the default
+ * NSShowAppCentricOpenPanelInsteadOfUntitledFile turns it off (NO) or on (YES). The delegate's
+ * -applicationShouldOpenUntitledFile: is not asked for the panel: Apple's QuickTime Player answers NO
+ * and shows it. */
+static BOOL sfShowsOpenPanelInsteadOfUntitled(void) {
+   id value=[[NSUserDefaults standardUserDefaults] objectForKey:@"NSShowAppCentricOpenPanelInsteadOfUntitledFile"];
+
+   if(value!=nil && [value respondsToSelector:@selector(boolValue)])
+    return [value boolValue];
+   return [[[NSBundle mainBundle] infoDictionary] objectForKey:@"NSUbiquitousContainers"]!=nil;
+}
+
 // what launch and a reopen with no windows do: ask the delegate, then fall back to a new document
 -(void)_openUntitledFile:(NSDocumentController *)controller {
    BOOL needsUntitled=YES;
 
+   if(controller!=nil && sfShowsOpenPanelInsteadOfUntitled()){
+    // not at once: launch finishes first (-applicationDidFinishLaunching: builds the menus); the panel runs
+    // modally here, so none is started while one is up
+    if([self modalWindow]==nil)
+     [controller performSelector:@selector(openDocument:) withObject:self afterDelay:0];
+    return;
+   }
+
 
    if(needsUntitled && _delegate &&
       [_delegate respondsToSelector: @selector(applicationShouldOpenUntitledFile:)]) {
