+// (QTP) the block-based listeners, written from their public documentation over the function-pointer ones above:
+// each block is kept (copied) with its queue in a record that is the client data of one internal listener, and each
+// change runs the block on that queue with its own copy of the addresses. Written against the published blocks ABI
+// (_Block_copy, _Block_release, the invoke function of the block's layout) so that this file needs no compiler
+// support for blocks.
+#include <dispatch/dispatch.h>
+
+extern void *_Block_copy(const void *block);
+extern void _Block_release(const void *block);
+
+struct blockLayout {
+    void *isa;
+    int flags;
+    int reserved;
+    void (*invoke)(void *block, UInt32 count, const AudioObjectPropertyAddress *addresses);
+};
+
+struct blockListener {
+    AudioObjectID object;
+    AudioObjectPropertyAddress address;
+    dispatch_queue_t queue;
+    void *block;
+    volatile int removed;
+    struct blockListener *next;
+};
+static struct blockListener *sBlockListeners;
+
+struct blockCall {
+    void *block;
+    UInt32 count;
+    AudioObjectPropertyAddress addresses[];
+};
+
+static void runBlockCall(void *context)
+{
+    struct blockCall *call = context;
+    ((struct blockLayout *)call->block)->invoke(call->block, call->count, call->addresses);
+    _Block_release(call->block);
+    free(call);
+}
+
+static OSStatus blockListenerProc(AudioObjectID object, UInt32 count, const AudioObjectPropertyAddress *addresses, void *data)
+{
+    struct blockListener *record = data;
+    struct blockCall *call = malloc(sizeof(*call) + sizeof(addresses[0]) * (count ? count : 1));
+
+    (void)object;
+    if (record->removed) {
+        free(call);
+        return noErr;
+    }
+    if (call == NULL)
+        return kAudioHardwareUnspecifiedError;
+    call->block = _Block_copy(record->block);
+    call->count = count;
+    memcpy(call->addresses, addresses, sizeof(addresses[0]) * count);
+    dispatch_async_f(record->queue ? record->queue : dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), call, runBlockCall);
+    return noErr;
+}
+
+OSStatus AudioObjectAddPropertyListenerBlock(AudioObjectID object, const AudioObjectPropertyAddress *address,
+                                             AudioObjectDispatchQueue queue, AudioObjectPropertyListenerBlock listener)
+{
+    if (address == NULL || listener == NULL)
+        return kAudioHardwareIllegalOperationError;
+    struct blockListener *record = calloc(1, sizeof(*record));
+    if (record == NULL)
+        return kAudioHardwareUnspecifiedError;
+    record->object = object;
+    record->address = *address;
+    record->queue = (dispatch_queue_t)queue;
+    if (record->queue != NULL)
+        dispatch_retain(record->queue);
+    record->block = _Block_copy((const void *)listener);
+    OSStatus status = AudioObjectAddPropertyListener(object, address, blockListenerProc, record);
+    if (status != noErr) {
+        _Block_release(record->block);
+        if (record->queue != NULL)
+            dispatch_release(record->queue);
+        free(record);
+        return status;
+    }
+    pthread_mutex_lock(&sLock);
+    record->next = sBlockListeners;
+    sBlockListeners = record;
+    pthread_mutex_unlock(&sLock);
+    return noErr;
+}
+
+// the same block and queue for the same object and address, as documented; calls already queued still run
+OSStatus AudioObjectRemovePropertyListenerBlock(AudioObjectID object, const AudioObjectPropertyAddress *address,
+                                                AudioObjectDispatchQueue queue, AudioObjectPropertyListenerBlock listener)
+{
+    struct blockListener *found = NULL;
+
+    if (address == NULL || listener == NULL)
+        return kAudioHardwareIllegalOperationError;
+    pthread_mutex_lock(&sLock);
+    for (struct blockListener **p = &sBlockListeners; *p; p = &(*p)->next) {
+        struct blockListener *r = *p;
+        if (r->object == object && r->address.mSelector == address->mSelector && r->address.mScope == address->mScope &&
+            r->address.mElement == address->mElement && r->queue == (dispatch_queue_t)queue && r->block == (const void *)listener) {
+            *p = r->next;
+            found = r;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&sLock);
+    if (found == NULL)
+        return kAudioHardwareUnknownPropertyError;
+    // the HAL calls listeners from a copy of its list taken under its lock: a delivery already under way may still
+    // read this record, so it is marked and kept (with its block and queue) for the process, not freed
+    found->removed = 1;
+    return AudioObjectRemovePropertyListener(object, address, blockListenerProc, found);
+}
+
 // coreaudiod mixes every client at full level and has no ducking yet
