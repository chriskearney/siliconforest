+#else
+typedef void *AudioObjectPropertyListenerBlock;
+#endif
+typedef struct dispatch_queue_s *AudioObjectDispatchQueue;
+OSStatus AudioObjectAddPropertyListenerBlock(AudioObjectID inObjectID, const AudioObjectPropertyAddress *inAddress,
+                                             AudioObjectDispatchQueue inDispatchQueue, AudioObjectPropertyListenerBlock inListener);
