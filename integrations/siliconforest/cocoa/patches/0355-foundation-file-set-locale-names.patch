+// (QTP) the URL forms of the path methods (missing; first caller Apple's QuickTime Player). The keys to prefetch
+// are a hint (each URL answers them when asked); the options skip hidden files (names starting with ".")
+- (BOOL)removeItemAtURL:(NSURL *)url error:(NSError **)error {
+    return [self removeItemAtPath:[url path] error:error];
+}
+
+- (BOOL)copyItemAtURL:(NSURL *)source toURL:(NSURL *)destination error:(NSError **)error {
+    return [self copyItemAtPath:[source path] toPath:[destination path] error:error];
+}
+
+- (NSArray<NSURL *> *)contentsOfDirectoryAtURL:(NSURL *)url
+                    includingPropertiesForKeys:(NSArray *)keys
+                                       options:(NSUInteger)options
+                                         error:(NSError **)error {
+    NSArray *names = [self contentsOfDirectoryAtPath:[url path] error:error];
+    NSMutableArray *result = [NSMutableArray arrayWithCapacity:[names count]];
+
+    (void)keys;
+    if (names == nil)
+        return nil;
+    for (NSString *name in names) {
+        if ((options & (1UL << 2)) && [name hasPrefix:@"."])   // NSDirectoryEnumerationSkipsHiddenFiles
+            continue;
+        [result addObject:[url URLByAppendingPathComponent:name]];
+    }
+    return result;
+}
+
 - (BOOL)moveItemAtURL:(NSURL *)source toURL:(NSURL *)destination error:(NSError **)error {
     return [self moveItemAtPath:[source path] toPath:[destination path] error:error];
 }
