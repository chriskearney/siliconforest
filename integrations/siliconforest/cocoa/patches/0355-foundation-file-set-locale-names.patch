+// (QTP) Resource values a file system lets a program set: none here, so each is refused with an error that says so
+// (the value is unchanged)
+- (BOOL)setResourceValue:(id)value forKey:(NSString *)key error:(NSError **)error {
+    (void)value;
+    if (error != NULL)
+        *error = [NSError errorWithDomain:NSCocoaErrorDomain code:3328 /* NSFeatureUnsupportedError */
+                                 userInfo:[NSDictionary dictionaryWithObject:[NSString stringWithFormat:@"Setting the resource value %@ is not supported.", key]
+                                                                      forKey:NSLocalizedDescriptionKey]];
+    return NO;
+}
+
+- (BOOL)setResourceValues:(NSDictionary *)values error:(NSError **)error {
+    for (NSString *key in values)
+        return [self setResourceValue:[values objectForKey:key] forKey:key error:error];
+    return YES;
+}
