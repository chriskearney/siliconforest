+// (QTP) a menu's name (NSRecentDocumentsMenu, NSWindowsMenu ...) set from code, and every menu of a name: private on
+// macOS; Apple's QuickTime Player names its Open Recent menus with them
+-(void)_setMenuName:(NSString *)name {
+   if(name==_name)
+    return;
+   [_name release];
+   _name=[name copy];
+}
+
+-(NSArray *)_menusWithName:(NSString *)name {
+   NSMutableArray *result=[NSMutableArray array];
+
+   if([_name isEqual:name])
+    [result addObject:self];
+   for(NSMenuItem *item in _itemArray)
+    if([item submenu]!=nil)
+     [result addObjectsFromArray:[[item submenu] _menusWithName:name]];
+   return result;
+}
+
 -(NSMenu *)_menuWithName:(NSString *)name {
    if([_name isEqual:name])
     return self;
