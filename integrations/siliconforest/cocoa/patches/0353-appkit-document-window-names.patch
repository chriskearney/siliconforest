+// (QTP) macOS's (private) request that the window server composite the window's layers itself. Here AppKit
+// draws every layer into the window's picture, so it is kept and answered, and changes nothing. Apple's
+// QuickTime Player sets it on each document window it makes (the window was never made: unrecognised selector).
+// (QTP) private on macOS: whether the window is the panel the application runs modally
+- (BOOL)isModalPanel
+{
+    return [self isKindOfClass:[NSPanel class]] && [NSApp modalWindow] == self;
+}
+
+- (BOOL)canHostLayersInWindowServer
+{
+    return SFGetInteger(self, &SFHostsLayersKey, 0) != 0;
+}
+
+- (void)setCanHostLayersInWindowServer:(BOOL)flag
+{
+    SFSetInteger(self, &SFHostsLayersKey, flag ? 1 : 0);
+}
+
+// (QTP) macOS's (private) opacity of the title bar, which QuickTime Player fades with the controls. The compositor
+// draws the title bar here and has no such setting: the value is kept and answered (1 until set), nothing fades.
+- (CGFloat)titlebarAlphaValue
+{
+    NSNumber *value = objc_getAssociatedObject(self, &SFTitlebarAlphaKey);
+    return value ? [value doubleValue] : 1.0;
+}
+
+- (void)setTitlebarAlphaValue:(CGFloat)value
+{
+    objc_setAssociatedObject(self, &SFTitlebarAlphaKey, [NSNumber numberWithDouble:value], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
