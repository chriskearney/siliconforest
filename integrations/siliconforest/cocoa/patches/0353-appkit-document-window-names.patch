    return _keyEquivalentModifierMask;
 }
 
+// (QTP) whether this item's key equivalent is that key with those modifiers (private on macOS; Apple's QuickTime
+// Player asks from its menu delegate): an upper-case equivalent carries Shift; only the device-independent bits count
+-(BOOL)_matchesKeyEquivalent:(NSString *)key modifierMask:(NSUInteger)mask {
+   NSString  *mine=[self keyEquivalent];
+   NSUInteger relevant=NSShiftKeyMask|NSControlKeyMask|NSAlternateKeyMask|NSCommandKeyMask;
+   NSUInteger wanted=[self keyEquivalentModifierMask]&relevant;
+
+   if([mine length]==0 || [key length]==0 || ![self isEnabled])
+    return NO;
+   if([mine length]==1 && [[mine uppercaseString] isEqualToString:mine] && ![[mine lowercaseString] isEqualToString:mine])
+    wanted|=NSShiftKeyMask;
+   if([mine caseInsensitiveCompare:key]!=NSOrderedSame)
+    return NO;
+   return (mask&relevant)==wanted;
+}
