+static double sfNow(void) { struct timeval tv; gettimeofday(&tv, NULL); return tv.tv_sec + tv.tv_usec / 1e6; }
+static int sfLuma(const uint8_t *px, size_t row, GLint w, GLint h) {
+    int best = 0;
+    for (int i = 1; i <= 3; i++) for (int j = 1; j <= 3; j++) {
+        const uint8_t *q = px + (size_t)(h * j / 4) * row + (size_t)(w * i / 4) * 4;
+        int l = (q[0] + 2 * q[1] + q[2]) / 4;
+        if (l > best) best = l;
+    }
+    return best;
+}
