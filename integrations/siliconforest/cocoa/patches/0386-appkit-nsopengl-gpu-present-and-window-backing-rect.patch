+static SFNSGLGPUPresenter *sfNSGLStateForContext(NSOpenGLContext *ctx,BOOL create) {
+   SFNSGLGPUPresenter *st=(SFNSGLGPUPresenter *)objc_getAssociatedObject(ctx,&sfNSGLGPUStateKey);
+   if(st==nil && create){
+    st=[[[SFNSGLGPUPresenter alloc] init] autorelease];
+    objc_setAssociatedObject(ctx,&sfNSGLGPUStateKey,st,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+   }
+   return st;
+}
