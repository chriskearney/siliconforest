+@interface SFNSGLGPUPresenter : NSObject {
+@public
+   CFTypeRef _surfaces[SF_NSGL_RING];
+   int _w[SF_NSGL_RING];
+   int _h[SF_NSGL_RING];
+   unsigned _next;
+   int _registeredWindowID;
+   uintptr_t _registeredKey;
+   BOOL _registered;
+   BOOL _disabled;
+   BOOL _loggedActive;
+   GLint _surfaceOpacity;
+   uint64_t _lastPresentNs;
+}
+-(void)unregisterLayer;
+-(CFTypeRef)surfaceForSlot:(unsigned)slot width:(int)w height:(int)h;
+@end
+
+@implementation SFNSGLGPUPresenter
+-(id)init {
+   if((self=[super init])){
+    _surfaceOpacity=1;
+   }
+   return self;
+}
+-(void)unregisterLayer {
+   if(_registered && _registeredWindowID>0 && sfNSGLAPI.wsSetLayer!=NULL)
+    sfNSGLAPI.wsSetLayer(_registeredWindowID,_registeredKey,NULL,0,0,0,0,0,0,0,0);
+   _registered=NO;
+   _registeredWindowID=0;
+}
+-(CFTypeRef)surfaceForSlot:(unsigned)slot width:(int)w height:(int)h {
+   if(_surfaces[slot]!=NULL && _w[slot]==w && _h[slot]==h)
+    return _surfaces[slot];
+   if(_surfaces[slot]!=NULL){
+    CFRelease(_surfaces[slot]);
+    _surfaces[slot]=NULL;
+    _w[slot]=_h[slot]=0;
+   }
+   CFTypeRef s=sfNSGLCreateGPUSurface(w,h);
+   if(s!=NULL){
+    _surfaces[slot]=s;
+    _w[slot]=w;
+    _h[slot]=h;
+   }
+   return s;
+}
+-(void)dealloc {
+   [self unregisterLayer];
+   for(int i=0;i<SF_NSGL_RING;i++){
+    if(_surfaces[i]!=NULL){
+     CFRelease(_surfaces[i]);
+     _surfaces[i]=NULL;
+    }
+   }
+   [super dealloc];
+}
+@end
+
+static char sfNSGLGPUStateKey;
