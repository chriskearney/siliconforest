+/* Default-on when WindowServer GPU presentation and IOSurface dma-buf storage are
+ * available; SF_NSGL_GPU_PRESENT=0 or SFFX_GPU_PRESENT=0 forces the CPU readback path. */
+static int sfNSGLGPUEnabled(void) {
+   static int mode=-1;
+   if(mode<0){
+    const char *v=getenv("SF_NSGL_GPU_PRESENT");
+    const char *fx=getenv("SFFX_GPU_PRESENT");
+    if((v!=NULL && !strcmp(v,"0")) || (fx!=NULL && !strcmp(fx,"0")))
+     mode=0;
+    else
+     mode=1;
+   }
+   return mode;
+}
+
+static uint64_t sfNSGLMonotonicNs(void) {
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC,&ts);
+   return (uint64_t)ts.tv_sec*1000000000ULL+(uint64_t)ts.tv_nsec;
+}
+
+static double sfNSGLRefreshRate(void) {
+   static double hz=0.0;
+   static dispatch_once_t once;
+   dispatch_once(&once, ^{
+    CGDisplayModeRef mode=CGDisplayCopyDisplayMode(CGMainDisplayID());
+    if(mode!=NULL){
+     hz=CGDisplayModeGetRefreshRate(mode);
+     CGDisplayModeRelease(mode);
+    }
+    if(hz<15.0 || hz>240.0)
+     hz=60.0;
+   });
+   return hz;
+}
+
+static CFTypeRef sfNSGLCreateGPUSurface(int width,int height) {
+   CFMutableDictionaryRef props=CFDictionaryCreateMutable(NULL,0,&kCFTypeDictionaryKeyCallBacks,&kCFTypeDictionaryValueCallBacks);
+   if(props==NULL)
+    return NULL;
+   CFStringRef keys[]={
+    CFSTR("IOSurfaceWidth"),
+    CFSTR("IOSurfaceHeight"),
+    CFSTR("IOSurfaceBytesPerElement"),
+    CFSTR("IOSurfacePixelFormat"),
+    CFSTR("SFIOSurfaceGPUStorage")
+   };
+   int values[]={ width, height, 4, 0x42475241 /* 'BGRA' */, 1 };
+   for(int i=0;i<5;i++){
+    CFNumberRef n=CFNumberCreate(NULL,kCFNumberIntType,&values[i]);
+    if(n!=NULL){
+     CFDictionarySetValue(props,keys[i],n);
+     CFRelease(n);
+    }
+   }
+   CFTypeRef surface=sfNSGLAPI.iosCreate(props);
+   CFRelease(props);
+   if(surface!=NULL && sfNSGLAPI.iosGPUOffset(surface)==0){
+    CFRelease(surface);
+    return NULL;
+   }
+   return surface;
+}
