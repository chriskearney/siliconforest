@@ -138,6 +138,26 @@ NSArray<NSString *> *NSSearchPathForDirectoriesInDomains(
 
 @implementation NSString (NSPathUtilities)
 
+// (QTP) the components joined by one "/" each, as on macOS: a first component "/" makes the path
+// absolute, empty components and repeated or trailing separators drop out, an empty array gives "".
+// It was missing (first caller: Apple's QuickTime Player at launch, which got an exception).
++ (NSString *)pathWithComponents:(NSArray<NSString *> *)components {
+    NSMutableString *path = [NSMutableString string];
+
+    for (NSString *component in components) {
+        if (![component isKindOfClass:[NSString class]] || [component length] == 0)
+            continue;
+        if ([path length] > 0 && ![path hasSuffix:@"/"])
+            [path appendString:@"/"];
+        [path appendString:component];
+    }
+    while ([path rangeOfString:@"//"].location != NSNotFound)
+        [path replaceOccurrencesOfString:@"//" withString:@"/" options:0 range:NSMakeRange(0, [path length])];
+    if ([path length] > 1 && [path hasSuffix:@"/"])
+        [path deleteCharactersInRange:NSMakeRange([path length] - 1, 1)];
+    return [NSString stringWithString:path];
+}
