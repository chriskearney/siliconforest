+static int sfSFFXGPUMode(void){
+ static int mode=-1;
+ if(mode<0){
+  const char *gpu=getenv("SFFX_GPU_PRESENT");
+  if(gpu&&!strcmp(gpu,"0"))mode=0;
+  else if(gpu&&!strcmp(gpu,"1"))mode=2;
+  else mode=1; /* auto for GPU-content layer trees */
+ }
