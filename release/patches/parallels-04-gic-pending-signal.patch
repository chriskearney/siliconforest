+// Called with the local timer assigned to Group 0 and its delivery masked.
+static bool
+sf_gic_group0_signals_fiq(void)
+{
+	const uint32_t mask = 1u << GIC_TIMER_PPI;
+	const bool was_pending = (r_read(GICR_ISPENDR0) & mask) != 0;
+	uint64_t daif, highest, isr;
+
+	__asm__ volatile ("mrs %0, DAIF\n" "msr DAIFSet, #3\n" : "=r"(daif) :: "memory");
+	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
+	if (!was_pending) {
+		r_write(GICR_ISPENDR0, mask);
+	}
+	r_write(GICR_ISENABLER0, mask);
+	__asm__ volatile ("dsb sy\n" "isb\n" ::: "memory");
+	const uint64_t start = __builtin_arm_rsr64("CNTVCT_EL0");
+	const uint64_t limit = __builtin_arm_rsr64("CNTFRQ_EL0") / 1000;
+	bool fiq;
+	do {
+		highest = __builtin_arm_rsr64("ICC_HPPIR0_EL1");
+		isr = __builtin_arm_rsr64("ISR_EL1");
+		fiq = highest == GIC_TIMER_PPI && (isr & SF_ISR_FIQ_PENDING) != 0;
+	} while (!fiq && __builtin_arm_rsr64("CNTVCT_EL0") - start < limit);
+
+	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 0);
+	r_write(GICR_ICENABLER0, mask);
+	if (!was_pending) {
+		r_write(SF_GICR_ICPENDR0, mask);
+	}
+	__asm__ volatile ("dsb sy\n" "msr DAIF, %0\n" "isb\n" :: "r"(daif) : "memory");
+	return fiq;
+}
+
 #endif
 
 bool
