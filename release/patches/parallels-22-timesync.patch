diff --git a/src/Userspace/sf-timesync/protocol.c b/src/Userspace/sf-timesync/protocol.c
new file mode 100644
index 0000000..de2bc9a
--- /dev/null
+++ b/src/Userspace/sf-timesync/protocol.c
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#include "protocol.h"
+
+#include <string.h>
+
+enum {
+    SF_DESCRIPTORS = 32,
+    SF_DESCRIPTOR_SIZE = 16,
+    SF_POLICY_DATA = 48,
+    SF_TIME_DATA = 64,
+    SF_ZONE_DATA = 112,
+};
+
+static uint64_t sf_read_le(const uint8_t *bytes, size_t width)
+{
+    uint64_t value = 0;
+    for (size_t i = 0; i < width; ++i)
+        value |= (uint64_t)bytes[i] << (8 * i);
+    return value;
+}
+
+static void sf_write_le(uint8_t *bytes, size_t width, uint64_t value)
+{
+    for (size_t i = 0; i < width; ++i) {
+        bytes[i] = (uint8_t)value;
+        value >>= 8;
+    }
+}
+
+static size_t sf_frame_size(enum sf_timesync_op operation)
+{
+    switch (operation) {
+    case SF_TIMESYNC_POLICY:
+        return SF_TIMESYNC_POLICY_SIZE;
+    case SF_TIMESYNC_TIME:
+        return SF_TIMESYNC_TIME_SIZE;
+    }
+    return 0;
+}
+
+static void sf_write_descriptor(uint8_t *descriptor, uint32_t length)
+{
+    sf_write_le(descriptor + 8, 4, length);
+    descriptor[12] = 1;
+}
+
+size_t sf_timesync_request(uint8_t frame[static SF_TIMESYNC_TIME_SIZE],
+                           enum sf_timesync_op operation, uint64_t id)
+{
+    const size_t size = sf_frame_size(operation);
+    if (size == 0)
+        return 0;
+    const bool is_policy = operation == SF_TIMESYNC_POLICY;
+    memset(frame, 0, size);
+    sf_write_le(frame, 4, size);
+    sf_write_le(frame + 4, 4, 1);
+    sf_write_le(frame + 8, 8, id);
+    sf_write_le(frame + 16, 4, operation);
+    sf_write_le(frame + 20, 4, UINT32_MAX);
+    sf_write_le(frame + 26, 2, is_policy ? 1 : 2);
+    sf_write_descriptor(frame + SF_DESCRIPTORS, is_policy ? 8 : 48);
+    if (!is_policy)
+        sf_write_descriptor(frame + SF_DESCRIPTORS + SF_DESCRIPTOR_SIZE, SF_TIMESYNC_ZONE_SIZE);
+    return size;
+}
+
+bool sf_timesync_reply_header(const uint8_t *frame, size_t size,
+                             enum sf_timesync_op operation, uint64_t id)
+{
+    const size_t expected = sf_frame_size(operation);
+    return expected != 0 && size >= SF_TIMESYNC_HEADER_SIZE &&
+           sf_read_le(frame, 4) == expected && sf_read_le(frame + 4, 4) == 0 &&
+           sf_read_le(frame + 8, 8) == id;
+}
+
+static bool sf_descriptor_valid(const uint8_t *descriptor, uint32_t length)
+{
+    return sf_read_le(descriptor, 8) == 0 && sf_read_le(descriptor + 8, 4) == length &&
+           sf_read_le(descriptor + 12, 4) == 1;
+}
+
+static const char *sf_reply_error(const uint8_t *frame, size_t size,
+                                  enum sf_timesync_op operation, uint64_t id)
+{
+    if (size != sf_frame_size(operation) || !sf_timesync_reply_header(frame, size, operation, id))
+        return "invalid frame header or length";
+    if (sf_read_le(frame + 16, 4) != (uint32_t)operation)
+        return "mismatched operation";
+    if (sf_read_le(frame + 20, 4) != 0)
+        return "host returned nonzero status";
+
+    const bool is_policy = operation == SF_TIMESYNC_POLICY;
+    if (sf_read_le(frame + 24, 2) != 0 || sf_read_le(frame + 26, 2) != (is_policy ? 1u : 2u) ||
+        sf_read_le(frame + 28, 4) != 0 ||
+        !sf_descriptor_valid(frame + SF_DESCRIPTORS, is_policy ? 8 : 48) ||
+        (!is_policy && !sf_descriptor_valid(frame + SF_DESCRIPTORS + SF_DESCRIPTOR_SIZE,
+                                            SF_TIMESYNC_ZONE_SIZE)))
+        return "invalid descriptor layout";
+    return NULL;
+}
+
+const char *sf_timesync_parse_policy(const uint8_t *frame, size_t size, uint64_t id,
+                                     struct sf_timesync_policy *policy)
+{
+    const char *error = sf_reply_error(frame, size, SF_TIMESYNC_POLICY, id);
+    if (error)
+        return error;
+    if (sf_read_le(frame + SF_POLICY_DATA + 5, 3) != 0)
+        return "invalid policy data";
+    policy->interval = (uint32_t)sf_read_le(frame + SF_POLICY_DATA, 4);
+    policy->selector = frame[SF_POLICY_DATA + 4];
+    return NULL;
+}
+
+static bool sf_zone_character(uint8_t byte)
+{
+    return (byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') ||
+           (byte >= '0' && byte <= '9') || byte == '/' || byte == '_' ||
+           byte == '-' || byte == '+' || byte == '.';
+}
+
+const char *sf_timesync_parse_sample(const uint8_t *frame, size_t size, uint64_t id,
+                                     struct sf_timesync_sample *sample)
+{
+    const char *error = sf_reply_error(frame, size, SF_TIMESYNC_TIME, id);
+    if (error)
+        return error;
+
+    const uint8_t *zone = frame + SF_ZONE_DATA;
+    const uint8_t *terminator = memchr(zone, 0, SF_TIMESYNC_ZONE_SIZE);
+    if (!terminator || terminator == zone)
+        return "missing time-zone name";
+    for (const uint8_t *byte = zone; byte < terminator; ++byte) {
+        if (!sf_zone_character(*byte))
+            return "invalid time-zone character";
+    }
+    sample->milliseconds = sf_read_le(frame + SF_TIME_DATA, 8);
+    memcpy(sample->zone, zone, (size_t)(terminator - zone) + 1);
+    return NULL;
+}
diff --git a/src/Userspace/sf-timesync/protocol.h b/src/Userspace/sf-timesync/protocol.h
new file mode 100644
index 0000000..ce642cc
--- /dev/null
+++ b/src/Userspace/sf-timesync/protocol.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#ifndef SF_TIMESYNC_PROTOCOL_H
+#define SF_TIMESYNC_PROTOCOL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+enum sf_timesync_op {
+    SF_TIMESYNC_TIME = 0x9120,
+    SF_TIMESYNC_POLICY = 0x9121,
+};
+
+enum {
+    SF_TIMESYNC_HEADER_SIZE = 16,
+    SF_TIMESYNC_POLICY_SIZE = 56,
+    SF_TIMESYNC_TIME_SIZE = 624,
+    SF_TIMESYNC_ZONE_SIZE = 512,
+    SF_TIMESYNC_HOST_POLICY = 2,
+};
+
+struct sf_timesync_policy {
+    uint32_t interval;
+    uint8_t selector;
+};
+
+struct sf_timesync_sample {
+    uint64_t milliseconds;
+    char zone[SF_TIMESYNC_ZONE_SIZE];
+};
+
+size_t sf_timesync_request(uint8_t frame[static SF_TIMESYNC_TIME_SIZE],
+                           enum sf_timesync_op operation, uint64_t id);
+bool sf_timesync_reply_header(const uint8_t *frame, size_t size,
+                             enum sf_timesync_op operation, uint64_t id);
+// The parsers return NULL on success and leave the result untouched on failure.
+const char *sf_timesync_parse_policy(const uint8_t *frame, size_t size, uint64_t id,
+                                     struct sf_timesync_policy *policy);
+const char *sf_timesync_parse_sample(const uint8_t *frame, size_t size, uint64_t id,
+                                     struct sf_timesync_sample *sample);
+
+#endif
