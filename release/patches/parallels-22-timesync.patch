diff --git a/src/Userspace/sf-timesync/main.c b/src/Userspace/sf-timesync/main.c
new file mode 100644
index 0000000..f354c71
--- /dev/null
+++ b/src/Userspace/sf-timesync/main.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#include "protocol.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <poll.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/vsock.h>
+#include <time.h>
+#include <unistd.h>
+
+enum {
+    SF_HOST_PORT = 9000,
+    SF_IO_TIMEOUT_MS = 5000,
+    SF_MIN_INTERVAL = 10,
+    SF_MAX_INTERVAL = 3600,
+    SF_FIRST_RETRY = 5,
+    SF_SLOW_RETRY = 300,
+    SF_STEP_THRESHOLD_US = 500000,
+};
+
+static int64_t sf_monotonic_ms(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+        return -1;
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static int sf_wait(int fd, short events, int64_t deadline)
+{
+    for (;;) {
+        const int64_t now = sf_monotonic_ms();
+        if (now < 0)
+            return -1;
+        if (now >= deadline) {
+            errno = ETIMEDOUT;
+            return -1;
+        }
+        struct pollfd pfd = {fd, events, 0};
+        const int result = poll(&pfd, 1, (int)(deadline - now));
+        if (result > 0)
+            return 0;
+        if (result < 0 && errno != EINTR)
+            return -1;
+    }
+}
+
+static int sf_connect(int fd)
+{
+    const int enabled = 1;
+    if (fcntl(fd, F_SETFL, O_NONBLOCK) < 0 ||
+        setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &enabled, sizeof(enabled)) < 0)
+        return -1;
+
+    const struct sockaddr_vm address = {
+        .svm_len = sizeof(address), .svm_family = AF_VSOCK,
+        .svm_port = SF_HOST_PORT, .svm_cid = VMADDR_CID_HOST,
+    };
+    if (connect(fd, (const struct sockaddr *)&address, sizeof(address)) == 0)
+        return 0;
+    if (errno != EINPROGRESS)
+        return -1;
+
+    const int64_t now = sf_monotonic_ms();
+    if (now < 0 || sf_wait(fd, POLLOUT, now + SF_IO_TIMEOUT_MS) < 0)
+        return -1;
+    int error = 0;
+    socklen_t size = sizeof(error);
+    if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) < 0)
+        return -1;
+    if (error != 0) {
+        errno = error;
+        return -1;
+    }
+    return 0;
+}
+
+static int sf_transfer(int fd, uint8_t *buffer, size_t size, bool sending, int64_t deadline)
+{
+    while (size != 0) {
+        if (sf_wait(fd, sending ? POLLOUT : POLLIN, deadline) < 0)
+            return -1;
+        const ssize_t count = sending ? send(fd, buffer, size, 0) : recv(fd, buffer, size, 0);
+        if (count > 0) {
+            buffer += count;
+            size -= (size_t)count;
+        } else if (count == 0) {
+            errno = ECONNRESET;
+            return -1;
+        } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static const char *sf_exchange(int fd, enum sf_timesync_op operation, uint64_t id,
+                               uint8_t frame[static SF_TIMESYNC_TIME_SIZE], size_t *size)
+{
+    *size = sf_timesync_request(frame, operation, id);
+    const int64_t now = sf_monotonic_ms();
+    if (now < 0)
+        return strerror(errno);
+    const int64_t deadline = now + SF_IO_TIMEOUT_MS;
+    if (sf_transfer(fd, frame, *size, true, deadline) < 0 ||
+        sf_transfer(fd, frame, SF_TIMESYNC_HEADER_SIZE, false, deadline) < 0)
+        return strerror(errno);
+    if (!sf_timesync_reply_header(frame, SF_TIMESYNC_HEADER_SIZE, operation, id))
+        return "invalid reply header";
+    if (sf_transfer(fd, frame + SF_TIMESYNC_HEADER_SIZE, *size - SF_TIMESYNC_HEADER_SIZE,
+                    false, deadline) < 0)
+        return strerror(errno);
+    return NULL;
+}
+
+static void sf_sleep(unsigned seconds)
+{
+    struct timespec remaining = {.tv_sec = seconds};
+    while (nanosleep(&remaining, &remaining) < 0 && errno == EINTR)
+        continue;
+}
+
+static bool sf_should_step(const struct timeval *guest, const struct timeval *host)
+{
+    const struct timeval *earlier = guest;
+    const struct timeval *later = host;
+    if (guest->tv_sec > host->tv_sec ||
+        (guest->tv_sec == host->tv_sec && guest->tv_usec > host->tv_usec)) {
+        earlier = host;
+        later = guest;
+    }
+    const uint64_t seconds = (uint64_t)later->tv_sec - (uint64_t)earlier->tv_sec;
+    return seconds > 1 || (int64_t)seconds * 1000000 + later->tv_usec - earlier->tv_usec >
+                          SF_STEP_THRESHOLD_US;
+}
+
+// A true result ends the daemon after the host selects a different policy.
+static bool sf_session(int fd, unsigned *retry, bool *unavailable_logged)
+{
+    for (uint64_t id = 1; id < UINT64_MAX; id += 2) {
+        uint8_t frame[SF_TIMESYNC_TIME_SIZE];
+        size_t size;
+        struct sf_timesync_policy policy;
+        const char *error = sf_exchange(fd, SF_TIMESYNC_POLICY, id, frame, &size);
+        if (!error)
+            error = sf_timesync_parse_policy(frame, size, id, &policy);
+        if (error) {
+            fprintf(stderr, "sf-timesync: interval query: %s\n", error);
+            return false;
+        }
+        if (policy.selector != SF_TIMESYNC_HOST_POLICY) {
+            fprintf(stderr, "sf-timesync: unsupported host policy %u\n", (unsigned)policy.selector);
+            return true;
+        }
+
+        unsigned interval = policy.interval;
+        if (interval < SF_MIN_INTERVAL)
+            interval = SF_MIN_INTERVAL;
+        else if (interval > SF_MAX_INTERVAL)
+            interval = SF_MAX_INTERVAL;
+
+        struct sf_timesync_sample sample;
+        error = sf_exchange(fd, SF_TIMESYNC_TIME, id + 1, frame, &size);
+        if (!error)
+            error = sf_timesync_parse_sample(frame, size, id + 1, &sample);
+        if (error) {
+            fprintf(stderr, "sf-timesync: time query: %s\n", error);
+            return false;
+        }
+        if (id == 1) {
+            fprintf(stderr, "sf-timesync: interval=%u s host_interval=%" PRIu32
+                            " s policy=%u zone=%s accepted_sample_ms=%" PRIu64 "\n",
+                    interval, policy.interval, (unsigned)policy.selector, sample.zone, sample.milliseconds);
+        }
+
+        const struct timeval host = {
+            .tv_sec = (time_t)(sample.milliseconds / 1000),
+            .tv_usec = (suseconds_t)(sample.milliseconds % 1000 * 1000),
+        };
+        struct timeval guest;
+        if (gettimeofday(&guest, NULL) < 0) {
+            perror("sf-timesync: gettimeofday");
+            return false;
+        }
+        if (sf_should_step(&guest, &host)) {
+            if (settimeofday(&host, NULL) < 0) {
+                perror("sf-timesync: settimeofday");
+                return false;
+            }
+            fprintf(stderr, "sf-timesync: corrected guest clock host_ms=%" PRIu64
+                            " previous_guest=%jd.%06ld\n",
+                    sample.milliseconds, (intmax_t)guest.tv_sec, (long)guest.tv_usec);
+        }
+        *retry = SF_FIRST_RETRY;
+        *unavailable_logged = false;
+        sf_sleep(interval);
+    }
+    return false;
+}
+
+static bool sf_host_unavailable(int error)
+{
+    return error == EAFNOSUPPORT || error == EPROTONOSUPPORT || error == EOPNOTSUPP ||
+           error == ENODEV || error == ENXIO || error == ECONNREFUSED || error == EAGAIN;
+}
+
+int main(void)
+{
+    unsigned retry = SF_FIRST_RETRY;
+    bool unavailable_logged = false;
+    for (;;) {
+        const int fd = socket(AF_VSOCK, SOCK_STREAM, 0);
+        if (fd >= 0 && sf_connect(fd) == 0) {
+            const bool finished = sf_session(fd, &retry, &unavailable_logged);
+            close(fd);
+            if (finished)
+                return 0;
+        } else {
+            const int error = errno;
+            if (fd >= 0)
+                close(fd);
+            if (sf_host_unavailable(error)) {
+                if (!unavailable_logged) {
+                    fprintf(stderr, "sf-timesync: no host available: %s; retrying every %d s\n",
+                            strerror(error), SF_SLOW_RETRY);
+                    unavailable_logged = true;
+                }
+                sf_sleep(SF_SLOW_RETRY);
+                continue;
+            }
+            fprintf(stderr, "sf-timesync: connect: %s\n", strerror(error));
+        }
+        sf_sleep(retry);
+        retry = retry < SF_SLOW_RETRY / 2 ? retry * 2 : SF_SLOW_RETRY;
+    }
+}
