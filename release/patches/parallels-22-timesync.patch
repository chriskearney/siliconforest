+++ b/src/Userspace/sf-timesync/tests/protocol.c
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#include "../protocol.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static const uint64_t sf_test_id = UINT64_C(0x0807060504030201);
+
+static const uint8_t sf_policy_request[56] = {
+    [0] = 0x38, [4] = 1,
+    [8] = 1, 2, 3, 4, 5, 6, 7, 8,
+    [16] = 0x21, 0x91, [20] = 0xff, 0xff, 0xff, 0xff,
+    [26] = 1, [40] = 8, [44] = 1,
+};
+
+static const uint8_t sf_time_request[624] = {
+    [0] = 0x70, 0x02, [4] = 1,
+    [8] = 1, 2, 3, 4, 5, 6, 7, 8,
+    [16] = 0x20, 0x91, [20] = 0xff, 0xff, 0xff, 0xff,
+    [26] = 2, [40] = 48, [44] = 1, [56] = 0, 0x02, [60] = 1,
+};
+
+static const uint8_t sf_policy_reply[56] = {
+    [0] = 0x38, [8] = 1, 2, 3, 4, 5, 6, 7, 8,
+    [16] = 0x21, 0x91, [26] = 1, [40] = 8, [44] = 1,
+    [48] = 60, [52] = 2,
+};
+
+static const uint8_t sf_time_reply[624] = {
+    [0] = 0x70, 0x02, [8] = 1, 2, 3, 4, 5, 6, 7, 8,
+    [16] = 0x20, 0x91, [26] = 2,
+    [40] = 48, [44] = 1, [56] = 0, 0x02, [60] = 1,
+    [64] = 0x21, 0x43, 0x65, 0x87, 0xa9, 0xcb, 0xed, 0x0f,
+    [72] = 0xff, [111] = 0xff,
+    [112] = 'E', 't', 'c', '/', 'G', 'M', 'T', '+', '5', 0, 0xff,
+};
+
+static void sf_test_requests(void)
+{
+    uint8_t frame[SF_TIMESYNC_TIME_SIZE];
+    memset(frame, 0xff, sizeof(frame));
+    assert(sf_timesync_request(frame, SF_TIMESYNC_POLICY, sf_test_id) == sizeof(sf_policy_request));
+    assert(memcmp(frame, sf_policy_request, sizeof(sf_policy_request)) == 0);
+    memset(frame, 0xff, sizeof(frame));
+    assert(sf_timesync_request(frame, SF_TIMESYNC_TIME, sf_test_id) == sizeof(sf_time_request));
+    assert(memcmp(frame, sf_time_request, sizeof(sf_time_request)) == 0);
+}
+
+static void sf_test_policy(void)
+{
+    uint8_t frame[sizeof(sf_policy_reply) + 1] = {0};
+    memcpy(frame, sf_policy_reply, sizeof(sf_policy_reply));
+    struct sf_timesync_policy policy;
+    assert(sf_timesync_reply_header(frame, 16, SF_TIMESYNC_POLICY, sf_test_id));
+    assert(!sf_timesync_reply_header(frame, 15, SF_TIMESYNC_POLICY, sf_test_id));
+    assert(!sf_timesync_reply_header(frame, 16, SF_TIMESYNC_TIME, sf_test_id));
+    assert(!sf_timesync_reply_header(frame, 16, SF_TIMESYNC_POLICY, sf_test_id + 1));
+    assert(!sf_timesync_parse_policy(frame, sizeof(sf_policy_reply), sf_test_id, &policy));
+    assert(policy.interval == 60 && policy.selector == 2);
+    assert(sf_timesync_parse_policy(frame, sizeof(sf_policy_reply) - 1, sf_test_id, &policy));
+    assert(sf_timesync_parse_policy(frame, sizeof(frame), sf_test_id, &policy));
+
+    const size_t bad_offsets[] = {0, 3, 4, 7, 8, 15, 16, 20, 24, 26, 28, 32, 40, 44, 45, 53};
+    for (size_t i = 0; i < sizeof(bad_offsets) / sizeof(bad_offsets[0]); ++i) {
+        const size_t offset = bad_offsets[i];
+        frame[offset] ^= 1;
+        assert(sf_timesync_parse_policy(frame, sizeof(sf_policy_reply), sf_test_id, &policy));
+        assert(policy.interval == 60 && policy.selector == 2);
+        frame[offset] ^= 1;
+    }
+
+    frame[48] = 0x12;
+    frame[49] = 0x34;
+    frame[50] = 0x56;
+    frame[51] = 0x78;
+    frame[52] = 3;
+    assert(!sf_timesync_parse_policy(frame, sizeof(sf_policy_reply), sf_test_id, &policy));
+    assert(policy.interval == UINT32_C(0x78563412) && policy.selector == 3);
+}
+
+static void sf_test_sample(void)
+{
+    uint8_t frame[sizeof(sf_time_reply) + 1] = {0};
+    memcpy(frame, sf_time_reply, sizeof(sf_time_reply));
+    struct sf_timesync_sample sample;
+    assert(sf_timesync_reply_header(frame, 16, SF_TIMESYNC_TIME, sf_test_id));
+    assert(!sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    assert(sample.milliseconds == UINT64_C(0x0fedcba987654321));
+    assert(strcmp(sample.zone, "Etc/GMT+5") == 0);
+    for (size_t size = 0; size < sizeof(sf_time_reply); ++size)
+        assert(sf_timesync_parse_sample(frame, size, sf_test_id, &sample));
+    assert(sf_timesync_parse_sample(frame, sizeof(frame), sf_test_id, &sample));
+
+    const size_t bad_offsets[] = {0, 1, 4, 8, 16, 20, 24, 26, 28, 32, 40, 44, 45, 48, 56, 57, 60, 61};
+    for (size_t i = 0; i < sizeof(bad_offsets) / sizeof(bad_offsets[0]); ++i) {
+        const size_t offset = bad_offsets[i];
+        frame[offset] ^= 1;
+        assert(sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+        assert(sample.milliseconds == UINT64_C(0x0fedcba987654321));
+        assert(strcmp(sample.zone, "Etc/GMT+5") == 0);
+        frame[offset] ^= 1;
+    }
+
+    frame[112] = 0;
+    assert(sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    frame[112] = 0x80;
+    assert(sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    frame[112] = '\n';
+    assert(sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    memset(frame + 112, 'A', 512);
+    assert(sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    frame[623] = 0;
+    assert(!sf_timesync_parse_sample(frame, sizeof(sf_time_reply), sf_test_id, &sample));
+    assert(strlen(sample.zone) == 511);
+}
+
+int main(void)
+{
+    sf_test_requests();
+    sf_test_policy();
+    sf_test_sample();
+    puts("PASS request bytes, reply headers, policy and sample data, malformed replies");
+    return 0;
+}
