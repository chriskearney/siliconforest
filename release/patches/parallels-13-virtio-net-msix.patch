+bool IOVirtIONet::sf_setupInterrupts()
+{
+    int sources[3];
+    unsigned count = 0;
+    int type;
+    for (int i = 0; count < 3 && fPCIDevice->getInterruptType(i, &type) == kIOReturnSuccess; i++)
+        if (type & kIOInterruptTypePCIMessaged)
+            sources[count++] = i;
+    if (count != 3)
+        return false;
+
+    for (unsigned i = 0; i < 3; i++) {
+        fIrq[i] = IOInterruptEventSource::interruptEventSource(this, &IOVirtIONet::sf_interrupt,
+                                                             fPCIDevice, sources[i]);
+        if (!fIrq[i] || fWorkLoop->addEventSource(fIrq[i]) != kIOReturnSuccess) {
+            sf_removeInterrupts();
+            return false;
+        }
+        fIrq[i]->enable();
+    }
+
+    if (!fTransport.sf_msixEnabled() ||
+        !fTransport.setMsixVectors(&fRxQ, 1, 0) ||
+        !fTransport.setMsixVectors(&fTxQ, 2, 0)) {
+        sf_removeInterrupts();
+        return false;
+    }
+
+    return true;
+}
+
+void IOVirtIONet::sf_removeInterrupts()
+{
+    for (auto &source : fIrq) {
+        if (source) {
+            source->disable();
+            fWorkLoop->removeEventSource(source);
+            OSSafeReleaseNULL(source);
+        }
+    }
+}
+
+void IOVirtIONet::sf_interrupt(OSObject *owner, IOInterruptEventSource *source, int)
+{
+    auto *self = static_cast<IOVirtIONet *>(owner);
+    for (unsigned i = 0; i < 3; i++) {
+        if (source != self->fIrq[i])
+            continue;
+        if (i == 1)
+            self->pollReceive();
+        else if (i == 2)
+            self->sf_reapTx();
+        return;
+    }
+}
