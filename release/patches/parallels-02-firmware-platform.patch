+#if defined(QEMUVIRT)
+static bool
+sf_is_qemu_virt(void)
+{
+	DTEntry root;
+	const void *platform;
+	unsigned int size;
+	static const char qemu[] = "qemu-virt";
+
+	return SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
+	       SecureDTGetProperty(root, "sf,firmware-platform", &platform, &size) == kSuccess &&
+	       size == sizeof(qemu) && memcmp(platform, qemu, sizeof(qemu)) == 0;
+}
+#endif
+
 static void
 check_for_panic_log(void)
 {
 #ifdef PLATFORM_PANIC_LOG_PADDR
+#if defined(QEMUVIRT)
+	if (!sf_is_qemu_virt()) {
+		return;
+	}
+#endif
 	gPanicBase = ml_io_map_wcomb(PLATFORM_PANIC_LOG_PADDR, PLATFORM_PANIC_LOG_SIZE);
 	panic_text_len = PLATFORM_PANIC_LOG_SIZE - sizeof(struct embedded_panic_header);
 	gPanicSize = PLATFORM_PANIC_LOG_SIZE;
@@ -482,7 +502,7 @@ PE_init_platform(boolean_t vm_initialized, void *args)
 		}
 #if defined(QEMUVIRT)
 		// hw.target as on Apple's virtual platform, which the paravirt stand-ins imitate
-		if (gTargetTypeBuffer[0] == '\0') {
+		if (sf_is_qemu_virt() && gTargetTypeBuffer[0] == '\0') {
 			strlcpy(gTargetTypeBuffer, "VMA2MACOS", sizeof(gTargetTypeBuffer));
 		}
 #endif
