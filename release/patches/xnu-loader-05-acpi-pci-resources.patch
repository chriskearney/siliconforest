+static void sf_qword(uint8_t *desc, uint8_t type, uint8_t flags, uint64_t granularity,
+                     uint64_t min, uint64_t max, uint64_t translation, uint64_t size)
+{
+  const uint8_t header[] = {0x8a, 43, 0, type, 0, flags};
+  memcpy(desc, header, sizeof(header));
+  sf_put_le(desc + 6, granularity, 8);
+  sf_put_le(desc + 14, min, 8);
+  sf_put_le(desc + 22, max, 8);
+  sf_put_le(desc + 30, translation, 8);
+  sf_put_le(desc + 38, size, 8);
+}
+
+static void sf_check_pci(const SfAcpiBoard *board)
+{
+  uint8_t resources[3 * 46 + 2] = {0};
+  sf_qword(resources, 0, 0, 32, 0x10000000, 0x1fffffff, 0, 0x10000000);
+  sf_qword(resources + 46, 1, 0, 0, 0x02400000, 0x024fffff,
+           UINT64_C(0xfffffffffdc00000), 0x100000);
+  sf_qword(resources + 92, 2, 0, 0, 0, 0, 0, 1);
+  resources[138] = 0x79;
+
+  const uint32_t reg[] = {0, 0x02300000, 0, 0x100000};
+  const uint32_t ranges[][7] = {
+    {0x02000000, 0, 0x10000000, 0, 0x10000000, 0, 0x10000000},
+    {0x01000000, 0, 0,          0, 0x02400000, 0, 0x100000},
+  };
+  SfAcpiPciTree tree = {0};
+  assert(sf_acpi_pci_tree(board, 0, resources, sizeof(resources), &tree) == NULL);
+  assert(memcmp(tree.reg, reg, sizeof(reg)) == 0);
+  assert(tree.bus_range[0] == 0 && tree.bus_range[1] == 0);
+  assert(tree.range_count == 2 && memcmp(tree.ranges, ranges, sizeof(ranges)) == 0);
+  assert(tree.msi_reg[0] == 0x02250000 && tree.msi_reg[1] == 0x1000);
+  assert(tree.msi_spi_base == 0 && tree.msi_spi_count == 0);
+
+  assert(sf_acpi_pci_tree(board, 1, resources, sizeof(resources), &tree) != NULL);
+  assert(sf_acpi_pci_tree(board, 0, resources, sizeof(resources) - 1, &tree) != NULL);
+  assert(sf_acpi_pci_tree(board, 0, resources + 92, sizeof(resources) - 92, &tree) != NULL);
+  resources[1] = 42;
+  assert(sf_acpi_pci_tree(board, 0, resources, sizeof(resources), &tree) != NULL);
+  assert(memcmp(tree.reg, reg, sizeof(reg)) == 0);
+  assert(tree.range_count == 2 && memcmp(tree.ranges, ranges, sizeof(ranges)) == 0);
+  /* Segment 0 Configuration() reported this memory window and bus range. */
+  uint8_t captured[2 * 46 + 2] = {0};
+  sf_qword(captured, 0, 0, 32, 0x10000000, 0x140fffff, 0, 0x4100000);
+  sf_qword(captured + 46, 2, 0, 0, 0, 0, 0, 1);
+  captured[92] = 0x79;
+  const uint32_t captured_range[] = {0x02000000, 0, 0x10000000, 0, 0x10000000, 0, 0x4100000};
+  assert(sf_acpi_pci_tree(board, 0, captured, sizeof(captured), &tree) == NULL);
+  assert(tree.range_count == 1 && memcmp(tree.ranges[0], captured_range, sizeof(captured_range)) == 0);
+  assert(memcmp(tree.reg, reg, sizeof(reg)) == 0);
+
+  SfAcpiBoard wider = *board;
+  wider.pci_bus_last = 255;
+  wider.ecam_length = UINT64_C(0x10000000);
+  assert(sf_acpi_pci_tree(&wider, 0, captured, sizeof(captured), &tree) == NULL);
+  assert(tree.bus_range[0] == 0 && tree.bus_range[1] == 255);
+  sf_qword(captured + 46, 2, 0, 0, 0, 1, 0, 2);
+  assert(sf_acpi_pci_tree(board, 0, captured, sizeof(captured), &tree) != NULL);
+  wider.pci_bus_first = 1;
+  wider.ecam_length -= UINT64_C(0x100000);
+  assert(sf_acpi_pci_tree(&wider, 0, captured, sizeof(captured), &tree) != NULL);
+}
