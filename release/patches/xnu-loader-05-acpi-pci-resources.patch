+static const char *sf_read_mcfg(SfAcpiTable table, SfAcpiBoard *board)
+{
+  if (table.bytes == NULL)
+    return NULL;
+  if (table.length != 60)
+    return "MCFG requires one ECAM allocation";
+
+  uint64_t base = sf_le(table.bytes + 44, 8);
+  uint8_t first = table.bytes[54], last = table.bytes[55];
+  uint64_t end = ((uint64_t)last + 1) << 20;
+  if (first > last || base == 0 || (base & 0xfffff) != 0 || base > UINT64_MAX - end)
+    return "MCFG ECAM range";
+  board->ecam_base = base + ((uint64_t)first << 20);
+  board->ecam_length = ((uint64_t)last - first + 1) << 20;
+  board->pci_segment = (uint16_t)sf_le(table.bytes + 52, 2);
+  board->pci_bus_first = first;
+  board->pci_bus_last = last;
+  return NULL;
+}
+
+const char *sf_acpi_pci_tree(const SfAcpiBoard *board, uint32_t segment,
+                            const uint8_t *resources, size_t length, SfAcpiPciTree *tree)
+{
+  if (board->ecam_length == 0 || board->pci_segment != segment)
+    return "MCFG has no matching root bridge";
+  SfAcpiPciTree translated = {
+    .reg = {(uint32_t)(board->ecam_base >> 32), (uint32_t)board->ecam_base,
+            0, (uint32_t)board->ecam_length},
+    .bus_range = {board->pci_bus_first, board->pci_bus_last},
+  };
+  if (board->msi_frame_base != 0) {
+    if ((board->msi_frame_base & 0xfff) != 0 || board->msi_frame_base > UINT64_MAX - 0x1000)
+      return "MADT MSI frame range";
+    translated.msi_reg[0] = board->msi_frame_base;
+    translated.msi_reg[1] = 0x1000;
+    if (board->msi_frame_flags & 1) {
+      translated.msi_spi_base = board->msi_spi_base;
+      translated.msi_spi_count = board->msi_spi_count;
+    }
+  }
+
+  bool bus_found = false;
+  while (length >= 2 && resources[0] != 0x79) {
+    enum { QWORD_BYTES = 46 };
+    if (length < QWORD_BYTES || resources[0] != 0x8a || sf_le(resources + 1, 2) != 43)
+      return "EFI root bridge resource descriptor";
+    const uint8_t *desc = resources;
+    resources += QWORD_BYTES;
+    length -= QWORD_BYTES;
+    uint8_t type = desc[3];
+    uint64_t min = sf_le(desc + 14, 8);
+    uint64_t max = sf_le(desc + 22, 8);
+    uint64_t translation = sf_le(desc + 30, 8);
+    uint64_t size = sf_le(desc + 38, 8);
+    if (size == 0)
+      continue;
+    if (max < min || max - min != size - 1)
+      return "EFI root bridge resource range";
+    if (type == 2) {
+      if (bus_found || translation != 0 || min < board->pci_bus_first || max > board->pci_bus_last)
+        return "EFI root bridge bus range falls outside MCFG";
+      bus_found = true;
+      continue;
+    }
+    if (type > 1 || translated.range_count == SF_ACPI_PCI_MAX_WINDOWS)
+      return "EFI root bridge window type or count";
+
+    uint64_t pci = min + translation;
+    if (((translation >> 63) == 0 ? pci < min : pci > min) || size - 1 > UINT64_MAX - pci)
+      return "EFI root bridge address translation";
+    uint64_t width = sf_le(desc + 6, 8);
+    if (type == 0 && width != 32 && width != 64)
+      return "EFI root bridge memory width";
+    uint32_t space = type == 1 ? 0x01000000 : width == 32 ? 0x02000000 : 0x03000000;
+    if (type == 0 && (desc[5] & 6) == 6)
+      space |= 0x40000000;
+    uint32_t *cells = translated.ranges[translated.range_count++];
+    cells[0] = space;
+    cells[1] = (uint32_t)(pci >> 32);
+    cells[2] = (uint32_t)pci;
+    cells[3] = (uint32_t)(min >> 32);
+    cells[4] = (uint32_t)min;
+    cells[5] = (uint32_t)(size >> 32);
+    cells[6] = (uint32_t)size;
+  }
+  if (length < 2 || resources[0] != 0x79)
+    return "EFI root bridge resource end tag";
+  if (translated.range_count == 0)
+    return "EFI root bridge supplied no windows";
+  if (!bus_found)
+    return "EFI root bridge supplied no bus range";
+
+  *tree = translated;
+  return NULL;
+}
