@@ -2050,6 +2060,25 @@ EFI_STATUS dt_build(
   dt_add_child(ctx, root, cpus);
   dt_add_child(ctx, root, armio);
 #if defined(XNU_LOADER_PLATFORM_GENERIC)
+  if (sf_acpi_boot && pci) {
+    dt_prop_u32(ctx, root, "#address-cells", 2);
+    dt_prop_u32(ctx, root, "#size-cells", 2);
+    const SfAcpiPciTree *host = &sf_acpi_pci_tree_data;
+    if (host->msi_reg[1] != 0) {
+      DeviceTreeNode *frame = dt_create_node(ctx);
+      UINT32 reg[] = {host->msi_reg[0] >> 32, host->msi_reg[0], 0, host->msi_reg[1]};
+      dt_prop_str(ctx, frame, "name", "msi-controller");
+      dt_prop_str(ctx, frame, "compatible", "arm,gic-v2m-frame");
+      dt_prop(ctx, frame, "reg", reg, sizeof(reg));
+      dt_prop(ctx, frame, "msi-controller", NULL, 0);
+      dt_prop_u32(ctx, frame, "AAPL,phandle", SF_MSI_FRAME_PHANDLE);
+      if (host->msi_spi_count != 0) {
+        dt_prop_u32(ctx, frame, "arm,msi-base-spi", host->msi_spi_base);
+        dt_prop_u32(ctx, frame, "arm,msi-num-spis", host->msi_spi_count);
+      }
+      dt_add_child(ctx, root, frame);
+    }
+  }
   if (pci)
     dt_add_child(ctx, root, pci);
 #if defined(XNU_LOADER_PLATFORM_SC8280XP)
