arm64: Publish the EFI PCI host and GICv2m frame

diff --git a/src/app.c b/src/app.c
index d85a811..d61c0bf 100644
--- a/src/app.c
+++ b/src/app.c
@@ -3,9 +3,11 @@
 #include "serial.h"
 #include "platform.h"
 #include "acpi_board.h"
+#include <efipciio.h>
 
 bool sf_acpi_boot;
 SfAcpiTree sf_acpi_tree_data;
+SfAcpiPciTree sf_acpi_pci_tree_data;
 
 #if defined(__aarch64__) && defined(XNU_LOADER_PLATFORM_GENERIC) && !defined(LEGACY_BIOS)
 typedef struct {
@@ -80,6 +82,67 @@ static const char *sf_read_efi_acpi(AppContext *ctx, SfAcpiBoard *board, bool *u
   return "EFI GetMemoryMap failed";
 }
 
+static EFI_STATUS sf_read_pci_root(AppContext *ctx, const SfAcpiBoard *board)
+{
+  if (board->ecam_length == 0)
+    return EFI_SUCCESS;
+
+  EFI_GUID guid = EFI_PCI_ROOT_BRIDGE_IO_PROTOCOL_GUID;
+  EFI_HANDLE *handles = NULL;
+  UINTN count = 0;
+  EFI_STATUS status = uefi_call_wrapper(ctx->bs->LocateHandleBuffer, 5,
+                                       ByProtocol, &guid, NULL, &count, &handles);
+  if (EFI_ERROR(status)) {
+    log_error(L"PCI: EFI root bridge discovery: %r\r\n", status);
+    return status;
+  }
+
+  const char *error = "no EFI root bridge for MCFG segment";
+  bool found = false;
+  for (UINTN i = 0; i < count; i++) {
+    EFI_PCI_ROOT_BRIDGE_IO_PROTOCOL *root = NULL;
+    status = uefi_call_wrapper(ctx->bs->HandleProtocol, 3, handles[i], &guid, (VOID **)&root);
+    if (EFI_ERROR(status) || root == NULL) {
+      log_error(L"PCI: EFI root bridge HandleProtocol: %r\r\n", status);
+      error = "EFI root bridge handle unavailable";
+      break;
+    }
+    if (root->SegmentNumber != board->pci_segment)
+      continue;
+    if (found) {
+      error = "multiple EFI root bridges in MCFG segment";
+      break;
+    }
+    VOID *resources = NULL;
+    status = uefi_call_wrapper(root->Configuration, 2, root, &resources);
+    if (EFI_ERROR(status) || resources == NULL) {
+      log_error(L"PCI: EFI root bridge Configuration: %r\r\n", status);
+      error = "EFI root bridge supplied no resource descriptors";
+      break;
+    }
+    /* Configuration returns a firmware-owned list terminated by an ACPI End Tag.
+     * The maximum covers the bus range, I/O, and both memory widths with and
+     * without prefetching. The reader stops at the End Tag. */
+    enum { RESOURCE_LIMIT = (SF_ACPI_PCI_MAX_WINDOWS + 1) * 46 + 2 };
+    error = sf_acpi_pci_tree(board, root->SegmentNumber, resources, RESOURCE_LIMIT,
+                             &sf_acpi_pci_tree_data);
+    if (error != NULL)
+      break;
+    found = true;
+  }
+  uefi_call_wrapper(ctx->bs->FreePool, 1, handles);
+  if (error != NULL) {
+    log_error(L"PCI: %a\r\n", error);
+    return EFI_COMPROMISED_DATA;
+  }
+
+  log_info(L"PCI: MCFG segment %u, buses %u-%u, ECAM 0x%lx+0x%lx, EFI windows %lu\r\n",
+           (UINT32)board->pci_segment, (UINT32)board->pci_bus_first,
+           (UINT32)board->pci_bus_last, board->ecam_base, board->ecam_length,
+           (UINT64)sf_acpi_pci_tree_data.range_count);
+  return EFI_SUCCESS;
+}
+
 static EFI_STATUS sf_start_acpi_console(AppContext *ctx, bool fdt_present)
 {
   SfAcpiBoard board;
@@ -132,7 +195,7 @@ static EFI_STATUS sf_start_acpi_console(AppContext *ctx, bool fdt_present)
   log_info(L"FADT PSCI conduit %a ARM flags 0x%x\r\n",
            board.psci == SF_ACPI_PSCI_HVC ? "HVC" : "SMC", (UINT32)board.arm_boot_flags);
   log_info(L"Current EL %u\r\n", (UINT32)((current_el >> 2) & 3));
-  return EFI_SUCCESS;
+  return sf_read_pci_root(ctx, &board);
 }
 #endif
 
