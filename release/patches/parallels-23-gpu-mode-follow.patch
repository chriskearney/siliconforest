+// the steps of a framebuffer replacement (SFVirtIOGPUMode.h) on this driver, run with fModeLock held
+struct IOVirtIOGPU::ModeSteps {
+    IOVirtIOGPU *gpu;
+    IOReturn     error;
+
+    bool prepare(uint32_t width, uint32_t height)
+    {
+        size_t bytes = round_page((size_t)width * 4 * height);
+        IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(
+            kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous, bytes, 0xFFFFFFFFULL);
+
+        if (!mem) {
+            error = kIOReturnNoMemory;
+            return false;
+        }
+        bzero(mem->getBytesNoCopy(), bytes);
+
+        uint32_t resourceId = gpu->allocResourceId();
+
+        if (!gpu->gpuCreateResource2D(resourceId, width, height) ||
+            !gpu->gpuAttachBacking(resourceId, mem->getPhysicalAddress(), (uint32_t)bytes)) {
+            gpu->gpuResourceUnref(resourceId);
+            mem->release();
+            error = kIOReturnNoResources;
+            return false;
+        }
+        gpu->fSpareMem = mem;
+        gpu->fSpareResource = resourceId;
+        return true;
+    }
+
+    sf_vgpu_reply show_prepared(uint32_t width, uint32_t height)
+    {
+        gpu->setModeChanging(true);
+        sf_vgpu_reply reply = gpu->gpuSetScanoutReply(0, gpu->fSpareResource, width, height);
+
+        if (reply != sf_vgpu_ok) {
+            gpu->setModeChanging(false);
+            error = reply == sf_vgpu_refused ? kIOReturnError : kIOReturnTimeout;
+        }
+        return reply;
+    }
+
+    // what the scanout showed before, which may be a client's resource
+    sf_vgpu_reply show_published()
+    {
+        IOLockLock(gpu->fCtrlLock);
+        uint32_t resourceId = gpu->fScanoutResourceId;
+        uint32_t width = gpu->fScanoutWidth, height = gpu->fScanoutHeight;
+        IOLockUnlock(gpu->fCtrlLock);
+
+        sf_vgpu_reply reply = gpu->gpuSetScanoutReply(0, resourceId, width, height);
+
+        if (reply == sf_vgpu_ok)
+            gpu->gpuResourceFlush(resourceId, 0, 0, width, height);
+        return reply;
+    }
+
+    void discard_prepared()
+    {
+        gpu->gpuResourceUnref(gpu->fSpareResource);
+        gpu->fSpareMem->release();
+        gpu->fSpareMem = NULL;
+        gpu->fSpareResource = 0;
+    }
+
+    // the new framebuffer becomes the mode, the old one goes once nothing shows it
+    void publish(uint32_t width, uint32_t height)
+    {
+        IODisplayModeID mode = gpu->modeForSize(width, height);
+
+        IOLockLock(gpu->fCtrlLock);
+        IOBufferMemoryDescriptor *oldMem = gpu->fFbMem;
+        uint32_t oldResource = gpu->fResourceId;
+
+        gpu->fFbMem = gpu->fSpareMem;
+        gpu->fFbBase = gpu->fFbMem->getBytesNoCopy();
+        gpu->fFbPhys = gpu->fFbMem->getPhysicalAddress();
+        gpu->fWidth = width;
+        gpu->fHeight = height;
+        gpu->fPitch = width * 4;
+        gpu->fResourceId = gpu->fSpareResource;
+        gpu->fScanoutResourceId = gpu->fSpareResource;
+        gpu->fScanoutWidth = width;
+        gpu->fScanoutHeight = height;
+        if (mode == sf_vgpu_host_mode) {
+            gpu->fHostModeWidth = width;
+            gpu->fHostModeHeight = height;
+        }
+        gpu->fModeID = mode;
+        gpu->fModeGeneration++;
+        // a region queued for the old framebuffer is no region of this one
+        gpu->fPresentPending = false;
+        gpu->fSpareMem = NULL;
+        gpu->fSpareResource = 0;
+        IOLockUnlock(gpu->fCtrlLock);
+
+        // the flip pair is the old size, the presenter's next flip is refused
+        gpu->presenterLost(0);
+        gpu->gpuTransferToHost2D(gpu->fResourceId, 0, 0, width, height);
+        gpu->gpuResourceFlush(gpu->fResourceId, 0, 0, width, height);
+
+        // the kernel console draws into the framebuffer too, it follows to the new one
+#if !defined(__arm64__) && !defined(__aarch64__)
+        IOPlatformExpert *pe = gpu->getPlatform();
+
+        if (pe) {
+            PE_Video consoleInfo;
+
+            bzero(&consoleInfo, sizeof(consoleInfo));
+            consoleInfo.v_baseAddr = (unsigned long)gpu->fFbBase;
+            consoleInfo.v_width = width;
+            consoleInfo.v_height = height;
+            consoleInfo.v_depth = 32;
+            consoleInfo.v_rowBytes = gpu->fPitch;
+            consoleInfo.v_display = kPEGraphicsMode;
+            consoleInfo.v_scale = kPEScaleFactor1x;
+            pe->setConsoleInfo(&consoleInfo, kPEGraphicsMode);
+        }
+#endif
+
+        gpu->setModeChanging(false);
+
+        // a client that mapped the old framebuffer keeps it alive through its mapping until it remaps
+        gpu->gpuResourceUnref(oldResource);
+        if (oldMem)
+            oldMem->release();
+        IOLog("IOVirtIOGPU: display mode %d, %ux%u\n", (int)mode, width, height);
+    }
+};
