+sf_vgpu_mode_state
+IOVirtIOGPU::modeState() const
+{
+    sf_vgpu_mode_state state = { fWidth, fHeight, fPendingWidth, fPendingHeight };
+    return state;
+}
+
+void
+IOVirtIOGPU::setModeChanging(bool changing)
+{
+    IOLockLock(fCtrlLock);
+    fModeChanging = changing;
+    IOLockUnlock(fCtrlLock);
+}
+
+uint32_t
+IOVirtIOGPU::modeGeneration()
+{
+    IOLockLock(fCtrlLock);
+    uint32_t generation = fModeGeneration;
+    IOLockUnlock(fCtrlLock);
+    return generation;
+}
