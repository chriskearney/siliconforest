diff --git a/src/Kernel/Extensions/IOVirtIOGPU/SFVirtIOGPUMode.h b/src/Kernel/Extensions/IOVirtIOGPU/SFVirtIOGPUMode.h
new file mode 100644
index 0000000..2f49152
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOGPU/SFVirtIOGPUMode.h
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#pragma once
+
+#include <stdint.h>
+
+// The primary framebuffer follows the size the host asks scanout 0 to have, within these bounds.
+enum : uint32_t {
+    sf_vgpu_min_width = 640,
+    sf_vgpu_min_height = 480,
+    sf_vgpu_max_width = 3840,
+    sf_vgpu_max_height = 2160,
+    // the mode id of a host size that is not in the mode list
+    sf_vgpu_host_mode = 0x100,
+};
+
+// How the host answered a SET_SCANOUT. Without a reply the host may show either resource.
+enum sf_vgpu_reply { sf_vgpu_ok, sf_vgpu_refused, sf_vgpu_no_reply };
+
+// What a framebuffer replacement left behind.
+enum sf_vgpu_outcome {
+    sf_vgpu_published,   // the new framebuffer is the mode, the old one is released
+    sf_vgpu_rolled_back, // the new one is released, the old mode stays and its scanout is set again
+    sf_vgpu_pending,     // SET_SCANOUT got no reply: both are kept and the old mode stays published
+    sf_vgpu_unsettled,   // an earlier pending replacement is still unsettled, nothing was tried
+};
+
+// The published mode, and the size of a replacement whose SET_SCANOUT has no known outcome.
+struct sf_vgpu_mode_state {
+    uint32_t width, height;
+    uint32_t pending_width, pending_height;
+};
+
+inline bool sf_vgpu_size_allowed(uint32_t width, uint32_t height)
+{
+    return width >= sf_vgpu_min_width && height >= sf_vgpu_min_height &&
+           width <= sf_vgpu_max_width && height <= sf_vgpu_max_height;
+}
+
+// The mode ids on offer, into room for capacity ids: the listed modes 1 to listed, then the host mode
+// once a host size was published. *count is how many there are; when they do not all fit, false and
+// nothing is written.
+template <class Id>
+bool sf_vgpu_mode_ids(uint32_t listed, bool host_mode, Id *ids, uint32_t capacity, uint32_t *count)
+{
+    *count = listed + (host_mode ? 1 : 0);
+    if (*count > capacity)
+        return false;
+    for (uint32_t i = 0; i < listed; i++)
+        ids[i] = (Id)(i + 1);
+    if (host_mode)
+        ids[listed] = (Id)sf_vgpu_host_mode;
+    return true;
+}
+
+// A pending replacement is settled by setting the published framebuffer on the scanout again: once
+// the host has answered that, the other resource is shown nowhere and may go.
+template <class Steps>
+bool sf_vgpu_settle(Steps &steps, sf_vgpu_mode_state &state)
+{
+    if (state.pending_width == 0)
+        return true;
+    if (steps.show_published() != sf_vgpu_ok)
+        return false;
+    steps.discard_prepared();
+    state.pending_width = state.pending_height = 0;
+    return true;
+}
+
+// Replace the framebuffer with one of width x height. Steps: prepare (allocate, create and attach,
+// undoing its own work when it fails), show_prepared (SET_SCANOUT of the new resource), publish (make
+// it the mode and release the old one), discard_prepared and show_published.
+template <class Steps>
+sf_vgpu_outcome sf_vgpu_replace(Steps &steps, sf_vgpu_mode_state &state, uint32_t width, uint32_t height)
+{
+    if (!sf_vgpu_settle(steps, state))
+        return sf_vgpu_unsettled;
+    if (!steps.prepare(width, height)) {
+        steps.show_published();
+        return sf_vgpu_rolled_back;
+    }
+    switch (steps.show_prepared(width, height)) {
+    case sf_vgpu_ok:
+        steps.publish(width, height);
+        state.width = width;
+        state.height = height;
+        return sf_vgpu_published;
+    case sf_vgpu_refused:
+        steps.discard_prepared();
+        steps.show_published();
+        return sf_vgpu_rolled_back;
+    case sf_vgpu_no_reply:
+        break;
+    }
+    state.pending_width = width;
+    state.pending_height = height;
+    return sf_vgpu_pending;
+}
+
+// A display event: follow a new host size on scanout 0 (0 x 0 when the host has it off). False when
+// nothing was changed or sent, and the caller points the scanout at the current framebuffer as before.
+template <class Steps>
+bool sf_vgpu_follow(Steps &steps, sf_vgpu_mode_state &state, uint32_t width, uint32_t height)
+{
+    if (!sf_vgpu_settle(steps, state))
+        return true;
+    if (!sf_vgpu_size_allowed(width, height) || (width == state.width && height == state.height))
+        return false;
+    sf_vgpu_replace(steps, state, width, height);
+    return true;
+}
diff --git a/src/Kernel/Extensions/IOVirtIOGPU/tests/mode_test.cpp b/src/Kernel/Extensions/IOVirtIOGPU/tests/mode_test.cpp
new file mode 100644
index 0000000..eeba82f
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOGPU/tests/mode_test.cpp
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#include "../SFVirtIOGPUMode.h"
+
+#include <assert.h>
+#include <stdio.h>
+
+namespace {
+
+// The driver's resources as the steps see them: the published framebuffer, a prepared one, and what
+// the host shows on scanout 0. Each step can be made to fail once.
+struct Device {
+    sf_vgpu_mode_state state = {1024, 768, 0, 0};
+    unsigned published = 1, prepared = 0, shown = 1, next = 2;
+    unsigned backings = 1, sent = 0, reasserted = 0;
+    bool refuse_create = false;
+    sf_vgpu_reply scanout_reply = sf_vgpu_ok, reassert_reply = sf_vgpu_ok;
+
+    bool prepare(uint32_t, uint32_t)
+    {
+        sent++;
+        if (refuse_create) {
+            refuse_create = false;
+            return false;
+        }
+        prepared = next++;
+        backings++;
+        return true;
+    }
+    sf_vgpu_reply show_prepared(uint32_t, uint32_t)
+    {
+        sent++;
+        sf_vgpu_reply reply = scanout_reply;
+        scanout_reply = sf_vgpu_ok;
+        if (reply != sf_vgpu_refused)
+            shown = prepared;
+        return reply;
+    }
+    sf_vgpu_reply show_published()
+    {
+        sent++;
+        reasserted++;
+        sf_vgpu_reply reply = reassert_reply;
+        reassert_reply = sf_vgpu_ok;
+        if (reply != sf_vgpu_refused)
+            shown = published;
+        return reply;
+    }
+    void publish(uint32_t, uint32_t)
+    {
+        published = prepared;
+        prepared = 0;
+        backings--;
+    }
+    void discard_prepared()
+    {
+        assert(prepared != 0 && shown != prepared);
+        prepared = 0;
+        backings--;
+    }
+    bool follow(uint32_t width, uint32_t height) { return sf_vgpu_follow(*this, state, width, height); }
+    bool at(uint32_t width, uint32_t height) const
+    {
+        return state.width == width && state.height == height && shown == published && prepared == 0 &&
+               backings == 1 && state.pending_width == 0;
+    }
+};
+
+}
+
+int main()
+{
+    Device d;
+
+    // larger, smaller and back: each is a new framebuffer, the old one released
+    assert(d.follow(1187, 885) && d.at(1187, 885) && d.published == 2);
+    assert(d.follow(1024, 851) && d.at(1024, 851) && d.published == 3);
+    assert(d.follow(1024, 768) && d.at(1024, 768) && d.published == 4);
+
+    // the same size again, the scanout off, and sizes outside the bounds change nothing and send nothing
+    d.sent = 0;
+    assert(!d.follow(1024, 768) && !d.follow(0, 0) && !d.follow(5000, 900) && !d.follow(1024, 300));
+    assert(d.sent == 0 && d.at(1024, 768) && d.published == 4);
+    assert(sf_vgpu_size_allowed(640, 480) && sf_vgpu_size_allowed(3840, 2160));
+    assert(!sf_vgpu_size_allowed(639, 480) && !sf_vgpu_size_allowed(3840, 2161));
+
+    // a refused create keeps the mode and sets its framebuffer on the scanout again
+    d.refuse_create = true;
+    d.reasserted = 0;
+    assert(d.follow(1280, 900) && d.at(1024, 768) && d.published == 4 && d.reasserted == 1);
+
+    // a refused SET_SCANOUT releases the new framebuffer and shows the old one again
+    d.scanout_reply = sf_vgpu_refused;
+    d.reasserted = 0;
+    assert(d.follow(1280, 900) && d.at(1024, 768) && d.published == 4 && d.reasserted == 1);
+
+    // no reply: both framebuffers stay and the old mode stays published
+    d.scanout_reply = sf_vgpu_no_reply;
+    assert(d.follow(1280, 900));
+    assert(d.state.width == 1024 && d.state.height == 768 && d.state.pending_width == 1280);
+    assert(d.published == 4 && d.prepared != 0 && d.backings == 2);
+
+    // while the old framebuffer cannot be shown again, the next size is not tried
+    d.reassert_reply = sf_vgpu_no_reply;
+    d.sent = 0;
+    assert(d.follow(1400, 1000));
+    assert(d.sent == 1 && d.state.width == 1024 && d.state.pending_width == 1280 && d.backings == 2);
+    d.reassert_reply = sf_vgpu_refused;
+    assert(d.follow(1400, 1000) && d.state.pending_width == 1280 && d.backings == 2);
+
+    // settled: the pending framebuffer goes, then the new size is followed
+    assert(d.follow(1400, 1000) && d.at(1400, 1000));
+
+    // settled by an event for the published size itself: nothing else to do
+    d.scanout_reply = sf_vgpu_no_reply;
+    assert(d.follow(1500, 1000) && d.state.pending_width == 1500);
+    assert(!d.follow(1400, 1000) && d.at(1400, 1000));
+
+    // a mode set by a client runs the same replacement and settles first too
+    d.scanout_reply = sf_vgpu_no_reply;
+    assert(sf_vgpu_replace(d, d.state, 1600, 900) == sf_vgpu_pending);
+    d.reassert_reply = sf_vgpu_no_reply;
+    assert(sf_vgpu_replace(d, d.state, 1920, 1080) == sf_vgpu_unsettled && d.state.pending_width == 1600);
+    assert(sf_vgpu_replace(d, d.state, 1920, 1080) == sf_vgpu_published && d.at(1920, 1080));
+
+    // the mode ids: the listed ones from 1, then the host mode once a host size was published
+    int32_t ids[5] = {-1, -1, -1, -1, -1};
+    uint32_t count = 0;
+    assert(sf_vgpu_mode_ids(3, false, ids, 3, &count) && count == 3);
+    assert(ids[0] == 1 && ids[1] == 2 && ids[2] == 3 && ids[3] == -1);
+    // room for the 3 counted before a host size was published: the 4 are refused and nothing is written
+    for (int32_t &id : ids)
+        id = -1;
+    assert(!sf_vgpu_mode_ids(3, true, ids, 3, &count) && count == 4);
+    for (int32_t id : ids)
+        assert(id == -1);
+    assert(sf_vgpu_mode_ids(3, true, ids, 4, &count) && count == 4);
+    assert(ids[0] == 1 && ids[2] == 3 && ids[3] == (int32_t)sf_vgpu_host_mode && ids[4] == -1);
+
+    puts("scanout 0 mode follow, rollback, pending settle and mode ids passed");
+}
