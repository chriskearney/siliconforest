+    /// The panel's framebuffer took another size between frames (the host resized its display,
+    /// output.rs `Output::follow_mode`): the scene and the panel's `wl_output` mode, the desk's
+    /// chrome and work areas, the layer surfaces and the pointer follow, and the next frame is
+    /// drawn whole. Clients and their windows stay. When the scene cannot take the size, nothing
+    /// is advertised and the error ends the frame.
+    pub fn resize_panel(&mut self, size: Size) -> Result<(), String> {
+        let mut outputs = self.scene_outputs();
+        for o in outputs.iter_mut().filter(|o| o.kind == OutputKind::Internal) {
+            let (pos, primary) = (o.rect.pos, o.primary);
+            *o = SceneOutput { primary, ..SceneOutput::panel(size, self.scale()) };
+            o.rect.pos = pos;
+        }
+        self.set_scene_outputs(&outputs)
+            .map_err(|error| format!("WMOUTPUT panel {}x{} not applied to the scene: {error}", size.w, size.h))?;
+        let mode = Mode { size: (size.w as i32, size.h as i32).into(), refresh: 0 };
+        self.output.set_preferred(mode);
+        self.output.change_current_state(Some(mode), None, None, None);
+        // smithay keeps every mode it was given for clients that bind later: the panel has only this one
+        for old in self.output.modes().into_iter().filter(|&m| m != mode) {
+            self.output.delete_mode(old);
+        }
+        let screen = self.wm.backend().screen_size();
+        #[cfg(feature = "desktop-shell")]
+        if let Some(desktop) = self.desktop.as_mut() {
+            desktop.shell.on_screen_resize(&mut self.wm, screen);
+        }
+        // the dock's exclusive zone on the new edges is the work area, as at start
+        self.layers_relayout();
+        if let Some(pointer) = &self.pointer_shared {
+            pointer.set_screen(screen.w, screen.h);
+        }
+        self.renderer.invalidate();
+        self.wm.backend_mut().dirty = true;
+        eprintln!("WMOUTPUT panel resized to {}x{} screen={}x{}", size.w, size.h, screen.w, screen.h);
+        Ok(())
+    }
