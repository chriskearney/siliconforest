+    /// (presenter.rs `Pdgop::follow_mode`).
+    pub fn follow_mode(&mut self) -> Result<Option<Size>, String> {
+        match self {
+            Output::Boot(p) => Ok(p.follow_mode()?.then(|| p.size())),
+            Output::Memory(_) | Output::Gpu => Ok(None),
+        }
+    }
