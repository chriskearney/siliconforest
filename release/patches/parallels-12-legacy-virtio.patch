diff --git a/src/Kernel/Extensions/IOVirtIOFamily/SFVirtIOLegacy.h b/src/Kernel/Extensions/IOVirtIOFamily/SFVirtIOLegacy.h
new file mode 100644
index 0000000..d18122d
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOFamily/SFVirtIOLegacy.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: MIT */
+/* Copyright (c) 2026 SiliconForest contributors */
+#pragma once
+
+enum {
+    sf_virtio_legacy_host_features = 0,
+    sf_virtio_legacy_guest_features = 4,
+    sf_virtio_legacy_queue_pfn = 8,
+    sf_virtio_legacy_queue_size = 12,
+    sf_virtio_legacy_queue_select = 14,
+    sf_virtio_legacy_queue_notify = 16,
+    sf_virtio_legacy_status = 18,
+    sf_virtio_legacy_isr = 19,
+    sf_virtio_legacy_config_vector = 20,
+    sf_virtio_legacy_queue_vector = 22,
+    sf_virtio_legacy_page_size = 4096,
+};
+
+constexpr unsigned sf_virtio_legacy_config_offset(bool msix)
+{
+    return msix ? 24 : 20;
+}
+
+constexpr unsigned sf_virtio_legacy_used_offset(unsigned queueSize)
+{
+    // 16 bytes per descriptor, followed by the available ring and used_event.
+    const unsigned availableEnd = 16 * queueSize + 4 + 2 * queueSize + 2;
+    return (availableEnd + sf_virtio_legacy_page_size - 1) & ~(sf_virtio_legacy_page_size - 1);
+}
