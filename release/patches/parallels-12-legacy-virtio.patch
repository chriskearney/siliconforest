index 0000000..604c981
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOFamily/tests/legacy_layout_test.cpp
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+
+#include <SFVirtIOLegacy.h>
+
+#include <assert.h>
+#include <stdio.h>
+
+int main()
+{
+    assert(sf_virtio_legacy_config_offset(false) == 20);
+    assert(sf_virtio_legacy_config_offset(true) == 24);
+    assert(sf_virtio_legacy_config_vector == 20);
+    assert(sf_virtio_legacy_queue_vector == 22);
+    assert(sf_virtio_legacy_used_offset(32) == 4096);
+    assert(sf_virtio_legacy_used_offset(256) == 8192);
+    puts("legacy configuration offsets and split ring alignment passed");
+}
