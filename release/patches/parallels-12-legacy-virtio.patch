+template <typename T>
+T IOVirtIOTransport::sf_readLegacy(unsigned reg) const
+{
+    if (fLegacyPortIO) {
+        if (sizeof(T) == 1)
+            return static_cast<T>(fPCIDevice->ioRead8(reg, fCommonCfgMap));
+        if (sizeof(T) == 2)
+            return static_cast<T>(fPCIDevice->ioRead16(reg, fCommonCfgMap));
+        return static_cast<T>(fPCIDevice->ioRead32(reg, fCommonCfgMap));
+    }
+    return *reinterpret_cast<volatile T *>(fCommonCfg + reg);
+}
+
+template <typename T>
+void IOVirtIOTransport::sf_writeLegacy(unsigned reg, T value)
+{
+    if (fLegacyPortIO) {
+        if (sizeof(T) == 1)
+            fPCIDevice->ioWrite8(reg, static_cast<uint8_t>(value), fCommonCfgMap);
+        else if (sizeof(T) == 2)
+            fPCIDevice->ioWrite16(reg, static_cast<uint16_t>(value), fCommonCfgMap);
+        else
+            fPCIDevice->ioWrite32(reg, static_cast<uint32_t>(value), fCommonCfgMap);
+    } else {
+        *reinterpret_cast<volatile T *>(fCommonCfg + reg) = value;
+        OSSynchronizeIO();
+    }
+}
+
+bool IOVirtIOTransport::sf_msixEnabled() const
+{
+    return fMsixCapability &&
+        (fPCIDevice->configRead16(static_cast<UInt8>(fMsixCapability + 2)) & 0x8000) != 0;
+}
+
+bool IOVirtIOTransport::sf_attachLegacy()
+{
+    fLegacyPortIO = (fPCIDevice->configRead32(kIOPCIConfigBaseAddress0) & 1) != 0;
+    if (fLegacyPortIO) {
+        fPCIDevice->setIOEnable(true);
+        fCommonCfgMap = fPCIDevice->mapDeviceMemoryWithRegister(kIOPCIConfigBaseAddress0);
+    } else {
+        fCommonCfgMap = mapBar(fPCIDevice, 0);
+    }
+    if (!fCommonCfgMap ||
+        fCommonCfgMap->getLength() < sf_virtio_legacy_config_offset(sf_msixEnabled())) {
+        IOLog("IOVirtIOTransport: cannot map legacy %s BAR 0\n", fLegacyPortIO ? "I/O" : "memory");
+        OSSafeReleaseNULL(fCommonCfgMap);
+        return false;
+    }
+    fCommonCfg = reinterpret_cast<volatile uint8_t *>(fCommonCfgMap->getVirtualAddress());
+    fLegacy = true;
+    sf_writeLegacy<uint8_t>(sf_virtio_legacy_status, 0);
+    for (unsigned attempt = 0; attempt < 1000; attempt++) {
+        if (sf_readLegacy<uint8_t>(sf_virtio_legacy_status) == 0) {
+            sf_writeLegacy<uint8_t>(sf_virtio_legacy_status, VIRTIO_STATUS_ACKNOWLEDGE);
+            sf_writeLegacy<uint8_t>(sf_virtio_legacy_status,
+                                    VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER);
+            IOLog("IOVirtIOTransport: legacy PCI on %s BAR 0\n", fLegacyPortIO ? "I/O" : "memory");
+            return true;
+        }
+        IODelay(100);
+    }
+    IOLog("IOVirtIOTransport: legacy device reset timed out\n");
+    return false;
+}
+
+volatile uint8_t *IOVirtIOTransport::deviceConfig() const
+{
+    if (!fLegacy)
+        return fDeviceCfg;
+    unsigned offset = sf_virtio_legacy_config_offset(sf_msixEnabled());
+    if (fLegacyPortIO || offset >= fCommonCfgMap->getLength())
+        return NULL;
+    return fCommonCfg + offset;
+}
+
+bool IOVirtIOTransport::sf_readDeviceConfig(unsigned offset, void *buffer, size_t length) const
+{
+    auto *out = static_cast<uint8_t *>(buffer);
+    if (!fLegacy) {
+        if (!fDeviceCfg || offset > fDeviceCfgLength || length > fDeviceCfgLength - offset)
+            return false;
+        for (size_t i = 0; i < length; i++)
+            out[i] = fDeviceCfg[offset + i];
+        return true;
+    }
+    unsigned base = sf_virtio_legacy_config_offset(sf_msixEnabled());
+    size_t end = fCommonCfgMap->getLength();
+    if (fLegacyPortIO && end > 65536)
+        end = 65536;
+    if (base > end || offset > end - base || length > end - base - offset)
+        return false;
+    for (size_t i = 0; i < length; i++)
+        out[i] = sf_readLegacy<uint8_t>(base + offset + i);
+    return true;
+}
