+bool IOVirtIOTransport::sf_initLegacyQueue(VirtQueue *vq, uint16_t index)
+{
+    sf_writeLegacy<uint16_t>(sf_virtio_legacy_queue_select, index);
+    uint16_t size = sf_readLegacy<uint16_t>(sf_virtio_legacy_queue_size);
+    if (size == 0 || (size & (size - 1)) != 0 ||
+        sf_readLegacy<uint32_t>(sf_virtio_legacy_queue_pfn) != 0)
+        return false;
+
+    unsigned usedOffset = sf_virtio_legacy_used_offset(size);
+    size_t bytes = usedOffset + sizeof(VRingUsedHdr) + sizeof(VRingUsedElem) * size + sizeof(uint16_t);
+    vq->ringMem = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(
+        kernel_task, kIODirectionInOut | kIOMemoryPhysicallyContiguous, bytes, 0xFFFFF000ULL);
+    if (!vq->ringMem)
+        return false;
+    uint64_t address = vq->ringMem->getPhysicalAddress();
+    if (!address || address % sf_virtio_legacy_page_size != 0 ||
+        address / sf_virtio_legacy_page_size > UINT32_MAX) {
+        OSSafeReleaseNULL(vq->ringMem);
+        return false;
+    }
+    auto *ring = static_cast<uint8_t *>(vq->ringMem->getBytesNoCopy());
+    bzero(ring, bytes);
+    vq->desc = ring;
+    vq->avail = ring + sizeof(VRingDesc) * size;
+    vq->used = ring + usedOffset;
+    vq->queueSize = size;
+    OSSynchronizeIO();
+    sf_writeLegacy<uint32_t>(sf_virtio_legacy_queue_pfn, address / sf_virtio_legacy_page_size);
+    return true;
+}
