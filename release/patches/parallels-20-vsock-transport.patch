diff --git a/src/Kernel/Extensions/IOVirtIOSocket/SFVirtioSocketProtocol.h b/src/Kernel/Extensions/IOVirtIOSocket/SFVirtioSocketProtocol.h
new file mode 100644
index 0000000..c2770a4
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOSocket/SFVirtioSocketProtocol.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace SFVirtioSocket {
+
+constexpr size_t HeaderSize = 44;
+constexpr uint16_t Stream = 1;
+constexpr uint32_t Receive = 1;
+constexpr uint32_t Send = 2;
+constexpr uint32_t Both = Receive | Send;
+
+enum Operation : uint16_t {
+    Request = 1, Response, Reset, Shutdown, Data, CreditUpdate, CreditRequest
+};
+
+struct Packet {
+    uint32_t srcCID, dstCID, srcPort, dstPort, length;
+    uint16_t type, operation;
+    uint32_t flags, buffer, forwarded;
+};
+
+inline uint32_t read32(const uint8_t *p)
+{
+    return p[0] | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+
+inline void write32(uint8_t *p, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; ++i)
+        p[i] = uint8_t(value >> (8 * i));
+}
+
+inline bool validGuestCID(uint32_t cid)
+{
+    return cid > 2 && cid != UINT32_MAX;
+}
+
+inline void encode(uint8_t *p, const Packet &packet)
+{
+    write32(p, packet.srcCID);
+    write32(p + 4, 0);
+    write32(p + 8, packet.dstCID);
+    write32(p + 12, 0);
+    write32(p + 16, packet.srcPort);
+    write32(p + 20, packet.dstPort);
+    write32(p + 24, packet.length);
+    write32(p + 28, packet.type | (uint32_t(packet.operation) << 16));
+    write32(p + 32, packet.flags);
+    write32(p + 36, packet.buffer);
+    write32(p + 40, packet.forwarded);
+}
+
+inline bool decode(const uint8_t *p, size_t length, Packet &packet)
+{
+    if (length < HeaderSize || read32(p + 4) || read32(p + 12))
+        return false;
+
+    const uint32_t typeAndOp = read32(p + 28);
+    packet = {read32(p), read32(p + 8), read32(p + 16), read32(p + 20), read32(p + 24),
+              uint16_t(typeAndOp), uint16_t(typeAndOp >> 16), read32(p + 32),
+              read32(p + 36), read32(p + 40)};
+    return packet.length == length - HeaderSize;
+}
+
+// Unsigned subtraction handles counter wrap. Reject a window smaller than
+// the flight size instead of wrapping the remaining credit.
+inline uint32_t credit(uint32_t allocation, uint32_t transmitted, uint32_t forwarded)
+{
+    const uint32_t outstanding = transmitted - forwarded;
+    return outstanding <= allocation ? allocation - outstanding : 0;
+}
+
+enum class State : uint8_t { None, RequestSent, RequestReceived, Established, Closing };
+enum class Action : uint8_t { Ignore, Reject, Accept, Establish, Refuse, Disconnect, Finish, Deliver };
+
+inline Action receive(State state, uint16_t operation)
+{
+    switch (state) {
+    case State::None:
+        if (operation == Request) return Action::Accept;
+        if (operation == Reset) return Action::Ignore;
+        return Action::Reject;
+    case State::RequestSent:
+        if (operation == Response) return Action::Establish;
+        if (operation == Reset) return Action::Refuse;
+        return Action::Reject;
+    case State::RequestReceived:
+        return operation == Reset ? Action::Disconnect : Action::Reject;
+    case State::Established:
+        if (operation == Reset) return Action::Disconnect;
+        if (operation >= Shutdown && operation <= CreditRequest) return Action::Deliver;
+        return Action::Reject;
+    case State::Closing:
+        return operation == Reset ? Action::Finish : Action::Ignore;
+    }
+    return Action::Ignore;
+}
+
+} // namespace SFVirtioSocket
diff --git a/src/Kernel/Extensions/IOVirtIOSocket/tests/protocol.cpp b/src/Kernel/Extensions/IOVirtIOSocket/tests/protocol.cpp
new file mode 100644
index 0000000..9986f0e
--- /dev/null
+++ b/src/Kernel/Extensions/IOVirtIOSocket/tests/protocol.cpp
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#include "../SFVirtioSocketProtocol.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main()
+{
+    using namespace SFVirtioSocket;
+
+    const Packet packet = {0xc0000001, 2, 0x12345678, 0x5678, 0, Stream, Shutdown, Both, 65536, 0xffffffff};
+    const uint8_t expected[HeaderSize] = {
+        1, 0, 0, 0xc0, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0,
+        0x78, 0x56, 0x34, 0x12, 0x78, 0x56, 0, 0, 0, 0, 0, 0,
+        1, 0, 4, 0, 3, 0, 0, 0, 0, 0, 1, 0, 0xff, 0xff, 0xff, 0xff
+    };
+    uint8_t bytes[HeaderSize + 1] = {};
+    encode(bytes + 1, packet);
+    assert(memcmp(bytes + 1, expected, HeaderSize) == 0);
+
+    Packet decoded = {};
+    assert(decode(bytes + 1, HeaderSize, decoded));
+    assert(decoded.srcCID == packet.srcCID && decoded.dstPort == packet.dstPort);
+    assert(decoded.flags == Both && decoded.forwarded == 0xffffffff);
+    assert(!decode(bytes + 1, HeaderSize - 1, decoded));
+    bytes[5] = 1;
+    assert(!decode(bytes + 1, HeaderSize, decoded));
+    bytes[5] = 0;
+    bytes[25] = 1;
+    assert(!decode(bytes + 1, HeaderSize, decoded));
+    assert(validGuestCID(0xc0000001) && !validGuestCID(2) && !validGuestCID(UINT32_MAX));
+
+    assert(credit(128, 32, 0xfffffff0) == 80);
+    assert(credit(128, 0xfffffff0, 32) == 0);
+    assert(credit(16, 32, 0) == 0);
+    assert(credit(128, 32, 32) == 128);
+
+    assert(receive(State::RequestSent, Response) == Action::Establish);
+    assert(receive(State::RequestSent, Reset) == Action::Refuse);
+    assert(receive(State::RequestSent, Data) == Action::Reject);
+    assert(receive(State::Established, Data) == Action::Deliver);
+    assert(receive(State::Established, Shutdown) == Action::Deliver);
+    assert(receive(State::Established, Reset) == Action::Disconnect);
+    assert(receive(State::Closing, Reset) == Action::Finish);
+    assert(receive(State::Closing, Data) == Action::Ignore);
+    assert(receive(State::None, Request) == Action::Accept);
+    assert(receive(State::None, Reset) == Action::Ignore);
+    assert(receive(State::None, Data) == Action::Reject);
+
+    puts("PASS header layout, CID and length validation, wrapped credit, stream state transitions");
+}
