+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 SiliconForest contributors
+#pragma once
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOWorkLoop.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/vsock_transport.h>
+
+#include "IOVirtIOTransport.h"
+#include "SFVirtioSocketProtocol.h"
+
+class IOVirtIOSocket : public IOService
+{
+    OSDeclareDefaultStructors(IOVirtIOSocket);
+
+public:
+    bool start(IOService *provider) override;
+    void stop(IOService *provider) override;
+
+private:
+    using Packet = SFVirtioSocket::Packet;
+    using State = SFVirtioSocket::State;
+
+    enum : unsigned { Rx, Tx, Event, QueueCount };
+    enum : unsigned { BufferCount = 16, ControlCount = 32, FlowCount = 128 };
+    enum : uint32_t { BufferSize = SFVirtioSocket::HeaderSize + VSOCK_MAX_PACKET_SIZE };
+
+    struct Flow {
+        vsock_address local, peer;
+        State state;
+        uint32_t sent, received;
+        uint32_t localBuffer, localForwarded, peerBuffer, peerForwarded;
+        uint32_t localShutdown, peerShutdown;
+        uint64_t deadline;
+    };
+
+    IOPCIDevice *fPCI = nullptr;
+    IOLock *fLock = nullptr;
+    IOWorkLoop *fWorkLoop = nullptr;
+    IOTimerEventSource *fTimer = nullptr;
+    IOVirtIOTransport fPCITransport;
+    vsock_transport fTransport = {};
+    VirtQueue fQueue[QueueCount] = {};
+    IOBufferMemoryDescriptor *fBuffers[QueueCount][BufferCount] = {};
+    bool fTxInFlight[BufferCount] = {};
+    Packet fControls[ControlCount] = {};
+    Flow fFlows[FlowCount] = {};
+    unsigned fControlStart = 0, fControlCount = 0, fSocketCount = 0;
+    uint16_t fRxId = 0;
+    uint32_t fRxLength = 0, fCID = 0;
+    bool fRxHeld = false, fOnline = false, fRegistered = false;
+    bool fPCIOpen = false, fTimerAdded = false, fStopping = false;
+
+    void sf_releaseHardware();
+    bool sf_readCID(uint32_t &cid);
+    static unsigned sf_bufferCount(const VirtQueue &queue);
+    bool sf_initQueue(unsigned index);
+    void sf_postWritable(unsigned index, unsigned slot);
+    bool sf_submit(const Packet &packet, mbuf_t data);
+    bool sf_control(const Packet &packet);
+    void sf_drainTx();
+    void sf_poll();
+    void sf_expire();
+    bool sf_resetEvent();
+    bool sf_receive();
+    bool sf_decodeRx(const uint8_t *bytes, Packet &packet);
+    bool sf_processRx(const Packet &packet, const uint8_t *bytes);
+    void sf_replyReset(const Packet &packet);
+    void sf_deliver(const Packet &packet, vsock_operation operation, mbuf_t data);
+    Flow *sf_findFlow(vsock_address local, vsock_address peer);
+    Flow *sf_newFlow(vsock_address local, vsock_address peer, State state);
+    int sf_send(vsock_address src, vsock_address dst, vsock_operation op,
+                uint32_t buffer, uint32_t forwarded, mbuf_t data);
+
+    static void sf_timer(OSObject *owner, IOTimerEventSource *timer);
+    static int sf_getCID(void *provider, uint32_t *cid);
+    static int sf_attachSocket(void *provider);
+    static int sf_detachSocket(void *provider);
+    static int sf_putMessage(void *provider, vsock_address src, vsock_address dst,
+                             vsock_operation op, uint32_t buffer, uint32_t forwarded, mbuf_t data);
+};
