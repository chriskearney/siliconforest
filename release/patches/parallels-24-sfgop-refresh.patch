+/* The VirtIO framebuffer generation each open read its mode and mapping at,
+ * one record per connection; SFGOPClose drops it. Keyed by the connection,
+ * because a caller may move its SFGOPFramebuffer after the open. A driver
+ * without the generation query gets no record, and SFGOPRefresh then never
+ * reopens. */
+typedef struct SFGOPGeneration {
+    mach_port_t connect;
+    uint64_t generation;
+    struct SFGOPGeneration *next;
+} SFGOPGeneration;
+
+static pthread_mutex_t gSFGOPGenerationLock = PTHREAD_MUTEX_INITIALIZER;
+static SFGOPGeneration *gSFGOPGenerations;
+
 /* Callers (C, and Rust bindings built against the original header) rely on
  * this exact 64-byte layout. The queries below must not grow it. */
 _Static_assert(sizeof(SFGOPFramebuffer) == 64, "SFGOPFramebuffer ABI size");
@@ -80,8 +99,72 @@ sfgop_geometry_valid(const IOPixelInformation *pi)
     return 1;
 }
 
-kern_return_t
-SFGOPOpen(SFGOPFramebuffer *fb)
+/* The VirtIO driver's count of published framebuffers. Selector 15 is
+ * IOFramebuffer's extSetColorConvertTable, so it goes to VirtIO only. */
+static kern_return_t
+sfgop_generation(SFGOPFramebuffer *fb, uint64_t *generation)
+{
+    uint32_t count = 1;
+
+    *generation = 0;
+    if (SFGOPGetServiceKind(fb) != kSFGOPServiceVirtioTransfer)
+        return KERN_NOT_SUPPORTED;
+    return IOConnectCallScalarMethod(fb->connect, kSFGPU_ModeGeneration,
+        NULL, 0, generation, &count);
+}
+
+static int
+sfgop_generation_record(mach_port_t connect, uint64_t generation)
+{
+    SFGOPGeneration *record = malloc(sizeof(*record));
+
+    if (record == NULL)
+        return 0;
+    record->connect = connect;
+    record->generation = generation;
+    pthread_mutex_lock(&gSFGOPGenerationLock);
+    record->next = gSFGOPGenerations;
+    gSFGOPGenerations = record;
+    pthread_mutex_unlock(&gSFGOPGenerationLock);
+    return 1;
+}
+
+static int
+sfgop_generation_opened(mach_port_t connect, uint64_t *generation)
+{
+    int found = 0;
+
+    pthread_mutex_lock(&gSFGOPGenerationLock);
+    for (SFGOPGeneration *record = gSFGOPGenerations; record != NULL; record = record->next) {
+        if (record->connect == connect) {
+            *generation = record->generation;
+            found = 1;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&gSFGOPGenerationLock);
+    return found;
+}
+
+static void
+sfgop_generation_forget(mach_port_t connect)
+{
+    SFGOPGeneration *gone = NULL;
+
+    pthread_mutex_lock(&gSFGOPGenerationLock);
+    for (SFGOPGeneration **link = &gSFGOPGenerations; *link != NULL; link = &(*link)->next) {
+        if ((*link)->connect == connect) {
+            gone = *link;
+            *link = gone->next;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&gSFGOPGenerationLock);
+    free(gone);
+}
+
+static kern_return_t
+sfgop_open(SFGOPFramebuffer *fb)
 {
     kern_return_t kr;
 #ifdef _SF_IOKITLIB_H
@@ -94,6 +177,8 @@ SFGOPOpen(SFGOPFramebuffer *fb)
     uint64_t scalarIn[3];
     IOPixelInformation pixelInfo;
     size_t pixelInfoSize = sizeof(pixelInfo);
+    uint64_t generation = 0, after = 0;
