     if (fb == NULL) {
         SFGOP_SET_STAGE("argument");
@@ -154,6 +239,9 @@ SFGOPOpen(SFGOPFramebuffer *fb)
     if (kr != KERN_SUCCESS) {
         goto fail;
     }
+    /* The mode, its pixel layout and the mapping below belong together only
+     * when no new framebuffer was published while they were read. */
+    followed = sfgop_generation(fb, &generation) == KERN_SUCCESS;
 
     SFGOP_SET_STAGE("GetCurrentDisplayMode");
     kr = IOConnectCallScalarMethod(fb->connect,
@@ -212,6 +300,24 @@ SFGOPOpen(SFGOPFramebuffer *fb)
     fb->componentMasks[1] = pixelInfo.componentMasks[1];
     fb->componentMasks[2] = pixelInfo.componentMasks[2];
 
+    if (followed) {
+        SFGOP_SET_STAGE("ModeGeneration");
+        kr = sfgop_generation(fb, &after);
+        if (kr != KERN_SUCCESS) {
+            goto fail;
+        }
+        if (after != generation) {
+            SFGOP_SET_STAGE("ModeGeneration:moved");
+            kr = KERN_ABORTED;
+            goto fail;
+        }
+        if (!sfgop_generation_record(fb->connect, generation)) {
+            SFGOP_SET_STAGE("ModeGeneration:record");
+            kr = KERN_RESOURCE_SHORTAGE;
+            goto fail;
+        }
+    }
+
     SFGOP_SET_STAGE("none");
     return KERN_SUCCESS;
 
@@ -220,6 +326,39 @@ fail:
     return kr;
 }
 
+kern_return_t
+SFGOPOpen(SFGOPFramebuffer *fb)
+{
+    kern_return_t kr = KERN_ABORTED;
+
+    for (int attempt = 0; attempt < kSFGOPOpenAttempts && kr == KERN_ABORTED; attempt++) {
+        kr = sfgop_open(fb);
+    }
+    return kr;
+}
+
+kern_return_t
+SFGOPRefresh(SFGOPFramebuffer *fb, int *changed)
+{
+    kern_return_t kr;
+    uint64_t generation, opened;
+
+    if (changed != NULL)
+        *changed = 0;
+    if (fb == NULL || changed == NULL || fb->connect == IO_OBJECT_NULL)
+        return KERN_INVALID_ARGUMENT;
+    if (!sfgop_generation_opened(fb->connect, &opened))
+        return KERN_SUCCESS;
+    kr = sfgop_generation(fb, &generation);
+    if (kr != KERN_SUCCESS || generation == opened)
+        return kr;
+    /* Closing the connection takes the old mapping with it; the driver keeps
+     * that framebuffer's memory until the mapping is gone. */
+    *changed = 1;
+    SFGOPClose(fb);
+    return SFGOPOpen(fb);
+}
+
 void
 SFGOPClose(SFGOPFramebuffer *fb)
 {
@@ -231,6 +370,7 @@ SFGOPClose(SFGOPFramebuffer *fb)
             mach_task_self(), fb->address);
     }
     if (fb->connect != IO_OBJECT_NULL) {
+        sfgop_generation_forget(fb->connect);
         (void)IOServiceClose(fb->connect);
     }
     if (fb->service != IO_OBJECT_NULL) {
