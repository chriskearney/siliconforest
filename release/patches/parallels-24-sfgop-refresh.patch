+/* For kSFGOPServiceVirtioTransfer, after the driver published a new
+ * framebuffer (the display mode changed): closes fb, sets *changed to 1 and
+ * opens again as SFGOPOpen does, so fb describes and maps the current mode.
+ * The old mapping is gone once *changed is 1, whatever the result; on
+ * failure fb is zeroed. Otherwise *changed is 0 and fb is untouched. */
+kern_return_t SFGOPRefresh(SFGOPFramebuffer *fb, int *changed);
 /* Transfers a rect to the display for kSFGOPServiceVirtioTransfer only.
  * Any other service returns KERN_NOT_SUPPORTED without a driver call:
  * a direct-memory framebuffer has no present step. */
