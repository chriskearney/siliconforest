+#if __APPLE__
+struct sf_resolver_watch
+{
+    mDNS *mdns;
+    int queue;
+    int directory;
+    int file;
+};
+
+// Follow the new inode after configd's rename. Keep the current watch when
+// another file in /var/run changes.
+static mDNSBool sf_watch_resolver_file(struct sf_resolver_watch *watch)
+{
+    struct stat current, watched;
+    struct kevent event;
+    int file = open(uDNS_SERVERS_FILE, O_EVTONLY);
+
+    if (file < 0 && (errno != ENOENT || watch->file < 0)) return mDNSfalse;
+    if (file >= 0 && watch->file >= 0 && fstat(file, &current) == 0 && fstat(watch->file, &watched) == 0
+        && current.st_dev == watched.st_dev && current.st_ino == watched.st_ino)
+    {
+        close(file);
+        return mDNSfalse;
+    }
+
+    if (watch->file >= 0) close(watch->file);
+    watch->file = file;
+    if (file >= 0)
+    {
+        EV_SET(&event, file, EVFILT_VNODE, EV_ADD | EV_CLEAR, NOTE_WRITE | NOTE_DELETE | NOTE_RENAME, 0, NULL);
+        if (kevent(watch->queue, &event, 1, NULL, 0, NULL) < 0)
+        {
+            LogMsg("Unable to watch resolver file: %s", strerror(errno));
+            close(file);
+            watch->file = -1;
+        }
+    }
+    return mDNStrue;
+}
+
+static void sf_resolver_changed(int fd, void *context)
+{
+    struct sf_resolver_watch *watch = context;
+    struct kevent events[2];
+    const struct timespec immediate = {0};
+    int count = kevent(fd, NULL, 0, events, 2, &immediate);
+    mDNSBool fileChanged = mDNSfalse;
+
+    if (count <= 0) return;
+    for (int i = 0; i < count; i++)
+        if (watch->file >= 0 && events[i].ident == (uintptr_t)watch->file) fileChanged = mDNStrue;
+
+    if (sf_watch_resolver_file(watch) || fileChanged)
+        uDNS_SetupDNSConfig(watch->mdns);
+}
+#endif
+
 mDNSlocal mStatus MainLoop(mDNS *m) // Loop until we quit.
 {
     sigset_t signals;
     mDNSBool gotData = mDNSfalse;
+#if __APPLE__
+    struct sf_resolver_watch watch = {m, kqueue(), open("/var/run", O_EVTONLY | O_DIRECTORY), -1};
+    struct kevent directoryEvent;
+    EV_SET(&directoryEvent, watch.directory, EVFILT_VNODE, EV_ADD | EV_CLEAR, NOTE_WRITE, 0, NULL);
+    mDNSBool watching = watch.queue >= 0 && watch.directory >= 0
+        && kevent(watch.queue, &directoryEvent, 1, NULL, 0, NULL) == 0
+        && mDNSPosixAddFDToEventLoop(watch.queue, sf_resolver_changed, &watch) == mStatus_NoError;
+    if (watching) sf_watch_resolver_file(&watch);
+    else LogMsg("Unable to watch for resolver configuration changes");
+    uDNS_SetupDNSConfig(m);
+#endif
 
     mDNSPosixListenForSignalInEventLoop(SIGINT);
     mDNSPosixListenForSignalInEventLoop(SIGTERM);
@@ -194,6 +271,12 @@ mDNSlocal mStatus MainLoop(mDNS *m) // L
         if (sigismember(&signals, SIGPIPE)) LogMsg("Received SIGPIPE - ignoring");
         if (sigismember(&signals, SIGINT) || sigismember(&signals, SIGTERM)) break;
     }
+#if __APPLE__
+    if (watching) mDNSPosixRemoveFDFromEventLoop(watch.queue);
+    if (watch.file >= 0) close(watch.file);
+    if (watch.directory >= 0) close(watch.directory);
+    if (watch.queue >= 0) close(watch.queue);
+#endif
     return EINTR;
 }
 
