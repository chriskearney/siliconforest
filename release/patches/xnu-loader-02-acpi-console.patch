+static void sf_test_rsdp_selection(void)
+{
+  SfFixture fixture = sf_synthetic();
+  uint8_t *rsdp = fixture.bytes[RSDP];
+  memcpy(rsdp + 9, "BOCHS ", 6);
+  sf_checksum(rsdp, 20, 8);
+  assert(sf_acpi_rsdp_is_qemu(rsdp));
+  puts("no FDT, BOCHS RSDP: build defaults");
+
+  memcpy(rsdp + 9, "PRLS  ", 6);
+  sf_checksum(rsdp, 20, 8);
+  sf_checksum(rsdp, 36, 32);
+  assert(!sf_acpi_rsdp_is_qemu(rsdp));
+  SfAcpiBoard board;
+  assert(sf_acpi_read(sf_fixture_map, &fixture, sf_address(RSDP), &board) == NULL);
+  puts("no FDT, PRLS RSDP: ACPI");
+
+  memcpy(rsdp + 9, "BOCHS ", 6);
+  sf_checksum(rsdp, 20, 8);
+  rsdp[8] ^= 1;
+  assert(!sf_acpi_rsdp_is_qemu(rsdp));
+}
+
 int main(int argc, char **argv)
