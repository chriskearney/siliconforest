+bool sf_acpi_rsdp_is_qemu(const uint8_t *rsdp)
+{
+  return rsdp != NULL && sf_signature(rsdp, "RSD PTR ", 8) &&
+         sf_checksum(rsdp, SF_ACPI_RSDP_LEGACY) && sf_signature(rsdp + 9, "BOCHS ", 6);
+}
