diff --git a/src/acpi_board.c b/src/acpi_board.c
index 8d236b7..766142e 100644
--- a/src/acpi_board.c
+++ b/src/acpi_board.c
@@ -3,6 +3,55 @@
 
 #include "acpi_board.h"
 
+const char *sf_acpi_tree(const SfAcpiBoard *board, uint64_t running_mpidr, SfAcpiTree *tree)
+{
+  const uint64_t affinity_mask = UINT64_C(0xff00ffffff);
+  const uint64_t uart_size = 0x1000, gicd_size = 0x10000;
+  const uint64_t base[] = {board->uart_base, board->gicd_base, board->gicr_base};
+  const uint64_t size[] = {uart_size, gicd_size, board->gicr_size};
+  uint64_t lo = UINT64_MAX, hi = 0;
+  for (size_t i = 0; i < sizeof(base) / sizeof(base[0]); i++) {
+    if (base[i] == 0 || size[i] == 0 || base[i] > UINT64_MAX - size[i])
+      return "ACPI device tree MMIO range";
+    if (base[i] < lo)
+      lo = base[i];
+    if (base[i] + size[i] > hi)
+      hi = base[i] + size[i];
+  }
+
+  if (board->timer_virt_gsi < 16 || board->timer_virt_gsi > 31)
+    return "GTDT virtual timer is not a PPI";
+  if (board->cpu_count == 0 || board->cpu_count > SF_ACPI_MAX_CPUS)
+    return "ACPI device tree CPU count";
+
+  SfAcpiTree translated = {
+    .soc_base = lo, .soc_size = hi - lo,
+    .uart_reg = {board->uart_base - lo, uart_size},
+    .gic_reg = {board->gicd_base - lo, gicd_size, board->gicr_base - lo, board->gicr_size},
+    .cpu_count = board->cpu_count, .timer_ppi = board->timer_virt_gsi,
+    .psci_method = board->psci == SF_ACPI_PSCI_HVC ? "hvc" : "smc",
+  };
+  bool found = false;
+  size_t secondary = 1;
+  for (size_t i = 0; i < board->cpu_count; i++) {
+    uint64_t id = board->mpidr[i] & affinity_mask;
+    for (size_t earlier = 0; earlier < i; earlier++)
+      if ((board->mpidr[earlier] & affinity_mask) == id)
+        return "duplicate CPU affinity in MADT";
+
+    if (id == (running_mpidr & affinity_mask)) {
+      translated.mpidr[0] = id;
+      found = true;
+    } else if (secondary < board->cpu_count) {
+      translated.mpidr[secondary++] = id;
+    }
+  }
+  if (!found)
+    return "boot CPU absent from MADT";
+  *tree = translated;
+  return NULL;
+}
+
 enum {
   SF_ACPI_SDT_HEADER = 36,
   SF_ACPI_RSDP_LEGACY = 20,
