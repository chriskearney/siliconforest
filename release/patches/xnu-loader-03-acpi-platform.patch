                          SfAcpiBoard *board);
 
+typedef struct {
+  uint64_t soc_base, soc_size;
+  uint64_t uart_reg[2], gic_reg[4];
+  uint64_t mpidr[SF_ACPI_MAX_CPUS];
+  size_t cpu_count;
+  uint32_t timer_ppi;
+  const char *psci_method;
+} SfAcpiTree;
+
+const char *sf_acpi_tree(const SfAcpiBoard *board, uint64_t running_mpidr, SfAcpiTree *tree);
+
