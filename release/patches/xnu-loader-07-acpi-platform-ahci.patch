+/* The static AHCI subset of the ACPI AML grammar. Package lengths include
+ * their own encoding. Keep each child bounded by its parent's end. */
+static bool sf_aml_package(const uint8_t **cursor, const uint8_t *end,
+                           const uint8_t **body)
+{
+  const uint8_t *p = *cursor;
+  if (p == end)
+    return false;
+  unsigned extra = p[0] >> 6;
+  if ((size_t)(end - p) <= extra || (extra && (p[0] & 0x30)))
+    return false;
+  uint32_t length = p[0] & (extra ? 0x0f : 0x3f);
+  for (unsigned i = 0; i < extra; i++)
+    length |= (uint32_t)p[i + 1] << (4 + i * 8);
+  if (length <= extra || length > (size_t)(end - p))
+    return false;
+  *body = p + extra + 1;
+  *cursor = p + length;
+  return true;
+}
+
+static bool sf_aml_name_char(uint8_t ch)
+{
+  return ch == '_' || (ch >= 'A' && ch <= 'Z');
+}
+
+static bool sf_aml_name(const uint8_t **cursor, const uint8_t *end,
+                        const uint8_t **local)
+{
+  const uint8_t *p = *cursor;
+  if (p != end && *p == 0x5c)
+    p++;
+  else
+    while (p != end && *p == 0x5e)
+      p++;
+  if (p == end)
+    return false;
+  unsigned count = 1;
+  if (*p == 0x2e) {
+    p++;
+    count = 2;
+  } else if (*p == 0x2f) {
+    if (end - p < 2 || p[1] == 0)
+      return false;
+    count = p[1];
+    p += 2;
+  } else if (*p == 0) {
+    p++;
+    count = 0;
+  }
+  if ((size_t)(end - p) < count * 4)
+    return false;
+  if (local)
+    *local = p == *cursor && count == 1 ? p : NULL;
+  for (unsigned i = 0; i < count; i++, p += 4) {
+    if (!sf_aml_name_char(p[0]))
+      return false;
+    for (unsigned j = 1; j < 4; j++)
+      if (!sf_aml_name_char(p[j]) && (p[j] < '0' || p[j] > '9'))
+        return false;
+  }
+  *cursor = p;
+  return true;
+}
+
+static bool sf_aml_integer(const uint8_t **cursor, const uint8_t *end, uint64_t *value)
+{
+  const uint8_t *p = *cursor;
+  if (p == end)
+    return false;
+  unsigned bytes;
+  switch (*p++) {
+  case 0x00: *value = 0; bytes = 0; break;
+  case 0x01: *value = 1; bytes = 0; break;
+  case 0xff: *value = UINT64_MAX; bytes = 0; break;
+  case 0x0a: bytes = 1; break;
+  case 0x0b: bytes = 2; break;
+  case 0x0c: bytes = 4; break;
+  case 0x0e: bytes = 8; break;
+  default: return false;
+  }
+  if ((size_t)(end - p) < bytes)
+    return false;
+  if (bytes != 0)
+    *value = sf_le(p, bytes);
+  *cursor = p + bytes;
+  return true;
+}
+
+static bool sf_aml_skip_data(const uint8_t **cursor, const uint8_t *end)
+{
+  uint64_t integer;
+  if (sf_aml_integer(cursor, end, &integer))
+    return true;
+  if (*cursor == end)
+    return false;
+  switch (**cursor) {
+  case 0x0d: /* String */
+    do {
+      (*cursor)++;
+    } while (*cursor != end && **cursor != 0);
+    if (*cursor == end)
+      return false;
+    (*cursor)++;
+    return true;
+  case 0x11: /* Buffer */
+  case 0x12: /* Package */
+  case 0x13: { /* VarPackage */
+    const uint8_t *body;
+    (*cursor)++;
+    return sf_aml_package(cursor, end, &body);
+  }
+  default:
+    return sf_aml_name(cursor, end, NULL);
+  }
+}
+
+static bool sf_aml_is_ahci(const uint8_t *p, const uint8_t *end)
+{
+  const uint8_t *body;
+  uint64_t base, subclass, interface;
+  return *p++ == 0x12 && sf_aml_package(&p, end, &body) && body != p &&
+      *body++ == 3 && sf_aml_integer(&body, p, &base) &&
+      sf_aml_integer(&body, p, &subclass) && sf_aml_integer(&body, p, &interface) &&
+      body == p && base == 1 && subclass == 6 && interface == 1;
+}
+
+static bool sf_aml_ahci_resources(const uint8_t *p, const uint8_t *end, SfAcpiAhci *ahci)
+{
+  const uint8_t *body;
+  uint64_t size;
+  if (*p++ != 0x11 || !sf_aml_package(&p, end, &body) ||
+      !sf_aml_integer(&body, p, &size) || size != (size_t)(p - body))
+    return false;
+
+  /* Support a fixed writable 32-bit ABAR and one level-high consumer SPI.
+   * More resources or other routing require a different translation. */
+  const uint8_t *begin = body;
+  while (body < p) {
+    uint8_t tag = *body++;
+    if (tag == 0x79)
+      return p - body == 1 && (*body == 0 || sf_checksum(begin, size)) &&
+          ahci->size != 0 && ahci->gsi != 0;
+    if (p - body < 2)
+      return false;
+    size_t length = (size_t)sf_le(body, 2);
+    body += 2;
+    if (length >= (size_t)(p - body))
+      return false;
+    if (tag == 0x86 && length == 9 && body[0] == 1 && ahci->size == 0) {
+      ahci->base = (uint32_t)sf_le(body + 1, 4);
+      ahci->size = (uint32_t)sf_le(body + 5, 4);
+      if (ahci->base == 0 || (ahci->base & 3) || ahci->size < 0x180 ||
+          (uint64_t)ahci->base + ahci->size > (UINT64_C(1) << 32))
+        return false;
+    } else if (tag == 0x89 && length == 6 && body[0] == 1 && body[1] == 1 && ahci->gsi == 0) {
+      ahci->gsi = (uint32_t)sf_le(body + 2, 4);
+      if (ahci->gsi < 32 || ahci->gsi >= 1020)
+        return false;
+    } else {
+      return false;
+    }
+    body += length;
+  }
+  return false;
+}
+
+static const char *sf_aml_walk(const uint8_t *p, const uint8_t *end, bool device,
+                               unsigned depth, SfAcpiAhci *found)
+{
+  const uint8_t *cls = NULL, *cls_end = NULL, *crs = NULL, *crs_end = NULL;
+  const char *malformed = "unsupported or malformed DSDT AML";
+  if (depth > 16)
+    return "DSDT AML nesting limit";
+
+  while (p != end) {
+    unsigned opcode = *p++;
+    if (opcode == 0x5b) {
+      if (p == end)
+        return malformed;
+      opcode = 0x5b00 | *p++;
+    }
+    switch (opcode) {
+    case 0x08: { /* Name */
+      const uint8_t *name;
+      if (!sf_aml_name(&p, end, &name))
+        return malformed;
+      const uint8_t *value = p;
+      if (!sf_aml_skip_data(&p, end))
+        return malformed;
+      if (device && name) {
+        if (sf_signature(name, "_CLS", 4)) {
+          if (cls)
+            return "DSDT duplicate _CLS";
+          cls = value;
+          cls_end = p;
+        } else if (sf_signature(name, "_CRS", 4)) {
+          if (crs)
+            return "DSDT duplicate _CRS";
+          crs = value;
+          crs_end = p;
+        }
+      }
+      break;
+    }
+    case 0x10: /* Scope */
+    case 0x5b82: { /* Device */
+      const uint8_t *body;
+      if (!sf_aml_package(&p, end, &body) || !sf_aml_name(&body, p, NULL))
+        return malformed;
+      const char *error = sf_aml_walk(body, p, opcode == 0x5b82, depth + 1, found);
+      if (error)
+        return error;
+      break;
+    }
+    case 0x14: /* Method: skip executable terms. */
+    case 0x5b81: { /* Field */
+      const uint8_t *body;
+      if (!sf_aml_package(&p, end, &body))
+        return malformed;
+      break;
+    }
+    case 0x5b80: /* OperationRegion: skip the name, space, offset and length. */
+      if (!sf_aml_name(&p, end, NULL) || p == end)
+        return malformed;
+      p++;
+      if (!sf_aml_skip_data(&p, end) || !sf_aml_skip_data(&p, end))
+        return malformed;
+      break;
+    default:
+      return malformed;
+    }
+  }
+
+  if (cls && crs && *crs == 0x11 && sf_aml_is_ahci(cls, cls_end)) {
+    SfAcpiAhci ahci = {0};
+    if (!sf_aml_ahci_resources(crs, crs_end, &ahci))
+      return "DSDT AHCI _CRS invalid or unsupported";
+    if (found->size != 0)
+      return "DSDT contains multiple static AHCI devices";
+    *found = ahci;
+  }
+  return NULL;
+}
+
+const char *sf_acpi_ahci(const uint8_t *bytes, size_t length, SfAcpiAhci *ahci)
+{
+  if (!bytes || length < SF_ACPI_SDT_HEADER || length > SF_ACPI_MAX_TABLE_BYTES ||
+      !sf_signature(bytes, "DSDT", 4) || sf_le(bytes + 4, 4) != length)
+    return "DSDT header or length";
+  if (!sf_checksum(bytes, length))
+    return "DSDT checksum";
+
+  SfAcpiAhci found = {0};
+  const char *error = sf_aml_walk(bytes + SF_ACPI_SDT_HEADER, bytes + length, false, 0, &found);
+  if (error == NULL)
+    *ahci = found;
+  return error;
+}
+
+static const char *sf_read_dsdt_ahci(SfAcpiMap map, void *context, SfAcpiTable fadt,
+                                    SfAcpiAhci *ahci)
+{
+  uint64_t address = fadt.length >= 148 ? sf_le(fadt.bytes + 140, 8) : 0;
+  if (address == 0)
+    address = sf_le(fadt.bytes + 40, 4);
+  if (address == 0)
+    return "FADT has no DSDT address";
+  const uint8_t *header = map(context, address, SF_ACPI_SDT_HEADER);
+  if (header == NULL)
+    return "DSDT header outside firmware memory";
+  size_t length = (size_t)sf_le(header + 4, 4);
+  if (length < SF_ACPI_SDT_HEADER || length > SF_ACPI_MAX_TABLE_BYTES)
+    return "DSDT length";
+  const uint8_t *table = map(context, address, length);
+  return table ? sf_acpi_ahci(table, length, ahci) : "DSDT outside firmware memory";
+}
+
 const char *sf_acpi_read(SfAcpiMap map, void *context, uint64_t rsdp_address,
                          SfAcpiBoard *board)
 {
@@ -409,6 +688,7 @@ const char *sf_acpi_read(SfAcpiMap map, void *context, uint64_t rsdp_address,
   if (error != NULL)
     return error;
 
