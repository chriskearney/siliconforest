diff --git a/tests/acpi_ahci_test.c b/tests/acpi_ahci_test.c
new file mode 100644
index 0000000..263dbee
--- /dev/null
+++ b/tests/acpi_ahci_test.c
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: MIT */
+/* Copyright (c) 2026 SiliconForest contributors */
+#include "acpi_board.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { SDT_HEADER = 36, CAPACITY = 65536 };
+
+static void finish_table(uint8_t *table, size_t length)
+{
+  uint8_t sum = 0;
+  memcpy(table, "DSDT", 4);
+  for (unsigned i = 0; i < 4; i++)
+    table[4 + i] = (uint8_t)(length >> (i * 8));
+  table[9] = 0;
+  for (size_t i = 0; i < length; i++)
+    sum += table[i];
+  table[9] = (uint8_t)-sum;
+}
+
+static void expect_rejected(const uint8_t *table, size_t length)
+{
+  SfAcpiAhci ahci = {1, 2, 3};
+  assert(sf_acpi_ahci(table, length, &ahci) != NULL);
+  assert(ahci.base == 1 && ahci.size == 2 && ahci.gsi == 3);
+}
+
+int main(void)
+{
+  static uint8_t table[CAPACITY];
+  static const uint8_t device[] = {
+    0x5b, 0x82, 0x31, 'D', 'E', 'V', '0',
+    0x08, '_', 'C', 'L', 'S', 0x12, 6, 3, 1, 0x0a, 6, 1,
+    0x08, '_', 'C', 'R', 'S', 0x11, 26, 0x0a, 23,
+    0x86, 9, 0, 1, 0, 0, 0x28, 0, 0, 0x20, 0, 0,
+    0x89, 6, 0, 1, 1, 0x2d, 0, 0, 0, 0x79, 0,
+  };
+  uint8_t *aml = table + SDT_HEADER;
+  SfAcpiAhci ahci = {0};
+
+  memcpy(aml, device, sizeof(device));
+  size_t length = SDT_HEADER + sizeof(device);
+  finish_table(table, length);
+  assert(sf_acpi_ahci(table, length, &ahci) == NULL);
+  assert(ahci.base == 0x280000 && ahci.size == 0x2000 && ahci.gsi == 45);
+
+  expect_rejected(table, length - 1);
+  table[9] ^= 1;
+  expect_rejected(table, length);
+  table[9] ^= 1;
+
+  aml[2] += 1;
+  finish_table(table, length);
+  expect_rejected(table, length);
+  aml[2] -= 1;
+
+  aml[27] = 24; /* BufferSize exceeds the initialized resource bytes. */
+  finish_table(table, length);
+  expect_rejected(table, length);
+  memcpy(aml, device, sizeof(device));
+
+  aml[43] = 3; /* Edge rather than level. */
+  finish_table(table, length);
+  expect_rejected(table, length);
+  memcpy(aml, device, sizeof(device));
+
+  /* A device inside a Buffer is data, not a namespace declaration. */
+  const uint8_t header[] = {0x08, 'D', 'A', 'T', 'A', 0x11, sizeof(device) + 3, 0x0a, sizeof(device)};
+  memcpy(aml, header, sizeof(header));
+  memcpy(aml + sizeof(header), device, sizeof(device));
+  length = SDT_HEADER + sizeof(header) + sizeof(device);
+  finish_table(table, length);
+  assert(sf_acpi_ahci(table, length, &ahci) == NULL && ahci.size == 0);
+  puts("static AML bounds, resources, and buffer isolation: accepted");
+  return 0;
+}
