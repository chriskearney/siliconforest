+                 &SFArmGICController::sf_attach_msi};
+    IOLog("SFArmGIC: GICv2m doorbell 0x%llx, edge Group 1 SPIs %u-%u\n",
+          (unsigned long long)fMsiFrame.doorbell, first, first + count - 1);
+}
