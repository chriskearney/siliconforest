+bool IOPCIMessagedInterruptController::sf_init_platform(UInt64 doorbell, UInt32 first, UInt32 count,
+                                                      SFPCIMSIGate gate, void *context)
+{
+    sfDoorbell = doorbell;
+    sfSetGate = gate;
+    sfGateContext = context;
+    // Index the allocator by absolute INTID so multi-message MSI is aligned.
+    return init(first + count, 0) && reserveVectors(0, first);
+}
+
+IOInterruptController *sf_pci_create_msi_controller(UInt64 doorbell, UInt32 first, UInt32 count,
+                                                   SFPCIMSIGate gate, void *context)
+{
+    IOPCIMessagedInterruptController *controller = new IOPCIMessagedInterruptController;
+    if (controller && !controller->sf_init_platform(doorbell, first, count, gate, context)) {
+        controller->release();
+        return NULL;
+    }
+    return controller;
+}
