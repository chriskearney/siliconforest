+void
+SFArmGICController::sf_init_msi(void)
+{
+    IORegistryEntry *host = IORegistryEntry::fromPath("/pci", gIODTPlane);
+    OSData *parent = host ? OSDynamicCast(OSData, host->getProperty("msi-parent")) : NULL;
+    if (!parent || parent->getLength() != sizeof(UInt32)) {
+        OSSafeReleaseNULL(host);
+        return;
+    }
+    UInt32 phandle = *static_cast<const UInt32 *>(parent->getBytesNoCopy());
+    host->release();
+
+    IORegistryEntry *frame = IORegistryEntry::fromPath("/msi-controller", gIODTPlane);
+    if (!frame)
+        return;
+    OSData *identity = OSDynamicCast(OSData, frame->getProperty("AAPL,phandle"));
+    OSData *reg = OSDynamicCast(OSData, frame->getProperty("reg"));
+    if (!identity || identity->getLength() != sizeof(UInt32) ||
+        *static_cast<const UInt32 *>(identity->getBytesNoCopy()) != phandle ||
+        !frame->getProperty("msi-controller") || !reg || reg->getLength() != 4 * sizeof(UInt32)) {
+        frame->release();
+        return;
+    }
+    const UInt32 *cells = static_cast<const UInt32 *>(reg->getBytesNoCopy());
+    UInt64 base = (static_cast<UInt64>(cells[0]) << 32) | cells[1];
+    UInt64 length = (static_cast<UInt64>(cells[2]) << 32) | cells[3];
+    OSData *spiBase = OSDynamicCast(OSData, frame->getProperty("arm,msi-base-spi"));
+    OSData *spiCount = OSDynamicCast(OSData, frame->getProperty("arm,msi-num-spis"));
+    UInt32 first = 0, count = 0;
+    if (spiBase && spiCount && spiBase->getLength() == sizeof(UInt32) &&
+        spiCount->getLength() == sizeof(UInt32)) {
+        first = *static_cast<const UInt32 *>(spiBase->getBytesNoCopy());
+        count = *static_cast<const UInt32 *>(spiCount->getBytesNoCopy());
+    }
+    frame->release();
+
+    if (base == 0 || (base & 0xfff) != 0 || length != 0x1000 || base > UINT64_MAX - length)
+        return;
+    if (!first || !count) {
+        IODeviceMemory *mem = IODeviceMemory::withRange(base, length);
+        IOMemoryMap *map = mem ? mem->map() : NULL;
+        if (!map) {
+            OSSafeReleaseNULL(mem);
+            return;
+        }
+        const volatile UInt32 *regs = reinterpret_cast<const volatile UInt32 *>(map->getVirtualAddress());
+        UInt32 typer = regs[0x8 / sizeof(UInt32)];
+        first = (typer >> 16) & 0x3ff;
+        count = typer & 0x3ff;
+        map->release();
+        mem->release();
+    }
+    if (first < 32 || first >= fLines || count == 0 || count > fLines - first) {
+        IOLog("SFArmGIC: unusable GICv2m SPI range %u+%u\n", first, count);
+        return;
+    }
+
+    for (UInt32 spi = first; spi < first + count; spi++) {
+        UInt32 word = (spi / 32) * 4;
+        UInt32 bit = 1u << (spi % 32);
+        dwrite(GICD_ICENABLER + word, bit);
+        dwrite(GICD_ICPENDR + word, bit);
+        dwrite(GICD_IGROUPR + word, dread(GICD_IGROUPR + word) | bit);
