+void
+SFArmGICController::sf_attach_msi(void *context, IOInterruptController *controller)
+{
+    auto *self = static_cast<SFArmGICController *>(context);
+    __atomic_store_n(&self->fMsiController, controller, __ATOMIC_RELEASE);
+}
+
+void
+SFArmGICController::sf_gate_msi(void *context, UInt32 spi, bool enable)
+{
+    auto *self = static_cast<SFArmGICController *>(context);
+    if (enable)
+        self->enableVector(spi, NULL);
+    else
+        self->disableVectorHard(spi, NULL);
+}
